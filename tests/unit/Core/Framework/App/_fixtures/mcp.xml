<?xml version="1.0" encoding="UTF-8"?>
<mcp xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="">
    <mcp-tools>
        <mcp-tool name="sync-blogs" url="https://app.example.com/mcp/sync">
            <label>Sync blogs</label>
            <label lang="zh-CN">同步文章</label>
            <description>Synchronize blogs from an external content source</description>
            <description lang="zh-CN">从外部内容源同步文章</description>
            <input-schema>
                <property name="since" type="string" description="ISO 8601 date" required="true"/>
                <property name="limit" type="integer" description="Maximum number of blogs"/>
            </input-schema>
            <required-privileges>
                <privilege>blog:read</privilege>
                <privilege>blog:update</privilege>
            </required-privileges>
        </mcp-tool>
        <mcp-tool name="media-check" url="https://app.example.com/mcp/media">
            <label>Media check</label>
        </mcp-tool>
    </mcp-tools>
    <mcp-prompts>
        <mcp-prompt name="blog-context" url="https://app.example.com/mcp/prompt/blog-context">
            <label>Blog context</label>
            <label lang="zh-CN">文章上下文</label>
            <description>Context for blog management</description>
            <description lang="zh-CN">文章管理上下文</description>
        </mcp-prompt>
        <mcp-prompt name="category-context" url="https://app.example.com/mcp/prompt/category-context">
            <label>Category context</label>
        </mcp-prompt>
    </mcp-prompts>
    <mcp-resources>
        <mcp-resource name="blog-stats" uri="app-example://blog-stats" url="https://app.example.com/mcp/resource/blog-stats" mime-type="application/json">
            <label>Blog stats</label>
            <label lang="zh-CN">文章统计</label>
            <description>Live blog statistics</description>
        </mcp-resource>
        <mcp-resource name="blog-list" uri="app-example://blog-list" url="https://app.example.com/mcp/resource/blog-list" mime-type="application/json">
            <label>Blog list</label>
        </mcp-resource>
    </mcp-resources>
</mcp>
