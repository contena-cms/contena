<?xml version="1.0" encoding="utf-8" ?>
<entities xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../../../../../../../../src/Core/System/CustomEntity/Xml/entity-1.0.xsd">
    <entity name="ce_super_simple">
        <fields>
            <string name="test_string" channel-api-aware="true"/>
        </fields>
    </entity>
    <!-- @todo NEXT-22697 - Re-implement, when re-enabling cms-aware -->
<!--    <entity name="ce_cms_aware" cms-aware="true">-->
    <entity name="ce_cms_aware">
        <fields>
            <json name="payload" channel-api-aware="false" />
            <email name="email"  channel-api-aware="false" />
            <float name="price" channel-api-aware="false" />
            <date name="my_date" channel-api-aware="false" />
        </fields>
    </entity>
    <entity name="ce_complex">
        <fields>
            <int name="position" channel-api-aware="true" />
            <float name="rating" channel-api-aware="true" />
            <string name="title" required="true" translatable="true" channel-api-aware="true" />
            <text name="content" allow-html="true" translatable="true" channel-api-aware="true" />
            <bool name="display" translatable="true" channel-api-aware="true" />
            <json name="payload" channel-api-aware="false" />
            <email name="email"  channel-api-aware="false" />
            <float name="price" channel-api-aware="false" />
            <date name="my_date" channel-api-aware="false" />

            <many-to-many name="products" reference="product" channel-api-aware="true" />
            <many-to-one name="top_seller_restrict" reference="product" channel-api-aware="true" required="false" on-delete="restrict" />
            <many-to-one name="top_seller_cascade" reference="product" channel-api-aware="true" required="true" on-delete="cascade" />
            <many-to-one name="top_seller_set_null" reference="product" channel-api-aware="true" on-delete="set-null" />
            <one-to-one name="link_product_restrict" reference="product" channel-api-aware="false" on-delete="restrict" />
            <one-to-one name="link_product_cascade" reference="product" channel-api-aware="false" on-delete="cascade" />
            <one-to-one name="link_product_set_null" reference="product" channel-api-aware="false" on-delete="set-null" />
            <one-to-many name="links_restrict" reference="category" channel-api-aware="true" on-delete="restrict" />
            <one-to-many name="links_set_null" reference="category" channel-api-aware="true" on-delete="set-null" />
            <one-to-many name="comments" reference="ce_blog_comment" channel-api-aware="true" on-delete="cascade" reverse-required="true" />
            <many-to-many name="inherited_products" reference="product" channel-api-aware="true" inherited="true"/>
            <many-to-one name="inherited_top_seller" reference="product" channel-api-aware="true" required="false" inherited="true" on-delete="set-null"/>
            <one-to-one name="inherited_link_product" reference="product" channel-api-aware="true" inherited="true" on-delete="set-null" />
        </fields>
    </entity>
</entities>
