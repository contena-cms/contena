<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/contena-cms/contena/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>SwagApp</name>
        <label>Swag App Test</label>
        <label lang="de-DE">Swag App Test</label>
        <description>Test for App System</description>
        <description lang="de-DE">Test für das App System</description>
        <author>Contena</author>
        <copyright>(c) by Contena</copyright>
        <version>1.0.0</version>
        <icon>icon.png</icon>
        <license>MIT</license>
    </meta>
    <setup>
        <registrationUrl>https://my.app.com/SwagApp/registration</registrationUrl>
        <secret>s3cr3t</secret>
    </setup>
    <custom-fields>
        <custom-field-set>
            <name>custom_field_test</name>
            <label>Custom field test</label>
            <label lang="de-DE">Zusatzfeld Test</label>
            <related-entities>
                <blog/>
                <user/>
            </related-entities>
            <fields>
                <float name="test_float_field">
                    <label>Test float field</label>
                    <label lang="de-DE">Test Kommazahlenfeld</label>
                    <help-text>This is a float field.</help-text>
                    <position>2</position>
                    <steps>2.2</steps>
                    <min>0.5</min>
                    <max>1.6</max>
                    <placeholder>Enter a float...</placeholder>
                </float>
            </fields>
        </custom-field-set>
    </custom-fields>
</manifest>
