{% set page = hook.page %}
{# @var page \Contena\Frontend\Page\Page #}

{% set criteria = {
    'filter': [
        { 'field': 'blogNumber', 'type': 'equals', 'value': 'p1' }
    ]
} %}

{% set blogIds = services.repository.ids('blog', criteria).ids %}

{% do page.addArrayExtension('myProductIds', {
    'ids': blogIds
}) %}
