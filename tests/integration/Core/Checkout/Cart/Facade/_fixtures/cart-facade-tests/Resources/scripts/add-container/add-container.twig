{# @var services \Contena\Core\Framework\Script\ServiceStubs #}
{% set p1 = hook.ids.get('p1') %}

{% do services.cart.blogs.add(p1, 5) %}

{% set blog = services.cart.blogs.get(p1) %}

{# @var container \Contena\Core\Checkout\Cart\Facade\ContainerFacade #}
{% set container = services.cart.container('my-container') %}

{% do container.add(blog.take(1, 'first')) %}

{% do container.add(blog.take(1, 'second')) %}

{% do container.discount('discount', 'percentage', -10, 'Fancy discount') %}

{% do services.cart.items.add(container) %}
