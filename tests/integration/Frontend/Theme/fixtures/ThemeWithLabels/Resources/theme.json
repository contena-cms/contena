{
  "name": "SwagTheme",
  "author": "Contena",
  "views": [
     "@Frontend",
     "@Plugins",
     "@SwagTheme"
  ],
  "style": [
    {
      "app/frontend/src/scss/overrides.scss": {}
    },
    "@Frontend",
    {
      "app/frontend/src/scss/base.scss": {
        "resolve": {
          "vendor": "app/frontend/vendor"
        }
      }
    }
  ],
  "script": [
    "@Frontend",
    "app/frontend/dist/js/main.js"
  ],
  "asset": [
    "app/frontend/dist/assets"
  ],
  "previewMedia": "app/frontend/dist/assets/preview.jpg",
  "config": {
    "fields": {
      "sw-image": {
        "type": "media",
        "value": "app/frontend/dist/assets/test.jpg",
        "label": {
          "en-GB": "test label",
          "de-DE": "Test label"
        },
        "helpText": {
          "en-GB": "test help",
          "de-DE": "Test Hilfe"
        }
      }
    }
  }
}
