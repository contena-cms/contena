<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/contena-cms/contena/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>SwagFrontendSeoUrl</name>
        <label>Swag Frontend SEO URLs</label>
        <description>Declares frontend SEO URLs for app scripts</description>
        <author>Contena</author>
        <copyright>(c) by Contena</copyright>
        <version>2.0.0</version>
        <license>MIT</license>
    </meta>
    <frontend>
        <seo-url name="imprint">
            <path>imprint</path>
            <path lang="de-DE">impressum</path>
        </seo-url>
        <entity-seo-url name="app-blog" entity="blog">
            <default-template>app-blog/{{ blog.blogNumber }}</default-template>
        </entity-seo-url>
        <entity-seo-url name="blog-reviews" entity="blog_review">
            <default-template>blog-reviews/{{ blogReview.title }}</default-template>
        </entity-seo-url>
    </frontend>
    <permissions>
        <read>blog</read>
        <read>blog_review</read>
    </permissions>
</manifest>
