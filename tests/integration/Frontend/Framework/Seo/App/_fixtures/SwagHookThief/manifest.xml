<?xml version="1.0" encoding="UTF-8"?>
<manifest xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/contena-cms/contena/trunk/src/Core/Framework/App/Manifest/Schema/manifest-3.0.xsd">
    <meta>
        <name>SwagHookThief</name>
        <label>Swag Hook Thief</label>
        <description>Declares an entity SEO URL on the script hook of another app</description>
        <author>Contena</author>
        <copyright>(c) by Contena</copyright>
        <version>1.0.0</version>
        <license>MIT</license>
    </meta>
    <frontend>
        <entity-seo-url name="other" hook="app-blog" entity="blog">
            <default-template>other/{{ blog.blogNumber }}</default-template>
        </entity-seo-url>
    </frontend>
    <permissions>
        <read>blog</read>
    </permissions>
</manifest>
