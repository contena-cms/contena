@@ -79,6 +79,40 @@
         {
             return $comment !== null
                 && \Psl\Regex\matches($comment, '/\s+@experimental\s+/');
+        }
+    }
+
+    /**
+     * @final classes are not supported extension points in Contena (mirrored by the
+     * PHPStan rules), so checks that only protect subclasses are skipped for them,
+     * like for native final classes. Caller-facing checks (return type covariance,
+     * parameter contravariance, method removal, ...) still apply.
+     */
+    class SkipSubclassOnlyChecksOnFinalClasses implements ClassBased\ClassBased, MethodBased\MethodBased, FunctionBased\FunctionBased
+    {
+        public function __construct(private $check)
+        {
+        }
+
+        public function __invoke($from, $to): \Roave\BackwardCompatibility\Changes
+        {
+            $class = $from instanceof \Roave\BetterReflection\Reflection\ReflectionMethod
+                ? $from->getDeclaringClass()
+                : $from;
+
+            if ($class instanceof \Roave\BetterReflection\Reflection\ReflectionClass
+                && ($class->isFinal() || $this->isFinalDocComment($class->getDocComment()))
+            ) {
+                return \Roave\BackwardCompatibility\Changes::empty();
+            }
+
+            return ($this->check)($from, $to);
+        }
+
+        private function isFinalDocComment(string|null $comment): bool
+        {
+            return $comment !== null
+                && \Psl\Regex\matches($comment, '/\s@final[\s\*\/]/');
         }
     }
 
