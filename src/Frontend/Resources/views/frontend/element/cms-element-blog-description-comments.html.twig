{% block element_product_description_reviews %}
    {% set config = element.fieldConfig.elements %}
    {% set blog = element.data.blog %}
    {% set descriptionTabId = 'description-tab-' ~ blog.id %}
    {% set descriptionTabHref = '#description-tab-' ~ blog.id ~ '-pane' %}
    {% set descriptionTabContent = 'description-tab-' ~ blog.id ~ '-pane' %}
    {% set reviewTabId = 'comment-tab-' ~ blog.id %}
    {% set reviewTabHref = '#comment-tab-' ~ blog.id ~ '-pane' %}
    {% set reviewTabContent = 'comment-tab-' ~ blog.id ~ '-pane' %}

    {% if blog %}
        <div class="blog-detail-tabs cms-element-{{ element.type }}{% if config.alignment.value %} has-vertical-alignment{% endif %}">
            {% if config.alignment.value %}
                <div class="cms-element-alignment{% if config.alignment.value == 'center' %} align-self-center{% elseif config.alignment.value == 'flex-end' %} align-self-end{% else %} align-self-start{% endif %}">
            {% endif %}
                <div class="card card-tabs">
                    {% block element_product_description_reviews_tabs_navigation %}
                        <div class="cms-card-header card-header blog-detail-tab-navigation blog-description-comments-tab-navigation">
                            {% block element_product_description_reviews_tabs_navigation_container %}
                                <ul class="nav nav-tabs blog-detail-tab-navigation-list"
                                    id="blog-detail-tabs"
                                    role="tablist">
                                    {% block element_product_description_reviews_tabs_navigation_description %}
                                        <li class="nav-item">
                                            <a class="nav-link {% if (ratingSuccess != 1) and (ratingSuccess != -1) %}active{% endif %} blog-detail-tab-navigation-link description-tab"
                                               id="{{ descriptionTabId }}"
                                               data-bs-toggle="tab"
                                               data-off-canvas-tabs="true"
                                               href="{{ descriptionTabHref }}"
                                               role="tab"
                                               aria-controls="{{ descriptionTabContent }}"
                                               aria-selected="true">
                                                <span>{{ 'detail.tabsDescription'|trans|sw_sanitize }}</span>
                                                <span class="blog-detail-tab-navigation-icon">
                                                    {% sw_icon 'arrow-medium-right' style {pack:'solid'} %}
                                                </span>
                                                {% if blog.translated.description|length > 0 %}
                                                    <span class="blog-detail-tab-preview">
                                                        {{ blog.translated.description|striptags|u.truncate(125, '…')|raw }}

                                                        {# truncate always cuts down the length to 125 characters.
                                                               So it will only shorten the string if it exceeds 125 chars.
                                                               Therefor, only show the button when the length of the text is
                                                               greater or equal then 126 characters. #}
                                                        {% if blog.translated.description|length >= 126 %}
                                                            <span class="blog-detail-tab-preview-more">{{ 'detail.tabsPreviewMore'|trans|sw_sanitize }}</span>
                                                        {% endif %}
                                                        </span>
                                                {% endif %}
                                            </a>
                                        </li>
                                    {% endblock %}

                                    {% block element_product_description_reviews_tabs_navigation_review %}
                                        {% if config('core.listing.showComment') %}
                                            <li class="nav-item">
                                                <a class="nav-link {% if (ratingSuccess == 1) or (ratingSuccess == -1) %}active{% endif %} blog-detail-tab-navigation-link comment-tab"
                                                   id="{{ reviewTabId }}"
                                                   data-bs-toggle="tab"
                                                   data-off-canvas-tabs="true"
                                                   href="{{ reviewTabHref }}"
                                                   role="tab"
                                                   aria-controls="{{ reviewTabContent }}"
                                                   aria-selected="true">
                                                    {{ 'detail.tabsComment'|trans|sw_sanitize }}
                                                    <span class="blog-detail-tab-navigation-icon">
                                                        {% sw_icon 'arrow-medium-right' style {pack:'solid'} %}
                                                    </span>
                                                </a>
                                            </li>
                                        {% endif %}
                                    {% endblock %}
                                </ul>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block element_product_description_reviews_tabs_content %}
                        <div class="blog-detail-tabs-content card-body">
                            {% block element_product_description_reviews_tabs_content_container %}
                                <div class="tab-content">
                                    {% block element_product_description_reviews_tabs_content_description %}
                                        <div class="tab-pane fade show {% if (element.data.ratingSuccess != 1) and (element.data.ratingSuccess != -1) %}active{% endif %}"
                                             id="{{ descriptionTabContent }}"
                                             role="tabpanel"
                                             aria-labelledby="{{ descriptionTabId }}">
                                            {% sw_include '@Frontend/frontend/component/blog/description.html.twig' with {
                                                blog: element.data.blog
                                            } %}
                                        </div>
                                    {% endblock %}

                                    {% block element_product_description_reviews_tabs_content_review %}
                                        {% if config('core.listing.showComment') %}
                                            <div class="tab-pane fade show {% if (element.data.ratingSuccess == 1) or (element.data.ratingSuccess == -1) %}active{% endif %}"
                                                 id="{{ reviewTabContent }}"
                                                 role="tabpanel"
                                                 aria-labelledby="{{ reviewTabId }}">
                                                {% sw_include '@Frontend/frontend/component/comment/comment.html.twig' with {
                                                    comments: element.data.comments,
                                                    blog: element.data.blog
                                                } %}
                                            </div>
                                        {% endif %}
                                    {% endblock %}
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}
                </div>
            {% if config.alignment.value %}
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}
