{% set formAction = path('frontend.checkout.line-item.add') %}
{% set addToCartOptions = blog.isCloseout ? {
        stockAdjustedText: 'component.blog.quantitySelect.stockAdjusted'|trans|striptags,
        outOfStockText: 'component.blog.quantitySelect.outOfStock'|trans|striptags
    } : {}
%}
{% set quantitySelectorOptions = blog.isCloseout ? {
        purchaseLimitUrl: path('frontend.blog.purchase-limit', { blogId: blog.id })
    } : {}
%}

{% block buy_widget_buy_form_inner %}
    <form id="blogDetailPageBuyProductForm"
          action="{{ formAction }}"
          method="post"
          class="buy-widget"
          data-add-to-cart="true"
          {% if addToCartOptions is not empty %}data-add-to-cart-options="{{ addToCartOptions|json_encode|e('html_attr') }}"{% endif %}>

        {% set DIGITAL_CONST = constant('Contena\\Core\\Content\\Blog\\BlogDefinition::TYPE_DIGITAL') %}
        {% set isDigital = blog.type is defined and blog.type == DIGITAL_CONST %}

        {% if not feature('v6.8.0.0') %}
            {% set DOWNLOAD_STATE = constant('Contena\\Core\\Content\\Blog\\State::IS_DOWNLOAD') %}
            {% set isDigital = isDigital or (blog.states is defined and DOWNLOAD_STATE in blog.states) %}
        {% endif %}

        {% set isQuantitySelectHidden = isDigital and blog.calculatedMaxPurchase <= 1 %}

        {% set showQuantitySelect = not isQuantitySelectHidden %}

        {% set buyable = blog.available and blog.childCount <= 0 and blog.calculatedMaxPurchase > 0 %}

        {% block buy_widget_buy_container %}
            {% if buyable %}
                <div class="row g-2 buy-widget-container">
                    {% block buy_widget_buy_quantity_container %}
                        {% if showQuantitySelect %}
                            <fieldset class="col-4 d-flex justify-content-end">
                                {% block buy_widget_buy_quantity_input_group %}
                                    {% block buy_widget_buy_quantity_input_group_legend %}
                                        <legend class="form-label visually-hidden">
                                            {{ 'component.blog.quantitySelect.legend'|trans|striptags }}
                                        </legend>
                                    {% endblock %}

                                    <div id="blog-detail-quantity-group-{{ blog.id }}"
                                         class="input-group blog-detail-quantity-group quantity-selector-group"
                                         data-quantity-selector="true"
                                         {% if quantitySelectorOptions is not empty %}data-quantity-selector-options="{{ quantitySelectorOptions|json_encode|e('html_attr') }}"{% endif %}>
                                        {% block buy_widget_buy_quantity_input_group_button_minus %}
                                            <button type="button"
                                                    class="btn btn-outline-light btn-minus js-btn-minus"
                                                    aria-label="{{ 'component.blog.quantitySelect.decrease'|trans|striptags }}">
                                                {% sw_icon 'minus' style {size: 'xs'} %}
                                            </button>
                                        {% endblock %}

                                        {% block buy_widget_buy_quantity_input_group_input %}
                                            <input type="number"
                                                   name="lineItems[{{ blog.id }}][quantity]"
                                                   class="form-control js-quantity-selector quantity-selector-group-input"
                                                   min="{{ blog.minPurchase }}"
                                                   max="{{ blog.calculatedMaxPurchase }}"
                                                   step="{{ blog.purchaseSteps }}"
                                                   value="{{ blog.minPurchase }}"
                                                   aria-label="{{ 'component.blog.quantitySelect.label'|trans|striptags }}">
                                        {% endblock %}

                                        {% block buy_widget_buy_quantity_input_group_button_plus %}
                                            <button type="button"
                                                    class="btn btn-outline-light btn-plus js-btn-plus"
                                                    aria-label="{{ 'component.blog.quantitySelect.increase'|trans|striptags }}">
                                                {% sw_icon 'plus' style {size: 'xs'} %}
                                            </button>
                                        {% endblock %}

                                        {% if blog.translated.packUnit %}
                                            {% block buy_widget_buy_quantity_input_group_unit %}
                                                <span class="input-group-text js-quantity-selector-unit"
                                                      data-unit-singular="{{ blog.translated.packUnit|e('html_attr') }}"
                                                      {% if blog.translated.packUnitPlural %}data-unit-plural="{{ blog.translated.packUnitPlural|e('html_attr') }}"{% endif %}>
                                                    {% if blog.minPurchase > 1 and blog.translated.packUnitPlural %}
                                                        {{ blog.translated.packUnitPlural }}
                                                    {% elseif blog.translated.packUnit %}
                                                        {{ blog.translated.packUnit }}
                                                    {% endif %}
                                                </span>
                                            {% endblock %}
                                        {% endif %}
                                    </div>

                                    {# Aria live region to tell the screen reader what quantity amount is selected when changing the quantity. #}
                                    {% block buy_widget_buy_quantity_live_area %}
                                        <div class="quantity-area-live visually-hidden"
                                             aria-live="polite"
                                             aria-atomic="true"
                                             data-aria-live-text="{{ 'component.blog.quantitySelect.areaLiveText'|trans|striptags }}"
                                             data-aria-live-blog-name="{{ blog.translated.name }}">
                                            {# The live region content is generated by the `QuantitySelectorPlugin` #}
                                        </div>
                                    {% endblock %}
                                {% endblock %}
                            </fieldset>
                        {% endif %}
                    {% endblock %}

                    {% block buy_widget_buy_redirect_input %}
                        {# fallback redirect back to detail page is deactivated via js #}
                        <input type="hidden"
                               name="redirectTo"
                               value="frontend.detail.page">

                        <input type="hidden"
                               name="redirectParameters"
                               data-redirect-parameters="true"
                               value="{{ {blogId: blog.id}|json_encode }}">
                    {% endblock %}

                    {% block buy_widget_buy_product_buy_info %}
                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][id]"
                               value="{{ blog.id }}">
                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][type]"
                               value="blog">
                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][referencedId]"
                               value="{{ blog.id }}">
                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][stackable]"
                               value="1">
                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][removable]"
                               value="1">

                        <input type="hidden"
                               name="lineItems[{{ blog.id }}][payload][manufacturerName]"
                               value="{{ blog.manufacturer ? blog.manufacturer.getName() : '' }}">

                        {# Google Analytics supports up to 5 category levels. We take the first 5 from the breadcrumb. #}
                        {% if page is defined and page.blog is defined %}
                            {% set breadcrumb = [] %}
                            {% set useNewBreadcrumb = feature('v6.8.0.0') or feature('BREADCRUMB_REWORK') %}
                            {% if useNewBreadcrumb %}
                                {% set breadcrumb = page.breadcrumb|default([])|slice(0, 5) %}
                            {% elseif page.blog.seoCategory %}
                                {% set breadcrumb = sw_breadcrumb_full(page.blog.seoCategory, context)|slice(0, 5) %}
                            {% endif %}
                            {% for i, category in breadcrumb %}
                                <input type="hidden"
                                       name="lineItems[{{ blog.id }}][payload][categoryNames][{{ useNewBreadcrumb ? category.categoryId : i }}]"
                                       value="{{ category.name }}">
                            {% endfor %}
                        {% endif %}
                    {% endblock %}

                    {% block buy_widget_product_buy_meta %}
                        <input type="hidden"
                               name="blog-name"
                               value="{{ blog.translated.name }}">
                        <input type="hidden"
                               name="brand-name"
                               value="{{ blog.manufacturer ? blog.manufacturer.getName() : '' }}">
                    {% endblock %}

                    {% block buy_widget_buy_button_container %}
                        <div class="{% if showQuantitySelect %}col-8{% else %}col-12{% endif %}">
                            {% block buy_widget_buy_button %}
                                <div class="d-grid">
                                    <button class="btn btn-primary btn-buy"
                                            type="submit"
                                            title="{{ 'detail.addProduct'|trans|striptags }}"
                                            aria-label="{{ 'detail.addProduct'|trans|striptags }}">
                                        {{ 'detail.addProduct'|trans|sw_sanitize }}
                                    </button>
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}
                </div>

                {% if blog.isCloseout %}
                    {% block buy_widget_buy_quantity_stock_adjusted_template %}
                        <template class="js-quantity-stock-adjusted-template">
                            <div class="mt-2">
                                {% sw_include '@Frontend/frontend/utilities/alert.html.twig' with {
                                    type: 'warning',
                                    content: '',
                                } %}
                            </div>
                        </template>
                    {% endblock %}
                {% endif %}
            {% endif %}
        {% endblock %}
    </form>
{% endblock %}
