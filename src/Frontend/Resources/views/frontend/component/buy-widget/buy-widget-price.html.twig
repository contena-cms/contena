{% block buy_widget_price_inner %}
    {% if blog.calculatedPrices|length > 1 %}
        {% block buy_widget_price_block %}
            <div class="blog-block-prices">
                {% block buy_widget_price_block_table %}
                    <table class="table blog-block-prices-grid">
                        {% block buy_widget_price_block_table_head %}
                            <thead class="blog-block-prices-head">
                            {% block buy_widget_price_block_table_head_inner %}
                                <tr class="blog-block-prices-row">
                                    <th scope="col" class="blog-block-prices-cell">
                                        {{ 'detail.dataColumnQuantity'|trans|sw_sanitize }}
                                    </th>
                                    <th scope="col" class="blog-block-prices-cell">
                                        {{ 'detail.dataColumnPrice'|trans|sw_sanitize }}
                                    </th>
                                    {% if blog.calculatedPrice.referencePrice %}
                                        <th scope="col" class="blog-block-prices-cell">
                                            {{ 'detail.dataColumnReferencePrice'|trans|sw_sanitize }}
                                        </th>
                                    {% endif %}
                                </tr>
                            {% endblock %}
                            </thead>
                        {% endblock %}

                        {% block buy_widget_price_block_table_body %}
                            <tbody class="blog-block-prices-body">
                            {% block buy_widget_price_block_table_body_inner %}
                                {% for price in blog.calculatedPrices %}
                                    {% block buy_widget_price_block_table_body_row %}
                                        {# @deprecated tag:v6.8.0 - Tiered Offer microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
                                        <tr class="blog-block-prices-row"
                                            {% if not feature('JSON_LD_DATA') %}
                                            itemprop="offers" itemscope
                                            itemtype="https://schema.org/Offer"
                                            {% endif %}>
                                            {% block buy_widget_price_block_table_body_cell_quantity %}
                                                <th scope="row" class="blog-block-prices-cell blog-block-prices-cell-thin">
                                                    {# @deprecated tag:v6.8.0 - Offer price/currency microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
                                                    {% if not feature('JSON_LD_DATA') %}
                                                        <meta itemprop="priceCurrency" content="{{ context.currency.translated.shortName }}">
                                                        <meta itemprop="price" content="{{ price.unitPrice }}">
                                                    {% endif %}

                                                    {% if loop.last %}
                                                        {{ 'detail.priceDataInfoFrom'|trans|sw_sanitize }}
                                                        <span class="blog-block-prices-quantity">{{ price.quantity }}</span>

                                                    {% else %}
                                                        {{ 'detail.priceDataInfoUntil'|trans|sw_sanitize }}
                                                        <span class="blog-block-prices-quantity">{{ price.quantity }}</span>
                                                    {% endif %}
                                                </th>
                                            {% endblock %}

                                            {% block buy_widget_price_block_table_body_cell_price %}
                                                <td class="blog-block-prices-cell">
                                                    {% sw_include '@Frontend/frontend/component/blog/block-price.html.twig' with {
                                                        price: price
                                                    } only %}
                                                </td>
                                            {% endblock %}

                                            {% block buy_widget_price_block_table_body_cell_reference_price %}
                                                {% if price.referencePrice is not null %}
                                                    <td class="blog-block-prices-cell blog-block-prices-cell-thin">
                                                        {{ price.referencePrice.price|currency }} / {{ price.referencePrice.referenceUnit }} {{ price.referencePrice.unitName }}
                                                    </td>
                                                {% endif %}
                                            {% endblock %}
                                        </tr>
                                    {% endblock %}
                                {% endfor %}
                            {% endblock %}
                            </tbody>
                        {% endblock %}
                    </table>
                {% endblock %}
            </div>
        {% endblock %}
    {% else %}
        {% set price = blog.calculatedPrice %}

        {% if blog.calculatedPrices|length == 1 %}
            {% set price = blog.calculatedPrices.first %}
        {% endif %}

        {# @deprecated tag:v6.8.0 - Offer price microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
        {% if not feature('JSON_LD_DATA') %}
            <meta itemprop="price"
                  content="{{ price.unitPrice }}">
        {% endif %}

        {% block buy_widget_price_content %}
            {% set listPrice = price.listPrice %}
            {% set isRegulationPrice = price.regulationPrice != null %}
            {# A regulation price replaces the list price as the reference for the displayed saving. #}
            {% set isListPrice = price.listPrice.percentage > 0 and not isRegulationPrice %}
            {% set isRegulationPriceSaving = price.regulationPrice.percentage > 0 %}
            {% set displaySalePrice = isListPrice or isRegulationPriceSaving %}

            <span class="visually-hidden blog-detail-price-label">
                {% if displaySalePrice %}
                    {{ 'listing.listPriceLabel'|trans|sw_sanitize }}
                {% else %}
                    {{ 'listing.regularPriceLabel'|trans|sw_sanitize }}
                {% endif %}
            </span>

            <p class="blog-detail-price{% if displaySalePrice %} with-list-price{% endif %}{% if isRegulationPrice %} with-regulation-price{% endif %}">
                {{ price.unitPrice|currency }}
            </p>

            {% if isListPrice %}
                {% block buy_widget_was_price %}
                    {% block buy_widget_was_price_badge %}
                        <span class="list-price-badge">&#37;</span>
                    {% endblock %}

                    {% set afterListPriceSnippetExists = false %}
                    {% set beforeListPriceSnippetExists = false %}
                    {% if not feature('v6.8.0.0') %}
                        {# @deprecated tag:v6.8.0 - Snippets listing.beforeListPrice and listing.afterListPrice will be removed. Use twig blocks instead. #}
                        {% set afterListPriceSnippetExists = 'listing.afterListPrice'|trans|length > 0 %}
                        {% set beforeListPriceSnippetExists = 'listing.beforeListPrice'|trans|length > 0 %}
                    {% endif %}

                    {% block buy_widget_was_price_wrapper %}
                        <span class="blog-detail-list-price-wrapper">
                            {% block buy_widget_was_price_before %}
                                {% sw_include '@Frontend/frontend/component/blog/list-price-affix.html.twig' with {
                                    position: 'before'
                                } %}
                            {% endblock %}

                            {# @deprecated tag:v6.8.0 - Snippet listing.beforeListPrice output will be removed. Use twig blocks instead. #}
                            {% if beforeListPriceSnippetExists %}{{ 'listing.beforeListPrice'|trans|trim }}{% endif %}

                            <span class="visually-hidden list-price-label">{{ 'listing.regularPriceLabel'|trans|sw_sanitize }}</span>

                            {# @deprecated tag:v6.8.0 - The conditional "list-price-price" class will be set unconditionally. #}
                            <span{% if not (afterListPriceSnippetExists or beforeListPriceSnippetExists) %} class="list-price-price"{% endif %}>{{ listPrice.price|currency }}</span>

                            {% block buy_widget_was_price_after %}
                                {% sw_include '@Frontend/frontend/component/blog/list-price-affix.html.twig' with {
                                    position: 'after'
                                } %}
                            {% endblock %}

                            {# @deprecated tag:v6.8.0 - Snippet listing.afterListPrice output will be removed. Use twig blocks instead. #}
                            {% if afterListPriceSnippetExists %}{{ 'listing.afterListPrice'|trans|trim }}{% endif %}

                            <span class="list-price-percentage">{{ 'detail.listPricePercentage'|trans({'%price%': listPrice.percentage })|sw_sanitize }}</span>
                        </span>
                    {% endblock %}
                {% endblock %}
            {% endif %}
            {% if isRegulationPrice %}
                {% if isRegulationPriceSaving %}
                    {{ block('buy_widget_was_price_badge') }}
                {% endif %}
                <span class="blog-detail-list-price-wrapper">
                    <span class="regulation-price">{{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}</span>
                    {% if isRegulationPriceSaving %}
                        <span class="list-price-percentage">{{ 'detail.listPricePercentage'|trans({'%price%': price.regulationPrice.percentage })|sw_sanitize }}</span>
                    {% endif %}
                </span>
            {% endif %}
        {% endblock %}

        {# @deprecated tag:v6.8.0 - block will be moved into buy-widget.html.twig #}
        {% block buy_widget_price_unit %}
            {# @deprecated tag:v6.8.0 - block will be moved into buy-widget.html.twig #}
            {% block buy_widget_price_unit_label %}
            {% endblock %}

            {# @deprecated tag:v6.8.0 - block will be moved into buy-widget.html.twig #}
            {% block buy_widget_price_unit_content %}
            {% endblock %}

            {# @deprecated tag:v6.8.0 - block will be moved into buy-widget.html.twig #}
            {% block buy_widget_price_unit_reference_content %}
            {% endblock %}
        {% endblock %}
    {% endif %}
{% endblock %}
