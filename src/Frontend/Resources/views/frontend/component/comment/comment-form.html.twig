{% block component_comment_form %}

    {% if data is not defined and comments.userComment is defined %}
        {% set data = comments.userComment %}
    {% endif %}

    {% set formAjaxSubmitOptions = {
        replaceSelectors: '.js-comment-container'
    } %}

    {% block component_comment_form_form %}
        <form class="comment-form"
              action="{{ path('frontend.detail.comment.save', { blogId: comments.blogId }) }}"
              method="post"
              data-form-handler="true"
              data-form-ajax-submit="true"
              data-form-ajax-submit-options="{{ formAjaxSubmitOptions|json_encode }}">
            {% block component_comment_form_forward %}
                <input type="hidden"
                       name="forwardTo"
                       value="frontend.blog.comments">

                <input type="hidden"
                       name="parentId"
                       value="{{ comments.parentId }}">

                <input type="hidden"
                       name="forwardParameters"
                       value="{{ {blogId: comments.blogId}|json_encode }}">
            {% endblock %}

            {% if comments.userComment %}
                <input type="hidden" name="id" value="{{ comments.userComment.id }}">
            {% endif %}

            {% block component_comment_form_details %}
                <div class="row g-2">

                    {% block component_comment_form_title %}
                        {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {
                            label: 'detail.commentFormTitleLabel'|trans|sw_sanitize,
                            id: 'commentTitle',
                            name: 'title',
                            value: data.get('title'),
                            violationPath: '/title',
                            validationRules: 'required,minLength',
                            minlength: '5',
                            maxlength: '255',
                            additionalClass: 'col-12 blog-detail-comment-form-title',
                            description: 'detail.commentTitleMinLengthHint'|trans|sw_sanitize
                        } %}
                    {% endblock %}
                </div>
            {% endblock %}

            {% block component_comment_form_content %}
                <div class="row g-2">
                    {% sw_include '@Frontend/frontend/component/form/form-textarea.html.twig' with {
                        label: 'detail.commentFormContentLabel'|trans|sw_sanitize,
                        id: 'commentContent',
                        name: 'content',
                        value: data.get('content'),
                        violationPath: '/content',
                        validationRules: 'required,minLength',
                        minlength: '40',
                        additionalClass: 'col-12 blog-detail-comment-form-content',
                        description: 'detail.commentTextMinLengthHint'|trans|sw_sanitize
                    } %}
                </div>
            {% endblock %}

            {% block component_comment_form_footer %}
                <div class="blog-detail-comment-form-footer">
                    {% block component_comment_form_required %}
                        <p class="required-fields">
                            {{ 'global.default.noteRequiredFields'|trans|sw_sanitize }}
                        </p>
                    {% endblock %}

                    <div class="blog-detail-comment-form-actions">
                        {% block component_comment_form_cancel %}
                            <a href="#"
                               class="btn btn-outline-secondary blog-detail-comment-cancel"
                               data-bs-toggle="collapse"
                               data-bs-target=".multi-collapse"
                               aria-expanded="false"
                               aria-controls="comment-form comment-list">
                                {{ 'global.default.cancel'|trans|sw_sanitize }}
                            </a>
                        {% endblock %}

                        {% block component_comment_form_submit %}
                            <button type="submit"
                                    class="btn btn-primary btn-comment-submit">
                                {{ 'detail.commentFormSubmitText'|trans|sw_sanitize }}
                            </button>
                        {% endblock %}
                    </div>
                </div>
            {% endblock %}
        </form>
    {% endblock %}
{% endblock %}
