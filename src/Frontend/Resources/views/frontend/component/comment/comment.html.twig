{% sw_extends '@Frontend/frontend/utilities/offcanvas.html.twig' %}

{% block utilities_offcanvas_content %}
	{% block component_comment_container %}

		{% set commentsPerListPage = config('core.listing.commentsPerPage') %}
		{% if commentsPerListPage <= 0 %}
			{% set commentsPerListPage = 10 %}
		{% endif %}

		{% set currentListPage = comments.page %}

		{% set blogCommentCount = comments.total %}
        {% set totalCommentCount = comments.total %}

		{% set totalCommentsInCurrentLanguage = comments.totalCommentsInCurrentLanguage ?: blogCommentCount %}
		{% set numberOfCommentsNotInCurrentLanguage = blogCommentCount - totalCommentsInCurrentLanguage %}

		<div class="blog-detail-comment tab-pane-container">
			{% block component_comment_tab_pane %}
                <div class="row blog-detail-comment-content js-comment-container">
					{% block component_comment_aside %}
						<div class="col-sm-4">
							{% block component_comment_widget_container %}
								{% sw_include '@Frontend/frontend/component/comment/comment-widget.html.twig' %}
							{% endblock %}
						</div>
					{% endblock %}

					{% block component_comment_main %}
						<div class="col blog-detail-comment-main js-comment-content">
							{% block component_comment_alert %}
								{% if ratingSuccess == 1 %}
									{% sw_include '@Frontend/frontend/utilities/alert.html.twig' with {
										type: 'success',
										content: 'detail.commentFormSuccessAlert'|trans|sw_sanitize
									} %}
                                {% elseif ratingSuccess == 2 %}
                                    {% sw_include '@Frontend/frontend/utilities/alert.html.twig' with {
                                        type: 'success',
                                        content: 'detail.commentFormSuccessUpdateAlert'|trans|sw_sanitize
                                    } %}
								{% elseif ratingSuccess == -1 %}
									{% sw_include '@Frontend/frontend/utilities/alert.html.twig' with {
										type: 'danger',
										content: 'detail.commentFormErrorAlert'|trans|sw_sanitize
									} %}
								{% endif %}
							{% endblock %}

							{% block component_comment_form_container %}
								<div class="collapse multi-collapse{% if ratingSuccess == -1 %} show{% endif %}"
									 id="comment-form">

                                    {% if context.user and not context.user.guest %}
										<div class="blog-detail-comment-form">
											{% sw_include '@Frontend/frontend/component/comment/comment-form.html.twig' %}
										</div>
									{% else %}
										<div class="blog-detail-comment-login">
											{% sw_include '@Frontend/frontend/component/comment/comment-login.html.twig' %}
										</div>
									{% endif %}
								</div>
							{% endblock %}

							{% block component_comment_list_container %}
								<div id="comment-list"
									 class="collapse multi-collapse blog-detail-comment-list{% if ratingSuccess != -1 %} show{% endif %}">
                                    {% block component_comment_list %}
                                        {% set formAjaxSubmitOptions = {
                                            replaceSelectors: ['.js-comment-container'],
                                            submitOnChange: true
                                        } %}

                                        {% block component_comment_list_actions %}
                                            {% block component_comment_list_action_filters %}
                                                <div class="row align-items-center blog-detail-comment-actions">
                                                    {% block component_comment_list_action_language %}
                                                        <div class="col blog-detail-comment-language">
                                                            {% block component_comment_list_action_language_form %}
                                                                <form class="blog-detail-comment-language-form"
                                                                    action="{{ path('frontend.blog.comments', { blogId: comments.blogId, parentId: comments.parentId }) }}"
                                                                    method="post"
                                                                    data-form-ajax-submit="true"
                                                                    data-form-ajax-submit-options="{{ formAjaxSubmitOptions|json_encode }}">

                                                                    <input type="hidden" name="redirectTo" value="{{ redirectTo }}">

                                                                    {% if app.request.get('sort') %}
                                                                    <input type="hidden" name="sort" value="{{ app.request.get('sort') }}">
                                                                {% endif %}

                                                                        {% endfor %}
                                                                    {% endif %}

                                                                    {% block component_comment_list_action_language_switch %}
                                                                        <div class="form-check form-switch">
                                                                            <input type="checkbox"
                                                                                class="form-check-input"
                                                                                id="showForeignComments"
                                                                                value="filter-language"
                                                                                name="language"
                                                                                {% if app.request.get('language') %}checked="checked"{% endif %}
                                                                                {% if numberOfCommentsNotInCurrentLanguage is same as(0) and not app.request.get('language') %}disabled="disabled"{% endif %}>
                                                                            <label class="custom-control-label form-label"
                                                                                for="showForeignComments">
                                                                                <small>{{ 'detail.commentLanguageFilterLabel'|trans|sw_sanitize }}</small>
                                                                            </label>
                                                                        </div>
                                                                    {% endblock %}
                                                                </form>
                                                            {% endblock %}
                                                        </div>
                                                    {% endblock %}

                                                    {% block component_comment_list_action_sortby %}
                                                        {% if blogCommentCount > 0 %}
                                                            <div class="col-12 col-md-auto blog-detail-comment-sortby">
                                                                {% block component_comment_list_action_sortby_form %}
                                                                    <form class="form-inline blog-detail-comment-sortby-form"
                                                                        action="{{ path('frontend.blog.comments', { blogId: comments.blogId, parentId: comments.parentId }) }}"
                                                                        method="post"
                                                                        data-form-ajax-submit="true"
                                                                        data-form-ajax-submit-options="{{ formAjaxSubmitOptions|json_encode }}">

                                                                        <input type="hidden" name="redirectTo" value="{{ redirectTo }}">

                                                                        {% if app.request.get('language') %}
                                                                        <input type="hidden" name="language" value="{{ app.request.get('language') }}">
                                                                    {% endif %}

                                                                            {% endfor %}
                                                                        {% endif %}

                                                                        {% block component_comment_list_action_sortby_label %}
                                                                            <label class="form-label blog-detail-comment-sortby-label"
                                                                                for="commentsSortby">
                                                                                <small>{{ 'detail.commentSortLabel'|trans|sw_sanitize }}</small>
                                                                            </label>
                                                                        {% endblock %}

                                                                        {% block component_comment_list_action_sortby_select %}
                                                                            <select class="form-select form-select-sm"
                                                                                    name="sort"
                                                                                    id="commentsSortby">
                                                                                <option value="createdAt"{% if comments.criteria.sorting.0.field == 'createdAt' %} selected{% endif %}>
                                                                                    {{ 'detail.commentSortNewLabel'|trans|sw_sanitize }}
                                                                                </option>
                                                                                    {{ 'detail.commentSortTopRatedLabel'|trans|sw_sanitize }}
                                                                                </option>
                                                                            </select>
                                                                        {% endblock %}
                                                                    </form>
                                                                {% endblock %}
                                                            </div>
                                                        {% endif %}
                                                    {% endblock %}
                                                </div>
                                            {% endblock %}

                                            {% block component_comment_list_counter %}
                                                <hr/>
                                                <p class="text-right blog-detail-comment-counter">
                                                    {% if (blogCommentCount > 1 and blogCommentCount > commentsPerListPage) %}
                                                        <small><strong>{{ currentListPage }}</strong> - <strong>{{ commentsPerListPage }}</strong> {{ 'detail.commentCountBefore'|trans|sw_sanitize }} <strong>{{ blogCommentCount }}</strong> {{ 'detail.commentCountAfter'|trans({'%count%': blogCommentCount })|sw_sanitize }}</small>
                                                    {% elseif blogCommentCount > 0 %}
                                                        <small><strong>{{ blogCommentCount }}</strong> {{ 'detail.commentCountAfter'|trans({'%count%': blogCommentCount })|sw_sanitize }}</small>
                                                    {% endif %}
                                                </p>
                                            {% endblock %}
                                        {% endblock %}

                                        {% block component_comment_list_content %}
                                            {% for comment in comments.entities %}
                                                <div class="blog-detail-comment-list-content">
                                                    {% sw_include '@Frontend/frontend/component/comment/comment-item.html.twig' %}
                                                </div>
                                            {% endfor %}
                                        {% endblock %}

                                        {% block component_comment_list_paging %}

                                            {% set totalPages = (blogCommentCount/commentsPerListPage)|round(0,'ceil') %}

                                            {% if totalPages > 1 %}
                                                {% block component_comment_list_paging_form %}
                                                    <div class="blog-detail-comment-pagination">
                                                        <form class="blog-detail-comment-pagination-form"
                                                              action="{{ path('frontend.blog.comments', { blogId: comments.blogId, parentId: comments.parentId }) }}"
                                                              method="post"
                                                              data-form-ajax-submit="true"
                                                              data-form-ajax-submit-options="{{ formAjaxSubmitOptions|json_encode }}"
                                                              data-form-ajax-pagination="true">

                                                            <input type="hidden" name="p" value="1">

                                                            <input type="hidden" name="redirectTo" value="{{ redirectTo }}">

                                                            {% if app.request.get('language') %}
                                                                <input type="hidden" name="language" value="{{ app.request.get('language') }}">
                                                            {% endif %}

                                                            {% if app.request.get('sort') %}
                                                                <input type="hidden" name="sort" value="{{ app.request.get('sort') }}">
                                                            {% endif %}

                                                                {% endfor %}
                                                            {% endif %}

                                                            {% sw_include '@Frontend/frontend/component/pagination.html.twig' with {entities: comments}  %}
                                                        </form>
                                                    </div>
                                                {% endblock %}
                                            {% endif %}
                                        {% endblock %}
                                    {% endblock %}

                                    {% if blogCommentCount <= 0 %}
                                        {% block component_comment_list_empty %}
                                            {% sw_include '@Frontend/frontend/utilities/alert.html.twig' with {
                                                type: 'info',
                                                content: 'detail.commentListEmpty'|trans|sw_sanitize
                                            } %}
                                        {% endblock %}
                                    {% endif %}
								</div>
							{% endblock %}
						</div>
					{% endblock %}
				</div>
			{% endblock %}
		</div>
	{% endblock %}
{% endblock %}
