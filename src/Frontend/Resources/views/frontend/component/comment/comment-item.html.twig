{% block component_comment_item %}
    {# @deprecated tag:v6.8.0 - Review microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
    <div class="blog-detail-comment-item"
         {% if not feature('JSON_LD_DATA') %}
         itemprop="comment"
         itemscope
         itemtype="https://schema.org/Comment"
         {% endif %}>
        {% block component_comment_item_meta_published %}
            {# @deprecated tag:v6.8.0 - Review datePublished microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
            {% if not feature('JSON_LD_DATA') %}
                <meta itemprop="datePublished" content="{{ comment.createdAt|date }}">
            {% endif %}
        {% endblock %}

        {% block component_comment_item_meta_title %}
            {# @deprecated tag:v6.8.0 - Review name microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
            {% if not feature('JSON_LD_DATA') %}
                <meta itemprop="name" content="{{ comment.title }}">
            {% endif %}
        {% endblock %}

        {% block component_comment_item_meta_lang %}
            {# @deprecated tag:v6.8.0 - Review inLanguage microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
            {% if not feature('JSON_LD_DATA') and comment.language %}
                <meta itemprop="inLanguage" content="{{ comment.language.translationCode.code }}">
            {% endif %}
        {% endblock %}

        {% block component_comment_item_meta_author %}
            {# @deprecated tag:v6.8.0 - Review author microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
            {% if not feature('JSON_LD_DATA') %}
                <div itemprop="author" itemtype="https://schema.org/Person" itemscope>
                    <meta itemprop="name" content="{{ comment.externalUser }}">
                </div>
            {% endif %}
        {% endblock %}

        {% block component_comment_item_info %}
            <div class="row blog-detail-comment-item-info">
                {% block component_comment_item_info_date %}
                    <div class="col-12 blog-detail-comment-item-date">
                        <p><small>{{ comment.createdAt|format_date('long') }} {{ comment.createdAt|format_time('short') }}</small></p>
                    </div>
                {% endblock %}

                
                {% block component_comment_item_title %}
                    <div class="col-md-auto blog-detail-comment-item-title">
                        <p class="h5"{% if comment.language %} lang="{{ comment.language.translationCode.code }}"{% endif %}>
                            {{ comment.title }}
                        </p>
                    </div>
                {% endblock %}

            </div>
        {% endblock %}

        {% block component_comment_item_content %}
            {# @deprecated tag:v6.8.0 - Review description microdata replaced by JSON-LD in json-ld-blog.html.twig. Will be removed. #}
            <p class="blog-detail-comment-item-content"
               {% if not feature('JSON_LD_DATA') %}
               itemprop="description"
               {% endif %}
               {% if comment.language %} lang="{{ comment.language.translationCode.code }}"{% endif %}>
                {{ comment.content|nl2br }}
            </p>
        {% endblock %}

    </div>
{% endblock %}
