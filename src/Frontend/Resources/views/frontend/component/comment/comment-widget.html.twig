{% block component_comment_widget %}
    <div class="sticky-top blog-detail-comment-widget">
        {% block component_comment_info_container %}
            {% block component_comment_info %}
                <div class="blog-detail-comment-info js-comment-info">
                    {% block component_comment_title %}
                        <p class="blog-detail-comment-title h5">
                            {{ 'detail.commentTitle'|trans({'%count%': blogCommentCount, '%total%': totalCommentCount })|sw_sanitize }}
                        </p>
                    {% endblock %}

                </div>
            {% endblock %}

            {% if totalCommentCount > 0 %}
                <hr>
            {% endif %}

            {% set formAjaxSubmitOptions = {
                replaceSelectors: ['.js-comment-container'],
                submitOnChange: true
            } %}

        {% endblock %}

        {% block component_comment_form_teaser %}
            <div class="blog-detail-comment-teaser js-comment-teaser">
                {% block component_comment_form_teaser_header %}
                    <p class="h4">
                        {% if not comments.userComment %}
                            {{ 'detail.commentTeaserTitle'|trans|sw_sanitize }}
                        {% else %}
                            {{ 'detail.commentExistsTeaserTitle'|trans|sw_sanitize }}
                        {% endif %}
                    </p>
                {% endblock %}

                {% block component_comment_form_teaser_text %}
                    <p>
                        {% if not page.userReview %}
                            {{ 'detail.commentTeaserText'|trans|sw_sanitize }}
                        {% else %}
                            {{ 'detail.commentExistsTeaserText'|trans|sw_sanitize }}
                        {% endif %}
                    </p>
                {% endblock %}

                {% block component_comment_form_teaser_button %}
                    <button class="btn btn-primary blog-detail-comment-teaser-btn"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target=".multi-collapse"
                            aria-expanded="false"
                            aria-controls="comment-form comment-list">
                        <span class="blog-detail-comment-teaser-show">
							{% if not comments.userComment %}
                                {{ 'detail.commentTeaserButton'|trans|sw_sanitize }}
                            {% else %}
                                {{ 'detail.commentExistsTeaserButton'|trans|sw_sanitize }}
                            {% endif %}
						</span>
                        <span class="blog-detail-comment-teaser-hide">
							{{ 'detail.commentTeaserButtonHide'|trans|sw_sanitize }}
						</span>
                    </button>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
