{% sw_extends '@Frontend/frontend/component/account/login.html.twig' %}

{% block component_account_login_header %}
    <h3 class="card-title">
        {{ 'detail.commentLoginHeader'|trans|sw_sanitize }}
    </h3>
{% endblock %}

{% block component_account_login_form_description %}
    <p class="login-form-description">
        {{ 'detail.commentLoginDescription'|trans|sw_sanitize }}
        <a href="{{ path('frontend.account.login.page') }}"
           title="{{ 'detail.commentRegisterLink'|trans|striptags }}">
            {{ 'detail.commentRegisterLink'|trans|sw_sanitize }}
        </a>
    </p>
{% endblock %}

{% block component_account_login_form_redirect %}
    <input type="hidden"
           name="redirectTo"
           value="{{ redirectTo }}">

    <input type="hidden"
           name="redirectParameters"
           value="{{ {blogId: comments.blogId, id: cmsPage.id, navigationId: contena.navigation.id}|json_encode }}">
{% endblock %}

{% block component_account_login_submit %}
    <div class="float-start">
        {{ parent() }}
    </div>
    <div class="login-cancel">
        {% block page_blog_detail_comment_form_cancel %}
            <a href="#"
               class="btn btn-outline-secondary ms-1"
               data-bs-toggle="collapse"
               data-bs-target=".multi-collapse"
               aria-expanded="false"
               aria-controls="comment-form comment-list">
                {{ 'global.default.cancel'|trans|sw_sanitize }}
            </a>
        {% endblock %}
    </div>
{% endblock %}
