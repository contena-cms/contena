{% block component_product_box_action_inner %}
    {% set id = blog.id %}
    <div class="blog-action">
        {% set isAvailable = not blog.isCloseout or (blog.stock >= blog.minPurchase) %}
        {% set displayFrom = blog.calculatedPrices.count > 1 %}
        {% set displayBuyButton = isAvailable and not displayFrom and blog.childCount <= 0 %}

        {% block component_product_box_action_buttons %}
            {% if displayBuyButton and config('core.listing.allowBuyInListing') %}
                {% block component_product_box_action_buy %}
                    {# @var blog \Contena\Core\Content\Blog\Channel\ChannelProductEntity #}
                    <form action="{{ path('frontend.checkout.line-item.add') }}"
                          method="post"
                          class="buy-widget"
                          data-add-to-cart="true">
                        {% block component_product_box_action_form %}
                            {% block component_product_box_action_buy_redirect_input %}
                                {# fallback redirect back to detail page is deactivated via js #}
                                <input type="hidden"
                                       name="redirectTo"
                                       value="frontend.detail.page">

                                <input type="hidden"
                                       name="redirectParameters"
                                       data-redirect-parameters="true"
                                       value="{{ {blogId: id}|json_encode }}">
                            {% endblock %}

                            {% block component_product_box_action_buy_info %}
                                <input type="hidden"
                                       name="lineItems[{{ id }}][id]"
                                       value="{{ id }}">
                                <input type="hidden"
                                       name="lineItems[{{ id }}][referencedId]"
                                       value="{{ id }}">
                                <input type="hidden"
                                       name="lineItems[{{ id }}][type]"
                                       value="blog">
                                <input type="hidden"
                                       name="lineItems[{{ id }}][stackable]"
                                       value="1">
                                <input type="hidden"
                                       name="lineItems[{{ id }}][removable]"
                                       value="1">
                                <input type="hidden"
                                       name="lineItems[{{ id }}][quantity]"
                                       value="{{ blog.minPurchase }}">
                            {% endblock %}

                            {% block component_product_box_action_buy_meta %}
                                <input type="hidden"
                                       name="blog-name"
                                       value="{{ blog.translated.name }}">
                            {% endblock %}

                            {% block component_product_box_action_buy_button %}
                                <div class="d-grid">
                                    <button class="btn btn-buy">
                                        {% block component_product_box_action_buy_button_label %}
                                            {# @deprecated tag:v6.8.0 - Block page_product_detail_product_buy_button_label will be removed. Use component_product_box_action_buy_button_label instead. The default content will remain. #}
                                            {% block page_product_detail_product_buy_button_label %}
                                                {{ 'listing.boxAddProduct'|trans|sw_sanitize }}
                                            {% endblock %}
                                        {% endblock %}
                                    </button>
                                </div>
                            {% endblock %}
                        {% endblock %}
                    </form>
                {% endblock %}
            {% else %}
                {% block component_product_box_action_detail %}
                    <div class="d-grid">
                        <a href="{{ seoUrl('frontend.detail.page', {blogId: id}) }}"
                           class="btn btn-light btn-detail">
                            {% block component_product_box_action_detail_label %}
                                {{ 'listing.boxProductDetails'|trans|sw_sanitize }}
                            {% endblock %}
                        </a>
                    </div>
                {% endblock %}
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
