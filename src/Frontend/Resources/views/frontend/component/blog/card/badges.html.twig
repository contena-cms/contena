{% block component_product_badges %}
    <div class="blog-badges">
        {% block component_product_badges_discount %}
            {% set price = blog.calculatedPrice %}
            {% if blog.calculatedPrices.count > 0 %}
                {% set price = blog.calculatedPrices.last %}
            {% endif %}

            {# A regulation price replaces the list price as the reference for the saving. #}
            {% set hasDiscount = (price.regulationPrice ?? price.listPrice).percentage > 0 %}
            {% set hasRange = blog.calculatedPrices.count > 1 %}

            {% set displayParent = blog.variantListingConfig.displayParent and blog.parentId === null %}
            {% if displayParent %}
                {% set displayFromVariants = displayParent and price.unitPrice !== blog.calculatedCheapestPrice.unitPrice %}
            {% endif %}

            {% if hasDiscount and not hasRange and not displayFromVariants %}
                <span class="badge bg-danger badge-discount">
                    <span class="visually-hidden">{{ 'listing.boxLabelDiscount'|trans|sw_sanitize }}</span>
                    <span aria-hidden="true">&#37;</span>
                </span>
            {% endif %}
        {% endblock %}

        {% block component_product_badges_topseller %}
            {% if blog.markAsTopseller %}
                <span class="badge bg-warning badge-topseller">{{ 'listing.boxLabelTopseller'|trans|sw_sanitize }}</span>
            {% endif %}
        {% endblock %}

        {% block component_product_badges_new %}
            {% if blog.isNew %}
                <span class="badge bg-success badge-new">{{ 'listing.boxLabelNew'|trans|sw_sanitize }}</span>
            {% endif %}
        {% endblock %}
    </div>
{% endblock %}
