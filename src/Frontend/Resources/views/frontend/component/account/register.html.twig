{% if formAction is not defined %}{% set formAction = path('frontend.account.register.save') %}{% endif %}
{% block component_account_register %}
    <div class="card register-card"><div class="card-body">
        {% if cardTitle %}<h2 class="card-title">{{ cardTitle }}</h2>{% endif %}
        <form action="{{ formAction }}" class="register-form" method="post" data-form-handler="true">
            <input type="hidden" name="redirectTo" value="{{ redirectTo }}">
            <input type="hidden" name="redirectParameters" value="{{ redirectParameters is iterable ? redirectParameters|json_encode : redirectParameters }}">
            <input type="hidden" name="errorRoute" value="{{ errorRoute ?: 'frontend.account.register.page' }}">
            <input type="hidden" name="errorParameters" value="{{ errorParameters }}">
            {% if data.get('requestedGroupId') %}<input type="hidden" name="requestedGroupId" value="{{ data.get('requestedGroupId') }}">{% endif %}

            {% block component_account_register_personal %}
                {% sw_include '@Frontend/frontend/component/account/member-personal.html.twig' with {data: data, showBirthdayField: config('core.loginRegistration.showBirthdayField')} %}
                <div class="row g-2">
                    {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {type: 'email', label: 'account.personalMailLabel'|trans|sw_sanitize, id: 'personalMail', name: 'email', value: data.get('email'), autocomplete: 'email', violationPath: '/email', validationRules: 'required,email', additionalClass: 'col-sm-6'} %}
                    {% if config('core.loginRegistration.requireEmailConfirmation') %}
                        {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {type: 'email', label: 'account.personalMailConfirmationLabel'|trans|sw_sanitize, id: 'personalMailConfirmation', name: 'emailConfirmation', value: data.get('emailConfirmation'), autocomplete: 'email', violationPath: '/emailConfirmation', validationRules: 'required,confirmation,email', additionalClass: 'col-sm-6'} %}
                    {% endif %}
                    {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {type: 'password', label: 'account.personalPasswordLabel'|trans|sw_sanitize, id: 'personalPassword', name: 'password', autocomplete: 'new-password', violationPath: '/password', validationRules: 'required,minLength', minlength: config('core.loginRegistration.passwordMinLength'), additionalClass: 'col-sm-6'} %}
                    {% if config('core.loginRegistration.requirePasswordConfirmation') %}
                        {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {type: 'password', label: 'account.personalPasswordConfirmationLabel'|trans|sw_sanitize, id: 'personalPasswordConfirmation', name: 'passwordConfirmation', autocomplete: 'new-password', violationPath: '/passwordConfirmation', validationRules: 'required,confirmation', additionalClass: 'col-sm-6'} %}
                    {% endif %}
                </div>
            {% endblock %}

            {% if config('core.loginRegistration.requireDataProtectionCheckbox') %}
                {% sw_include '@Frontend/frontend/component/form/form-checkbox.html.twig' with {label: 'general.privacyNotice'|trans|sw_sanitize, id: 'acceptedDataProtection', name: 'acceptedDataProtection', value: '1', validationRules: 'required'} %}
            {% endif %}
            <p class="register-required-info">{{ 'global.default.noteRequiredFields'|trans|sw_sanitize }}</p>
            <button type="submit" class="btn btn-primary btn-lg w-100">{{ 'account.registerSubmit'|trans|sw_sanitize }}</button>
        </form>
    </div></div>
{% endblock %}
