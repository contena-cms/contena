{% block block_product_heading %}
    {% set blogNameElement = block.slots.getSlot('left') %}
    {% set manufacturerLogoElement = block.slots.getSlot('right') %}

    {% block block_product_heading_product_name_element %}
        <div class="col blog-heading-name-container" data-cms-element-id="{{ blogNameElement.id }}">
            {% block block_product_heading_product_name_inner %}
                {% sw_include '@Frontend/frontend/element/cms-element-' ~ blogNameElement.type ~ '.html.twig' ignore missing with {
                    element: blogNameElement
                } %}
            {% endblock %}
        </div>
    {% endblock %}

    {% block block_product_heading_product_manufacturer_logo_element %}
        <div class="col-md-auto blog-heading-manufacturer-logo-container" data-cms-element-id="{{ manufacturerLogoElement.id }}">
            {% block block_product_heading_product_manufacturer_logo_inner %}
                {% sw_include '@Frontend/frontend/element/cms-element-' ~ manufacturerLogoElement.type ~ '.html.twig' ignore missing with {
                    element: manufacturerLogoElement
                } %}
            {% endblock %}
        </div>
    {% endblock %}
{% endblock %}
