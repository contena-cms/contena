{# @var blog \Contena\Core\Content\Blog\Channel\ChannelProductEntity #}

{% block layout_search_suggest %}
    <div class="search-suggest js-search-result">
        {% block layout_search_suggest_container %}

            <ul class="search-suggest-container"
                id="search-suggest-listbox"
                aria-label="{{ 'header.searchDropdownTitle'|trans|striptags }}">
                {% block layout_search_suggest_results %}
                    {% for blog in page.searchResult.entities %}
                        {% block layout_search_suggest_result_product %}
                            <li class="search-suggest-blog js-result">
                                {% block layout_search_suggest_result_link %}
                                    <a href="{{ seoUrl('frontend.detail.page', {blogId: blog.id}) }}"
                                       title="{{ blog.translated.name }}"
                                       class="search-suggest-blog-link">
                                        <div class="row align-items-center g-0">
                                            {% block layout_search_suggest_result_image %}
                                                <div class="col-auto search-suggest-blog-image-container">
                                                    {% set altAttribute = blog.cover.media.translated.alt ?: '' %}
                                                    {% set titleAttribute = altAttribute ? (blog.cover.media.translated.title ?: '') : '' %}
                                                    {% set attributes = {
                                                        class: 'search-suggest-blog-image',
                                                        title: titleAttribute
                                                    } %}

                                                    {% if blog.cover.media.url and blog.cover.media.isSpatialObject() == false %}
                                                        {% if blog.cover.media.getMediaType().getName() === 'VIDEO' %}
                                                            {% sw_include '@Frontend/frontend/utilities/video.html.twig' with {
                                                                media: blog.cover.media,
                                                                attributes: attributes
                                                            } %}
                                                        {% else %}
                                                            {% set attributes = attributes|merge({
                                                                alt: altAttribute
                                                            }) %}

                                                            {% sw_thumbnails 'search-suggest-blog-image-thumbnails' with {
                                                                media: blog.cover.media,
                                                                sizes: {
                                                                    default: '100px'
                                                                },
                                                                attributes: attributes
                                                            } %}
                                                        {% endif %}
                                                    {% else %}
                                                        {% sw_icon 'placeholder' style {
                                                            size: 'lg'
                                                        } %}
                                                    {% endif %}
                                                </div>
                                            {% endblock %}

                                            {% block layout_search_suggest_result_name %}
                                                <div class="col search-suggest-blog-name">
                                                    {{ blog.translated.name }}

                                                    {% block layout_search_suggest_result_variation %}
                                                        {% if blog.variation and config('core.listing.showVariantOptionInSearchSuggestionResult') %}
                                                            <div class="search-suggest-blog-variation">
                                                                {% for variation in blog.variation %}
                                                                    {{ variation.group }}: {{ variation.option }}
                                                                    {% if blog.variation|last != variation %}
                                                                        /
                                                                    {% endif %}
                                                                {% endfor %}
                                                            </div>
                                                        {% endif %}
                                                    {% endblock %}
                                                </div>
                                            {% endblock %}

                                            {% block layout_search_suggest_result_price %}
                                                <div class="col-auto search-suggest-blog-price">
                                                    {% set price = blog.calculatedPrice %}
                                                    {% if blog.calculatedPrices.count > 0 %}
                                                        {% set price = blog.calculatedPrices.last %}
                                                    {% endif %}

                                                    {% if blog.variantListingConfig.displayParent and blog.parentId === null %}
                                                        {% set displayFromVariants = price.unitPrice !== blog.calculatedCheapestPrice.unitPrice %}
                                                        {% set price = blog.calculatedCheapestPrice %}
                                                    {% endif %}

                                                    {% set referencePrice = price.referencePrice %}

                                                    {% if blog.calculatedPrices.count > 1 or displayFromVariants %}
                                                        {{ 'listing.listingTextFrom'|trans|sw_sanitize }}
                                                    {% endif %}
                                                    <span class="search-suggest-blog-price">
                                                        {{ price.unitPrice|currency }}
                                                    </span>

                                                    {% if price.referencePrice is not null %}
                                                        <br><small class="search-suggest-blog-reference-price">({{ price.referencePrice.price|currency }} / {{ price.referencePrice.referenceUnit }}&nbsp;{{ price.referencePrice.unitName }})</small>
                                                    {% endif %}

                                                    {% if price.regulationPrice.price is not null %}
                                                        <small class="search-suggest-blog-list-price">{{ 'general.listPricePreviously'|trans({'%price%': price.regulationPrice.price|currency }) }}</small>
                                                    {% endif %}
                                                </div>
                                            {% endblock %}
                                        </div>
                                    </a>
                                {% endblock %}
                            </li>
                        {% endblock %}
                    {% endfor %}
                {% endblock %}

                {% block layout_search_suggest_result_total %}
                    {% if page.searchResult.total == 0 %}
                        {% block layout_search_suggest_no_result %}
                            <li class="search-suggest-no-result" id="search-suggest-result-info">
                                {{ 'header.searchNoResult'|trans|sw_sanitize }}
                            </li>
                        {% endblock %}
                    {% else %}
                        {% block layout_search_suggest_result_total_result %}
                            <li class="js-result search-suggest-total">
                                <div class="row align-items-center g-0">
                                    {% block layout_search_suggest_result_total_link %}
                                        <div class="col">
                                            <a href="{{ path('frontend.search.page') }}?search={{ page.searchTerm }}"
                                               title="{{ 'header.searchAllResults'|trans|striptags }}"
                                               aria-label="{{ 'header.searchAllResults'|trans|striptags }}"
                                               class="search-suggest-total-link">
                                                {% sw_icon 'arrow-head-right' style { size: 'sm' } %}
                                                {{ 'header.searchAllResults'|trans|sw_sanitize }}
                                            </a>
                                        </div>
                                    {% endblock %}

                                    {% block layout_search_suggest_result_total_count %}
                                        {# duplicate id is fine in this case, because
                                            the other use is in different if branch #}
                                        {# ludtwig-ignore html-duplicate-id #}
                                        <div class="col-auto search-suggest-total-count" id="search-suggest-result-info">
                                            {{ 'header.searchResults'|trans({
                                                '%count%': page.searchResult.total,
                                            })|sw_sanitize }}
                                        </div>
                                    {% endblock %}
                                </div>
                            </li>
                        {% endblock %}
                    {% endif %}
                {% endblock %}
            </ul>
        {% endblock %}
    </div>
{% endblock %}
