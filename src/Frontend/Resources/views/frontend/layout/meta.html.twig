{% block layout_head_inner %}
    {% set metaInformation = page.metaInformation %}
    {% set basicConfig = config('core.basicInformation') %}
    {% set maxLength = 255 %}
    {% set metaDescription = metaInformation.metaDescription|striptags|trim|u.truncate(maxLength, '…') %}
    {% set metaTitle = metaInformation.metaTitle|striptags|trim %}
    {% set metaKeywords = metaInformation.metaKeywords|striptags|trim %}
    {% set metaAuthor = (metaInformation.author != '') ? metaInformation.author : config('core.basicInformation.metaAuthor') %}
    {% set importmapData = import_map() %}

    <head>
        {% block layout_head_meta_tags %}
            {% block layout_head_meta_tags_charset %}
                <meta charset="utf-8">
            {% endblock %}

            {% block layout_head_meta_tags_viewport %}
                <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
            {% endblock %}

            {% block layout_head_meta_tags_general %}
                <meta name="author" content="{% block layout_head_meta_tags_general_author %}{{ metaAuthor|striptags }}{% endblock %}">
                <meta name="robots" content="{% block layout_head_meta_tags_robots %}{{ metaInformation.robots }}{% endblock %}">
                <meta name="revisit-after" content="{% block layout_head_meta_tags_general_revisit %}{{ metaInformation.revisit|striptags }}{% endblock %}">
                <meta name="keywords" content="{% block layout_head_meta_tags_keywords %}{{ metaKeywords }}{% endblock %}">
                <meta name="description" content="{% block layout_head_meta_tags_description %}{{ metaDescription }}{% endblock %}">
            {% endblock %}

            {% block layout_head_meta_tags_opengraph %}
                {% if not page.isErrorPage() is defined or page.isErrorPage() === false %}
                    <meta property="og:url" content="{% block layout_head_meta_tags_url_og %}{{ page.metaInformation.canonical ?: app.request.uri }}{% endblock %}">
                    <meta property="og:type" content="{% block layout_head_meta_tags_type_og %}website{% endblock %}">
                    <meta property="og:site_name" content="{% block layout_head_meta_tags_sitename_og %}{{ basicConfig.siteName }}{% endblock %}">
                    <meta property="og:title" content="{% block layout_head_meta_tags_title_og %}{{ metaTitle }}{% endblock %}">
                    <meta property="og:description" content="{% block layout_head_meta_tags_description_og %}{{ metaDescription }}{% endblock %}">
                    <meta property="og:image" content="{% block layout_head_meta_tags_image_og %}{{ theme_config('ct-logo-desktop') }}{% endblock %}">

                    <meta name="twitter:card" content="{% block layout_head_meta_tags_card_twitter %}summary{% endblock %}">
                    <meta name="twitter:site" content="{% block layout_head_meta_tags_sitename_twitter %}{{ basicConfig.siteName }}{% endblock %}">
                    <meta name="twitter:title" content="{% block layout_head_meta_tags_title_twitter %}{{ metaTitle }}{% endblock %}">
                    <meta name="twitter:description" content="{% block layout_head_meta_tags_description_twitter %}{{ metaDescription }}{% endblock %}">
                    <meta name="twitter:image" content="{% block layout_head_meta_tags_image_twitter %}{{ theme_config('ct-logo-desktop') }}{% endblock %}">
                {% endif %}
            {% endblock %}

            {% block layout_head_meta_tags_theme %}
                {% if theme_config('ct-background-color') %}
                    <meta name="theme-color" content="{{ theme_config('ct-background-color') }}">
                {% endif %}
            {% endblock %}

            {% block layout_head_meta_tags_hreflangs %}
                {% for link in hrefLang %}
                    <link rel="alternate" hreflang="{{ link.locale }}" href="{{ link.url }}">
                {% endfor %}
            {% endblock %}
        {% endblock %}

        {% block layout_head_json_ld_global %}
            {% sw_include '@Frontend/frontend/layout/structured-data/json-ld-website.html.twig' %}
            {% sw_include '@Frontend/frontend/layout/structured-data/json-ld-organization.html.twig' %}
        {% endblock %}

        {% block layout_head_json_ld %}
            {% sw_include '@Frontend/frontend/layout/structured-data/json-ld-webpage.html.twig' %}
            {% sw_include '@Frontend/frontend/layout/structured-data/json-ld-breadcrumb.html.twig' with {
                breadcrumbItems: page.breadcrumb
            } only %}
        {% endblock %}

        {% block layout_head_favicon %}
            <link rel="icon" href="{{ theme_config('ct-logo-favicon') }}">
        {% endblock %}

        {% block layout_head_apple %}
            {% if theme_config('ct-logo-share') %}
                <link rel="apple-touch-icon" href="{{ theme_config('ct-logo-share') }}">
            {% endif %}
        {% endblock %}

        {% block layout_head_canonical %}
            {% if page.metaInformation.canonical %}
                <link rel="canonical" href="{{ page.metaInformation.canonical }}">
            {% endif %}
        {% endblock %}

        {% block layout_head_title %}
            <title>{% block layout_head_title_inner %}{{- metaTitle -}}{% endblock %}</title>
        {% endblock %}

        {% block layout_head_theme_css_vars %}
            {%- set themeCssVars = theme_css_vars() -%}
            {%- if themeCssVars is not empty -%}
                <style>
                    :root {
                    {%- for key, value in themeCssVars -%}
                        --{{ key|raw }}: {{ value|raw }};
                    {%- endfor -%}
                    }
                </style>
            {%- endif -%}
        {% endblock %}

        {% block layout_head_stylesheet %}
            {% set componentStyles = importmapData.styles ?? [] %}
            {# In dev-server mode, all styles are served by the import map. #}
            {% set assets = (importmapData.isDevServer ?? false) ? [] : (theme_config('assets.css') ?? []) %}
            {% for file in assets %}
                <link rel="stylesheet" href="{{ asset(file, 'theme') }}">
            {% endfor %}
            {% for url in componentStyles %}
                <link rel="stylesheet" href="{{ url }}">
            {% endfor %}
        {% endblock %}

        {# ludtwig-ignore twig-json-encode-escape-js #}
        {% block layout_head_javascript_importmap %}
            {% set importmapImports = importmapData.imports ?? {} %}
            {% set importmapScopes = importmapData.scopes ?? {} %}

            {% if importmapImports is not empty %}
                <script type="importmap">
                    {
                        "imports": {{ importmapImports|json_encode|raw }}{% if importmapScopes is not empty %},
                        "scopes": {{ importmapScopes|json_encode|raw }}{% endif %}
                    }
                </script>
            {% endif %}
        {% endblock %}

        {% block layout_head_javascript_contena_runtime %}
            {# Load the contena runtime module as an ES module before the frontend scripts. #}
            {% set contenaModuleUrl = importmapData.imports.contena ?? null %}
            {% if contenaModuleUrl %}
                <script type="module" src="{{ contenaModuleUrl }}"></script>
            {% endif %}
        {% endblock %}

        {% block layout_head_javascript_feature %}
            {% sw_include '@Frontend/frontend/component/feature.html.twig' %}
        {% endblock %}

        {# Block for tracking scripts which are required to be included in the `head` section of the document #}
        {% block layout_head_javascript_tracking %}
            {% sw_include '@Frontend/frontend/component/analytics.html.twig' %}
        {% endblock %}

        {% block layout_head_javascript_recaptcha %}
            {% sw_include '@Frontend/frontend/component/recaptcha.html.twig' %}
        {% endblock %}

        {% block layout_head_javascript_token %}{% endblock %}

        {% if config('core.basicInformation.useDefaultCookieConsent') %}
            {% block layout_head_javascript_cookie_state %}
                <script>
                    window.useDefaultCookieConsent = true;
                </script>
            {% endblock %}
        {% endif %}

        {% block layout_head_javascript_router %}
            {# Register all routes that will be needed in JavaScript to the window.router object #}
            <script>
                {# Navigation variables are set here instead of in navbar.html.twig because the navbar #}
                {# is ESI-cached and shared across pages, while this template is rendered per request. #}
                window.activeNavigationId = '{{ contena.navigation.id }}';
                window.activeNavigationPathIdList = JSON.parse('{{ (contena.navigation.pathIdList ?? [])|json_encode|escape('js') }}');
                window.activeRoute = '{{ activeRoute }}';
                window.activeRouteParameters = JSON.parse('{{ (app.request.attributes.get('_route_params') ?? {})|json_encode|escape('js') }}');
                window.router = {
                    'frontend.home.page': '{{ path('frontend.home.page') }}',
                    'frontend.search.page': '{{ path('frontend.search.page') }}',
                    'frontend.search.suggest': '{{ path('frontend.search.suggest') }}',
                    'frontend.cookie.offcanvas': '{{ path('frontend.cookie.offcanvas') }}',
                    'frontend.cookie.groups': '{{ path('frontend.cookie.groups') }}',
                    'frontend.cookie.consent.log': '{{ path('frontend.cookie.consent.log') }}',
                    'frontend.country.region-data': '{{ path('frontend.country.region.data') }}'
                };
                window.channelId = '{{ context.channelId }}';
                window.channelCookiePath = '{{ app.request.attributes.get('ct-channel-cookie-path') }}';
            </script>
        {% endblock %}

        {% block layout_head_javascript_breakpoints %}
            {# Register the available viewport breakpoints as window.breakpoints object #}
            <script>
                {% set breakpoint = {
                    xs: theme_config('breakpoint.xs'),
                    sm: theme_config('breakpoint.sm'),
                    md: theme_config('breakpoint.md'),
                    lg: theme_config('breakpoint.lg'),
                    xl: theme_config('breakpoint.xl'),
                    xxl: theme_config('breakpoint.xxl')
                } %}

                window.breakpoints = JSON.parse('{{ breakpoint|json_encode|escape('js') }}');
            </script>
        {% endblock %}

        {% block layout_head_javascript_assets %}
            {% set isDevServer = importmapData.isDevServer ?? false %}
            {% set devScripts = importmapData.scripts ?? [] %}

            {% if isDevServer and devScripts is not empty %}
                {% block layout_head_javascript_dev_server %}
                    {% for url in devScripts %}
                        <script type="module" src="{{ url }}"></script>
                    {% endfor %}
                {% endblock %}
            {% else %}
                {% block layout_head_javascript_prod %}
                    <script>
                        window.themeJsPublicPath = '{{ asset('js/', 'theme') }}';
                    </script>
                    {% for script in theme_scripts() %}
                        <script src="{{ asset(script, 'theme') }}" defer></script>
                    {% endfor %}
                {% endblock %}
            {% endif %}
        {% endblock %}

        {% block layout_head_form_validation_messages %}
            {% sw_include '@Frontend/frontend/utilities/form-validation-config.html.twig' %}
        {% endblock %}
    </head>
{% endblock %}
