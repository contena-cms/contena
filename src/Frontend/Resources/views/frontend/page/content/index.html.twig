{% sw_extends '@Frontend/frontend/base.html.twig' %}

{# @var page \Contena\Frontend\Page\LandingPage\LandingPage|\Contena\Frontend\Page\CategoryPage\CategoryPage #}
{% block base_head %}
    {% sw_include '@Frontend/frontend/page/content/meta.html.twig' %}
{% endblock %}

{% block base_main_inner %}
    <div class="container-main">
        {% block page_content %}
            {% block cms_breadcrumb %}
                <div class="cms-breadcrumb container">
                    {% if feature('BREADCRUMB_REWORK') %}
                        {% sw_include '@Frontend/frontend/layout/breadcrumb.html.twig' with {
                            context: context,
                            themeIconConfig: themeIconConfig,
                            breadcrumb: page.breadcrumb
                        } only %}
                    {% else %}
                        {% sw_include '@Frontend/frontend/layout/breadcrumb.html.twig' with {
                            context: context,
                            themeIconConfig: themeIconConfig,
                            categoryId: contena.navigation.id,
                        } only %}
                    {% endif %}
                </div>
            {% endblock %}

            {% block cms_content %}
                {% set cmsPage = page.landingPage ? page.landingPage.cmsPage : page.cmsPage %}
                {% set cmsPageClasses = ('cms-page ' ~ cmsPage.cssClass|striptags)|trim %}
                {% set landingPage = page.landingPage ? page.landingPage : {} %}
                <div class="{{ cmsPageClasses }}">
                    {% block page_content_blocks %}
                        {% sw_include '@Frontend/frontend/page/content/detail.html.twig' with {cmsPage: cmsPage, landingPage: landingPage} %}
                    {% endblock %}
                </div>
            {% endblock %}
        {% endblock %}
    </div>
{% endblock %}
