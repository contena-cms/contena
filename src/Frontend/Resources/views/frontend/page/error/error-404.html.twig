{% sw_extends '@Frontend/frontend/page/error/_page.html.twig' %}

{% block content %}
    <div class="container-main content-page">
        {% block not_found_error_content %}
            <div class="container mt-5 text-center">
                <img src="{{ asset('assets/illustration/404_error.svg', 'theme') }}"
                     alt="{{ 'general.404ErrorPageHeader'|trans|striptags }}"
                     class="rounded mx-auto d-block w-75">

                <h1 class="mt-5">{{ 'general.404ErrorPageHeader'|trans|sw_sanitize }}</h1>
                <p>{{ 'general.404ErrorDescription'|trans|sw_sanitize }}</p>

                {% block not_found_error_return %}
                    <a href="{{ path('frontend.home.page') }}" class="btn btn-primary">
                        {{ 'general.404ErrorReturn'|trans|sw_sanitize }}
                    </a>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
