{% sw_extends '@Frontend/frontend/layout/base.html.twig' %}

{% block base_flashbags %}
    <div class="flashbags container">
        {% for type, messages in app.flashes(['warning', 'error', 'danger']) %}
            {% if messages is not empty %}
                {% sw_include '@Frontend/frontend/utilities/alert.html.twig' with { type: type, list: messages } %}
            {% endif %}
        {% endfor %}
    </div>
{% endblock %}

{% block content %}{% endblock %}
