{% extends '@Frontend/frontend/layout/base.html.twig' %}

{% block base_head %}
    {% sw_include '@Frontend/frontend/page/search/meta.html.twig' %}
{% endblock %}

{% block title %}{{ page.metaInformation.metaTitle|default('search.metaTitle'|trans) }}{% endblock %}

{% block content %}
    {% block page_search %}
        <div class="content-page search-page">
            {% block page_search_headline %}
                <h1 class="search-headline text-center mb-4">
                    {% block page_search_headline_text %}
                        {% if page.searchTerm %}
                            {{ 'search.headline'|trans({
                                '%count%': page.listing.total,
                                '%searchTerm%': page.searchTerm,
                            }) }}
                        {% endif %}
                    {% endblock %}
                </h1>
            {% endblock %}

            {% include '@Frontend/frontend/page/search/search-pagelet.html.twig' with { page: page } %}
        </div>
    {% endblock %}
{% endblock %}
