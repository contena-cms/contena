{% extends '@Frontend/frontend/layout/base.html.twig' %}

{% block content %}
    <div class="container py-5">
        <div class="account-recover-password row justify-content-md-center">
            <div class="col-md-8 col-lg-6">
                <form method="post"
                      class="account-recover-password-form card"
                      action="{{ path('frontend.account.recover.request') }}"
                      data-form-handler="true">
                    <h1 class="card-title">{{ 'account.profileRecoverPasswordTitle'|trans }}</h1>
                    <div class="card-body">
                        <div class="card-text account-recover-password-info mb-3">
                            {{ 'account.profileRecoverPasswordInfo'|trans }}
                        </div>
                        {% sw_include '@Frontend/frontend/component/form/form-input.html.twig' with {
                            type: 'email',
                            label: 'account.profileCurrentMail'|trans|sw_sanitize,
                            id: 'recoverMail',
                            name: 'email[email]',
                            autocomplete: 'section-personal email',
                            violationPath: '/email',
                            validationRules: 'required,email',
                        } %}
                        <div class="account-recover-password-form-actions">
                            <a href="{{ seoUrl('frontend.account.login.page') }}" class="btn btn-outline-secondary">
                                {{ 'general.back'|trans }}
                            </a>
                            <button type="submit" class="btn btn-primary">
                                {{ 'account.profileRecoverPasswordSubmit'|trans }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
