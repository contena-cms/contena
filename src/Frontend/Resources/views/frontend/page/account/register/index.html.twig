        <h1 class="mb-4">{{ 'account.loginRegistrationHeader'|trans|sw_sanitize }}</h1>
        {% sw_include '@Frontend/frontend/component/account/register.html.twig' with {cardTitle: 'account.registerPersonalHeader'|trans|sw_sanitize} %}
