{# ludtwig-ignore-file #}
{# @internal #}

{% props
    totalCount = 0,
    currentSorting = null,
    filterAggregations = [],
    availableSortings = [],
    filterOrder = [],
    showLayoutSwitch = true,
    visibleFilterCount = 3,
    slots = [],
    displayType = 'dropdown',
%}

{% set offcanvasId = 'filter-offcanvas-' ~ random() %}

{% set filterPanelOptions = {
    visibleFilterCount: visibleFilterCount,
} %}

{% set panelCVA = cva({
    base: 'ct-filter-panel container',
    variants: {
        displayType: {
            dropdown: 'is--dropdown',
            collapse: 'is--collapse',
        },
    },
}) %}

{% set defaultAttributes = {
    class: panelCVA.apply({ displayType }),
    'data-component': 'Ct:Filter:Panel',
    'data-component-options': filterPanelOptions|json_encode,
} %}

{% set filters = {} %}

<div {{ attributes.defaults(defaultAttributes) }}>

    {# Filter template for outer block scope. #}
    {% set filterTemplate %}
        {% block filters %}
            {# Rendering filters in order #}
            {% for filter in filterOrder %}
                {{ filters[filter] }}
            {% endfor %}
        {% endblock %}
    {% endset %}

    <twig:Ct:Content:Offcanvas :id="offcanvasId" title="{{ 'listing.filterTitle'|trans|sw_sanitize }}">
        <div class="ct-filter-panel__filter">

            <twig:Slot name="additional-filters-start"></twig:Slot>

            {{ filterTemplate }}

            <twig:Slot name="additional-filters-end"></twig:Slot>

            {# Expand or collapse hidden filters #}
            {% if filterAggregations|length > visibleFilterCount %}
                <twig:Ct:Button
                    variant="filter"
                    class="ct-filter-panel__expand d-none d-md-block"
                >
                    <span class="ct-filter-panel__expand-text">{{ 'listing.filterButtonMore'|trans|sw_sanitize }}</span>
                    <span class="ct-filter-panel__collapse-text">{{ 'listing.filterButtonLess'|trans|sw_sanitize }}</span>
                    <twig:Ct:Icon name="sliders-horizontal" size="xs" />
                </twig:Ct:Button>
            {% endif %}
        </div>
    </twig:Ct:Content:Offcanvas>

    {# Offcanvas filter button for mobile #}
    <twig:Ct:Button
        variant="filter"
        class="d-block d-md-none"
        aria-controls="{{ offcanvasId }}"
        data-bs-toggle="offcanvas"
        data-bs-target="#{{ offcanvasId }}">
        {{ 'listing.filterTitle'|trans|sw_sanitize }} <twig:Ct:Icon name="sliders-horizontal" size="xs" />
    </twig:Ct:Button>

    {% block actions %}
        <div class="ct-filter-panel__actions">
            <span class="ct-filter-panel__counter text-light-emphasis text-nowrap d-none d-lg-inline-block">
                {{ 'listing.resultCount'|trans({ '%count%': totalCount })|sw_sanitize }}
            </span>

            {% if availableSortings and availableSortings.elements and availableSortings.elements|length > 0 %}
                <twig:Ct:Filter:Sorting :currentSorting="currentSorting" :sortings="availableSortings.elements" />
            {% endif %}

            {% if showLayoutSwitch %}
                <twig:Ct:Filter:LayoutSwitch />
            {% endif %}
        </div>
    {% endblock %}
</div>
