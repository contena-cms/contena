{# ludtwig-ignore-file #}
{# @internal #}

{% props
    listing = null,
    showSorting = true,
    showLayoutSwitch = true,
    slots = [],
    limit = null,
    page = null,
%}

{% set totalCount = listing.total ?? 0 %}
{% set currentSorting = listing.sorting %}
{% set availableSortings = listing.availableSortings %}

{% set listingCVA = cva({
    base: 'ct-blog-listing',
}) %}

{% set attributeDefaults = {
    class: listingCVA.apply({}),
    'data-component': 'Ct:Blog:Listing',
} %}

{% set listingLayout = app.request.get('listingLayout') %}

<div {{ attributes.defaults(attributeDefaults) }}>

    {% block actions %}
        <twig:Ct:Grid:Container>
            <div class="ct-blog-listing__actions">
                <span class="ct-blog-listing__counter text-light-emphasis text-nowrap d-none d-lg-inline-block">
                    {{ 'listing.resultCount'|trans({ '%count%': totalCount })|sw_sanitize }}
                </span>

                {% if showSorting and availableSortings and availableSortings.elements and availableSortings.elements|length > 0 %}
                    <twig:Ct:Blog:Sorting :currentSorting="currentSorting" :sortings="availableSortings.elements" />
                {% endif %}

                {% if showLayoutSwitch %}
                    <twig:Ct:Blog:LayoutSwitch />
                {% endif %}
            </div>
        </twig:Ct:Grid:Container>
    {% endblock %}

    {% block content %}
        {% if listing.total > 0 %}
            <twig:Slot name="blog-grid">
                <twig:Ct:Grid:Container
                    class="ct-blog-listing__grid"
                    :margin="{ xs: '0 0 24px 0', sm: '0 0 24px 0', md: '0 0 24px 0', lg: '0 0 24px 0', xl: '0 0 24px 0', xxl: '0 0 24px 0' }"
                    :columns="listingLayout == 'horizontal' ? '1' : { xs: '1', sm: '2', md: '3', lg: '4', xl: '4' }"
                    gap="16">
                    {% for blog in listing.entities.elements %}
                        <twig:Ct:Blog:Card
                            :blog="blog"
                            :layout="listingLayout ? listingLayout : 'default'"
                        />
                    {% endfor %}
                </twig:Ct:Grid:Container>
            </twig:Slot>
        {% else %}
            <twig:Ct:Grid:Container class="ct-blog-listing__grid">
                <twig:Ct:Alert variant="info">
                    {{ 'listing.emptyResultMessage'|trans|sw_sanitize }}
                </twig:Ct:Alert>
            </twig:Ct:Grid:Container>
        {% endif %}
    {% endblock %}

    {% block pagination %}
        <twig:Slot name="pagination">
            <twig:Ct:Grid:Container>
                <twig:Ct:Content:Pagination
                    class="ct-blog-listing__pagination"
                    :page="listing.page"
                    :total="listing.total"
                    :limit="listing.limit"
                    :scope="listing.entity"
                />
            </twig:Ct:Grid:Container>
        </twig:Slot>
    {% endblock %}

</div>
