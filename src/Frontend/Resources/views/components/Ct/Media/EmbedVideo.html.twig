{# ludtwig-ignore-file #}
{# @internal #}

{#
    Shared structure/layout for embedded third-party videos (YouTube, Vimeo, …).
    Platform components (Ct:Media:Youtube, Ct:Media:Vimeo) build the embed URL and
    delegate rendering to this component.
#}

{% props
    videoUrl = null,
    videoTitle = null,
    previewMedia = null,
    needsConfirmation = false,
    cookieName = null,
    platform = null,
    allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share',
%}

{% set attributeDefaults = {
    class: 'ct-media ct-media-embed-video',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block video %}
        {% if videoUrl is empty %}
            <div class="ct-media-embed-video__empty">
                <twig:Ct:Icon name="video-camera" size="2x" />
            </div>
        {% elseif needsConfirmation %}
            {% set jsOptions = {
                videoUrl: videoUrl,
                videoTitle: videoTitle,
                cookieName: cookieName,
                allow: allow,
            } %}

            <div
                class="ct-media-embed-video__consent"
                data-component="Ct:Media:EmbedVideo"
                data-component-options="{{ jsOptions|json_encode }}"
            >
                {% if previewMedia %}
                    <twig:Ct:Media:Image :media="previewMedia" class="ct-media-embed-video__poster" />
                {% endif %}

                <div class="ct-media-embed-video__backdrop">
                    <div class="ct-media-embed-video__notice">
                        <p class="ct-media-embed-video__notice-text">
                            {% set privacyPageId = config('core.basicInformation.privacyPage') %}
                            {{ 'component.cms.vimeo.privacyNoticeText'|trans({
                                '%url%': privacyPageId is not empty ? path('frontend.landing.page', { landingPageId: privacyPageId }) : '#',
                                '%platform%': platform,
                            })|raw }}
                        </p>

                        <button type="button" class="ct-media-embed-video__accept btn btn-outline-secondary">
                            {{ 'component.cms.vimeo.acceptButtonLabel'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        {% else %}
            <iframe
                class="ct-media-embed-video__video"
                src="{{ videoUrl }}"
                title="{{ videoTitle }}"
                allow="{{ allow }}"
                allowfullscreen="allowfullscreen"
            ></iframe>
        {% endif %}
    {% endblock %}
</div>
