{% props
    isMember = context.member,
    loginRoute = path('frontend.account.login.page'),
    logoutRoute = path('frontend.account.logout.page'),
    accountHeadline = 'account.myAccount'|trans|sw_sanitize,
    accountMenuItems = [],
%}

{% set attributeDefaults = {
    class: 'ct-account-widget dropdown',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    <twig:CT:Header:Widget
        icon="avatar"
        data-bs-toggle="dropdown"
        data-bs-auto-close="outside"
        aria-expanded="false"
    >
    </twig:CT:Header:Widget>

    {% if isMember %}
        {% set accountMenuItems = accountMenuItems|default([
            { label: 'Overview', path: path('frontend.account.home.page') },
            { label: 'Your Profile', path: path('frontend.account.profile.page') },
            { label: 'Addresses', path: path('frontend.account.address.page') },
        ], true) %}
        <ul class="ct-account-widget__dropdown dropdown-menu dropdown-menu-end">

            <li><h6 class="dropdown-header">{{ accountHeadline }}</h6></li>

            {% for menuItem in accountMenuItems %}
                <li class="ct-account-widget__dropdown-item">
                    <a
                        class="ct-account-widget__dropdown-link dropdown-item"
                        href="{{ menuItem.path|striptags }}"
                    >
                        {{ menuItem.label|sw_sanitize }}
                    </a>
                </li>
            {% endfor %}

            <li class="ct-account-widget__dropdown-item"><hr class="dropdown-divider"></li>
            <li class="ct-account-widget__dropdown-item">
                <a
                    class="ct-account-widget__dropdown-link dropdown-item fw-semibold"
                    href="{{ logoutRoute }}"
                >
                    <twig:CT:Icon name="log-out" size="xs" />
                    {{- 'account.logout'|trans|sw_sanitize }}
                </a>
            </li>
        </ul>
    {% else %}
        <div class="dropdown-menu dropdown-menu-end">
            <h6 class="dropdown-header">{{ accountHeadline }}</h6>
            <div class="py-1 px-3">
                <a
                    href="{{ loginRoute }}"
                    class="btn btn-primary w-100"
                >
                    {{ 'account.loginSubmit'|trans|sw_sanitize }}
                </a>
                <div class="py-2 text-center">
                    {{ 'account.orRegister'|trans|sw_sanitize }}
                    <a
                        href="{{ loginRoute }}">
                        {{ 'account.orRegisterLink'|trans|striptags|lower }}
                    </a>
                </div>
            </div>
        </div>
    {% endif %}
</div>
