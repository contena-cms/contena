{# ludtwig-ignore-file #}
{# @internal #}

{% props
    name,
    id = name,
    label = null,
    options = [],
    value = null,
    description = null,
    disabled = false,
    validationRules = null,
    violationPath = null,
    required = validationRules is not empty and 'required' in validationRules,
    formViolations = formViolations|default(null),
    isInvalid = violationPath is not empty and formViolations is not null and formViolations.getViolations(violationPath)|length > 0,
%}

{% set feedbackId = "#{id}-feedback" %}
{% set descriptionId = "#{id}-description" %}
{% set describedBy = description is not empty ? "#{descriptionId} #{feedbackId}" : feedbackId %}

{% set clientValidationRules = required and 'required' not in validationRules|default('')
    ? (validationRules is empty ? 'required' : "required,#{validationRules}")
    : validationRules %}

{% set groupCVA = cva({
    base: 'ct-form-radio-group ct-form-field form-radio-group mb-3',
}) %}

{% set attributeDefaults = {
    class: groupCVA.apply({}),
    'data-violation-path': violationPath is not null ? violationPath : false,
} %}

<fieldset {{ attributes.defaults(attributeDefaults) }}>
    {% block label %}
        <twig:CT:Form:FieldsetLabel
            :label="label"
            :required="required"
            class="ct-form-radio-group__legend fs-5 fw-bold"
        />
    {% endblock %}

    {% block description %}
        <twig:CT:Form:Description
            :id="descriptionId"
            :description="description"
        />
    {% endblock %}

    {% block content %}
        {% for option in options %}
            <twig:CT:Form:Radio
                :name="name"
                :value="option.value"
                :id="option.id|default(null)"
                :label="option.label"
                :checked="option.checked|default(option.value == value)"
                :disabled="disabled or option.disabled|default(false)"
                aria-describedby="{{ describedBy }}"
                :validationRules="clientValidationRules"
                :isInvalid="isInvalid"
            />
        {% endfor %}
    {% endblock %}

    {% block feedback %}
        <twig:CT:Form:Feedback
            :id="feedbackId"
            :violationPath="violationPath"
            :formViolations="formViolations"
            :hasViolations="isInvalid"
        />
    {% endblock %}
</fieldset>
