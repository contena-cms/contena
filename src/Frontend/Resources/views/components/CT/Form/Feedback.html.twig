{# ludtwig-ignore-file #}
{# @internal #}

{% props
    id = null,
    violationPath = null,
    formViolations = formViolations|default(null),
    hasViolations = violationPath is not empty and formViolations is not null and formViolations.getViolations(violationPath)|length > 0,
%}

{% set feedbackCVA = cva({
    base: 'ct-form-feedback form-field-feedback',
}) %}

{% set attributeDefaults = {
    class: feedbackCVA.apply({}),
    id: id is not null ? id : false,
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    {% block violations %}
        {% if hasViolations and violationPath is not empty %}
            {% for violation in formViolations.getViolations(violationPath) %}
                {% set snippetName = violation.messageTemplate starts with 'VIOLATION::'
                    ? "error.#{violation.messageTemplate}"
                    : "error.#{violation.code}" %}

                {% set fieldName = violation.propertyPath|split('/')|last|trim('/', 'left')|capitalize %}

                {% set violationParams = { '%field%': fieldName }|merge(violation.parameters|default({})) %}

                <div class="ct-form-feedback__message invalid-feedback">
                    {{ snippetName|trans(violationParams)|sw_sanitize }}
                </div>
            {% endfor %}
        {% endif %}
    {% endblock %}

    {% block content %}{% endblock %}
</div>
