{# ludtwig-ignore-file #}
{# @internal #}

{% props
    navigationTree = [],
    navigationLevel = 1,
    navigationMaxDepth = context.channel.navigationCategoryDepth,
    expandAll = false,
    activeId = contena.navigation.id,
    activePath = contena.navigation.pathIdList,
%}

{% set treeItemsCVA = cva({
    base: 'ct-navigation-tree-items nav flex-column',
    variants: {
        root: {
            true: ['is--root'],
            false: null,
        },
    },
}) %}

{% set attributeDefaults = {
    class: treeItemsCVA.apply({ root: navigationLevel == 1 }),
    style: '--ct-navigation-tree-items-level: ' ~ navigationLevel ~ ';',
} %}

<ul {{ attributes.defaults(attributeDefaults) }}>
    {% for treeItem in navigationTree %}
        {% set category = treeItem.category %}
        {% set isActive = category.id is same as(activeId) %}
        {% set isInPath = category.id in activePath %}
        {% set onActivePath = isActive or isInPath %}

        {# NavigationRoute loads the active path beyond the requested depth on purpose, so the limit
           must not reach it — clipping it would drop the item carrying aria-current. #}
        {% set showChildren = treeItem.children|length > 0
            and (onActivePath or (expandAll and navigationLevel < navigationMaxDepth)) %}

        <li class="ct-navigation-tree-items__item">
            {% if category.seoUrl %}
                <a
                    class="ct-navigation-tree-items__link nav-link{% if isActive %} active{% endif %}{% if isInPath %} is--in-path{% endif %}"
                    href="{{ category.seoUrl }}"
                    {% if isActive %}aria-current="page"{% endif %}
                    {% if category.shouldOpenInNewTab %}target="_blank"{% endif %}
                >
                    {{ category.translated.name }}
                </a>
            {% else %}
                <span class="ct-navigation-tree-items__folder nav-link">
                    {{ category.translated.name }}
                </span>
            {% endif %}

            {% if showChildren %}
                <twig:CT:Navigation:TreeItems
                    :navigationTree="treeItem.children"
                    :navigationLevel="navigationLevel + 1"
                    :navigationMaxDepth="navigationMaxDepth"
                    :expandAll="expandAll"
                    :activeId="activeId"
                    :activePath="activePath"
                />
            {% endif %}
        </li>
    {% endfor %}
</ul>
