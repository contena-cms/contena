{
    "title": "CT/Navigation/Tree",
    "parameters": {
        "server": {
            "id": "CT:Navigation:Tree"
        },
        "template": "<twig:CT:Navigation:Tree :navigationTree=\"navigationTree\"></twig:CT:Navigation:Tree>"
    },
    "argTypes": {
        "navigationTree": {
            "control": "object",
            "description": "Navigation tree as Contena\\Core\\Content\\Category\\Tree\\Tree or a list of TreeItem structs.",
            "required": true,
            "type": "Tree|TreeItem[]",
            "table": {
                "readonly": true
            }
        },
        "navigationMaxDepth": {
            "control": "number",
            "description": "Number of tree levels that are rendered.",
            "table": {
                "defaultValue": {
                    "summary": "channel.navigationCategoryDepth"
                }
            }
        },
        "expandAll": {
            "control": "boolean",
            "description": "Render all children instead of only the branch containing the active category.",
            "table": {
                "defaultValue": {
                    "summary": false
                }
            }
        },
        "activeId": {
            "control": "text",
            "description": "Category ID marked as the current page.",
            "table": {
                "defaultValue": {
                    "summary": "contena.navigation.id"
                }
            }
        },
        "activePath": {
            "control": "object",
            "description": "Ancestor category IDs of the active category.",
            "table": {
                "defaultValue": {
                    "summary": "contena.navigation.pathIdList"
                }
            }
        },
        "ariaLabel": {
            "control": "text",
            "description": "Accessible label of the nav landmark.",
            "table": {
                "defaultValue": {
                    "summary": "general.categories"
                }
            }
        }
    },
    "stories": [
        {
            "name": "Tree",
            "args": {
                "navigationTree": [],
                "expandAll": false
            }
        }
    ]
}
