{# ludtwig-ignore-file #}
{# @internal #}

{% props
    id = 'ct-modal-' ~ random(),
    title = 'Modal title',
    setTitleFromAjaxContent = false,
    backdrop = 'true',
    closeLabel = 'global.default.close'|trans|sw_sanitize,
    ajaxUrl = null,
    size = 'lg',
    scrollable = false,
    verticallyCentered = false,
    animation = true,
    fullscreen = false,
%}

{% set modalCVA = cva({
    base: 'ct-modal modal',
    variants: {
        size: {
            default: null,
            sm: 'modal-sm',
            lg: 'modal-lg',
            xl: 'modal-xl',
        },
        animation: {
            false: null,
            true: ['fade']
        },
    }
}) %}

{% set modalDialogCVA = cva({
    base: 'ct-modal__dialog modal-dialog',
    variants: {
        scrollable: {
            false: null,
            true: ['modal-dialog-scrollable']
        },
        verticallyCentered: {
            false: null,
            true: ['modal-dialog-centered']
        },
        fullscreen: {
            true: 'modal-fullscreen',
            'sm-down': 'modal-fullscreen-sm-down',
            'md-down': 'modal-fullscreen-md-down',
            'lg-down': 'modal-fullscreen-lg-down',
            'xl-down': 'modal-fullscreen-xl-down',
            'xxl-down': 'modal-fullscreen-xxl-down',
        },
    }
}) %}

{% set options = {
    ajaxUrl: ajaxUrl,
    setTitleFromAjaxContent: setTitleFromAjaxContent,
} %}

{% set defaultAttributes = {
    id: id,
    tabindex: '-1',
    'aria-labelledby': id ~ '-title',
    'aria-hidden': 'true',
    'data-bs-backdrop': backdrop,
    'data-component': 'CT:Content:Modal',
    'data-component-options': options|json_encode,
} %}

<div class="{{ modalCVA.apply({ size, animation }, attributes.render('class')) }}" {{ attributes.defaults(defaultAttributes) }}>
    <div class="{{ modalDialogCVA.apply({ scrollable, verticallyCentered, fullscreen }, attributes.render('class')) }}">
        <div class="ct-modal__content modal-content">
            {% block modal_content %}
                <div class="ct-modal__header modal-header">
                    {% block header %}
                        <h2 class="ct-modal__title modal-title" id="{{ id }}-title">
                            {{ title|raw }}
                        </h2>
                        <button
                            type="button"
                            class="ct-modal__close btn-close"
                            data-bs-dismiss="modal"
                            aria-label="{{ closeLabel }}"
                        ></button>
                    {% endblock %}
                </div>

                <div class="ct-modal__body modal-body">
                    {% block content %}{% endblock %}
                </div>

                {% if block('footer') is not empty %}
                    <div class="ct-modal__footer modal-footer">
                        {% block footer %}{% endblock %}
                    </div>
                {% endif %}
            {% endblock %}
        </div>
    </div>
</div>
