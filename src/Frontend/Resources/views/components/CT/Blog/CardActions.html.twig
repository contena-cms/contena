{# ludtwig-ignore-file #}
{# @internal #}

{% props
    blog,
    horizontal = false,
%}

{% set attributeDefaults = {
    class: 'ct-blog-card-actions' ~ (not horizontal ? ' d-grid' : ''),
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    <twig:Slot name="top"></twig:Slot>

    <a href="{{ seoUrl('frontend.blog.detail.page', {blogId: blog.id}) }}"
       class="btn btn-light btn-detail">
        {% block component_blog_card_action_detail_label %}
            {{ 'listing.boxBlogDetails'|trans|sw_sanitize }}
        {% endblock %}
    </a>

    <twig:Slot name="bottom"></twig:Slot>
</div>
