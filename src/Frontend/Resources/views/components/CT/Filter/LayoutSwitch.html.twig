{# ludtwig-ignore-file #}
{# @internal #}

{% set attributeDefaults = {
    class: 'ct-layout-switch btn-group',
    'data-component': 'CT:Filter:LayoutSwitch',
} %}

<div {{ attributes.defaults(attributeDefaults) }}>
    <twig:CT:Button
        class="ct-layout-switch__horizontal"
        title="{{ 'listing.layoutSwitchList'|trans|sw_sanitize }}"
        data-layout="horizontal"
        variant="light"
    >
        <twig:CT:Icon name="view-normal" size="xs" />
    </twig:CT:Button>

    <twig:CT:Button
        class="ct-layout-switch__default"
        title="{{ 'listing.layoutSwitchGrid'|trans|sw_sanitize }}"
        data-layout="default"
        variant="light"
    >
        <twig:CT:Icon name="view-grid" size="xs" />
    </twig:CT:Button>
</div>
