{% block sw_cms_element_product_box %}
<div
    v-if="blog"
    class="sw-cms-el-blog-box"
    :class="`box-${element.config.boxLayout.value}`"
>

    {% block sw_cms_element_product_box_content %}
    <div
        class="sw-cms-el-blog-box__content"
        :style="verticalAlignStyle"
    >

        {% block sw_cms_element_product_box_badges %}
        <div class="sw-cms-el-blog-box__badges">
            <div
                v-if="blog.hasPseudoPrice"
                class="sw-cms-el-blog-box__badge-discount"
            >
                &#37;
            </div>
            <div
                v-if="blog.markAsTopseller"
                class="sw-cms-el-blog-box__badge-topseller"
            >
                {{ $t('sw-cms.elements.blogBox.component.label.badgeTopseller') }}
            </div>
            <div
                v-if="blog.newProduct"
                class="sw-cms-el-blog-box__badge-new"
            >
                {{ $t('sw-cms.elements.blogBox.component.label.badgeNew') }}
            </div>
        </div>
        {% endblock %}

        {% block sw_cms_element_product_box_media %}
        <div class="sw-cms-el-blog-box__media">
            <a
                href="#"
                :title="placeholder(blog, 'name')"
                class="sw-cms-el-blog-box__image-link"
            >
                <img
                    class="sw-cms-el-blog-box__image"
                    :class="displayModeClass"
                    :src="mediaUrl"
                    :alt="altTag"
                >
            </a>
        </div>
        {% endblock %}

        {% block sw_cms_element_product_box_info_skeleton %}
        <div
            v-if="displaySkeleton"
            class="sw-cms-el-blog-box__info"
        >

            {% block sw_cms_element_product_box_name_skeleton %}
            <div class="sw-cms-el-blog-box__skeleton-name"></div>
            {% endblock %}

            {% block sw_cms_element_product_box_description_skeleton %}
            <div class="sw-cms-el-blog-box__skeleton-description"></div>
            <div class="sw-cms-el-blog-box__skeleton-description"></div>
            <div class="sw-cms-el-blog-box__skeleton-description"></div>
            {% endblock %}

            {% block sw_cms_element_product_box_price_skeleton %}
            <div class="sw-cms-el-blog-box__skeleton-price"></div>
            {% endblock %}

            {% block sw_cms_element_product_box_actions_skeleton %}
            <div class="sw-cms-el-blog-box__actions">
                <a
                    href="#"
                    class="sw-cms-el-blog-box__buy-action"
                >
                    {{ $t('sw-cms.elements.blogBox.component.label.actionBuy') }}
                </a>
            </div>
            {% endblock %}

        </div>
        {% endblock %}

        {% block sw_cms_element_product_box_info %}
        <div
            v-else
            class="sw-cms-el-blog-box__info"
        >

            {% block sw_cms_element_product_box_name %}
            <a
                href="#"
                class="sw-cms-el-blog-box__name"
                :title="placeholder(blog, 'name')"
            >
                {{ placeholder(blog, 'name', blog.name) }}
            </a>
            {% endblock %}

            {% block sw_cms_element_product_box_description %}
            <div
                v-if="element.config.boxLayout.value === 'standard'"
                class="sw-cms-el-blog-box__description"
            >
                {{ truncateFilter(placeholder(blog, 'description', blog.description), 200, true, '...') }}
            </div>
            {% endblock %}

            {% block sw_cms_element_product_box_price_info %}
            <div class="sw-cms-el-blog-box__price-info">

                {% block sw_cms_element_product_box_price_unit %}
                <div
                    v-if="blog.purchaseUnit && blog.purchaseUnit !== 0"
                    class="sw-cms-el-blog-box__price-unit"
                >
                    <span class="sw-cms-el-blog-box__price-unit-label">{{ $t('sw-cms.elements.blogBox.component.label.priceUnitContent') }} </span>
                    <span class="sw-cms-el-blog-box__price-unit-content">{{ blog.purchaseUnit }} {{ blog.packUnit }}</span><br>

                    <span
                        v-if="blog.purchaseUnit && blog.referenceUnit && blog.purchaseUnit !== blog.referenceUnit"
                        class="sw-cms-el-blog-box__price-unit-reference"
                    >
                        ({{ currencyFilter(blog.price[0].gross * blog.referenceUnit / blog.purchaseUnit, 'EUR') }}
                        * / {{ blog.referenceUnit }} {{ blog.packUnit }})
                    </span>
                </div>
                {% endblock %}

                {% block sw_cms_element_product_box_price %}
                <div class="sw-cms-el-blog-box__price">
                    {{ currencyFilter(blog.price[0].gross, 'EUR') }}
                </div>
                {% endblock %}

            </div>
            {% endblock %}

            {% block sw_cms_element_product_box_actions %}
            <div class="sw-cms-el-blog-box__actions">
                <a
                    href="#"
                    class="sw-cms-el-blog-box__buy-action"
                >
                    {{ $t('sw-cms.elements.blogBox.component.label.actionBuy') }}
                </a>
            </div>
            {% endblock %}

        </div>
        {% endblock %}

    </div>
    {% endblock %}

</div>
{% endblock %}
