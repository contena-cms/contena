{% block sw_cms_element_product_slider_config %}
<div class="sw-cms-el-config-blog-slider">
    {% block sw_cms_element_product_slider_config_tabs %}
    <template v-if="feature.isActive('v6.8.0.0')">
        {% block sw_cms_element_product_slider_config_mt_tabs %}
        <mt-tabs
            position-identifier="sw-cms-element-config-blog-slider"
            class="sw-cms-el-config-blog-slider__tabs"
            :default-item="activeTab"
            :items="tabs"
            :use-routes-for-extensions="false"
            :small="true"
            @new-item-active="activeTab = $event"
        />
        {% endblock %}

        {% block sw_cms_element_product_slider_config_mt_content %}
        <sw-container
            v-if="activeTab === 'content'"
            class="sw-cms-el-config-blog-slider__tab-content"
        >
            {% block sw_cms_element_product_slider_config_mt_content_title %}
            <sw-cms-inherit-wrapper
                field="title"
                :element="element"
                :label="$t('sw-cms.elements.blogSlider.config.label.title')"
            >
                <template #default="{ isInherited }">
                    <mt-text-field
                        v-model="element.config.title.value"
                        class="sw-cms-el-config-blog-slider__tab-content-title"
                        :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.title')"
                        :disabled="isInherited"
                    />
                </template>
            </sw-cms-inherit-wrapper>
            {% endblock %}

            {% block sw_cms_element_product_slider_config_mt_content_product_assignment_type %}
            <sw-cms-inherit-wrapper
                field="blogs"
                field-path="source"
                :element="element"
                :label="$t('sw-cms.elements.blogSlider.config.label.blogAssignmentType')"
                @inheritance:restore="onRestoreInheritance"
            >
                <template #default="{ isInherited }">
                    <sw-single-select
                        v-model:value="element.config.blogs.source"
                        class="sw-cms-el-config-blog-slider__tab-content-blog-assignment-type-select"
                        :options="blogAssignmentTypes"
                        :disabled="isInherited"
                        show-clearable-button
                        @update:value="onChangeAssignmentType"
                    />
                </template>
            </sw-cms-inherit-wrapper>
            {% endblock %}

            <template v-if="element.config.blogs.source === 'blog_stream'">
                {% block sw_cms_element_product_slider_config_mt_content_blog_stream_select %}
                <sw-cms-inherit-wrapper
                    field="blogs"
                    :element="element"
                    :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamChoice')"
                    @inheritance:restore="onRestoreInheritance"
                >
                    <template #default="{ isInherited }">
                        <sw-entity-single-select
                            v-model:value="element.config.blogs.value"
                            entity="blog_stream"
                            :criteria="blogStreamCriteria"
                            class="sw-cms-el-config-blog-slider__tab-content-blog-stream-select"
                            :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.blogStreamChoice')"
                            :disabled="isInherited"
                            show-clearable-button
                            @update:value="onChangeProductStream"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}

                {% block sw_cms_element_product_slider_config_mt_content_blog_stream_performance_hint %}
                <mt-banner
                    class="sw-cms-el-config-blog-slider__tab-content-blog-stream-performance-hint"
                    variant="info"
                >
                    {{ $t('sw-cms.elements.blogSlider.config.textProductStreamPerformanceHint') }}
                </mt-banner>
                {% endblock %}

                <sw-blog-stream-modal-preview
                    v-if="showProductStreamPreview"
                    :filters="blogStream.apiFilter"
                    :default-limit="element.config.blogStreamLimit.value"
                    :default-sorting="element.config.blogStreamSorting.value"
                    @modal-close="onCloseProductStreamModal"
                />

                <sw-container
                    columns="1fr 1fr"
                    gap="30px"
                >
                    {% block sw_cms_element_product_slider_config_mt_content_blog_stream_sorting %}
                    <sw-cms-inherit-wrapper
                        field="blogStreamSorting"
                        :element="element"
                        :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamSorting')"
                    >
                        <template #default="{ isInherited }">
                            <sw-single-select
                                v-model:value="element.config.blogStreamSorting.value"
                                class="sw-cms-el-config-blog-slider__tab-content-blog-stream-sorting"
                                :options="blogStreamSortingOptions"
                                :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.blogStreamSorting')"
                                :disabled="isInherited || !blogStream"
                                show-clearable-button
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}

                    {% block sw_cms_element_product_slider_config_mt_content_blog_stream_limit %}
                    <sw-cms-inherit-wrapper
                        field="blogStreamLimit"
                        :element="element"
                        :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamLimit')"
                    >
                        <template #default="{ isInherited }">
                            <mt-number-field
                                v-model="element.config.blogStreamLimit.value"
                                class="sw-cms-el-config-blog-slider__tab-content-blog-stream-limit"
                                :disabled="isInherited || !blogStream"
                                :min="1"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}
                </sw-container>

                {% block sw_cms_element_product_slider_config_mt_content_blog_stream_preview_link %}
                <div class="sw-cms-el-config-blog-slider__product-stream-preview-link-container">
                    <a
                        class="sw-cms-el-config-blog-slider__product-stream-preview-link link"
                        :class="{ 'is--disabled': !blogStream }"
                        href="#"
                        @click.prevent="onClickProductStreamPreview"
                    >
                        {{ $t('sw-cms.elements.blogSlider.config.textProductStreamPreviewLink') }}
                        <mt-icon
                            name="regular-long-arrow-right"
                            size="16px"
                        />
                    </a>
                </div>
                {% endblock %}
            </template>

            {% block sw_cms_element_product_slider_config_mt_content_products %}
            <sw-cms-inherit-wrapper
                v-else
                field="blogs"
                :element="element"
                :label="$t('sw-cms.elements.blogSlider.config.label.selection')"
                @inheritance:restore="onRestoreInheritance"
            >
                <template #default="{ isInherited }">
                    <sw-entity-multi-select
                        v-model:entity-collection="blogCollection"
                        class="sw-cms-el-config-blog-slider__tab-content-blogs"
                        :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.selection')"
                        :context="blogMultiSelectContext"
                        :criteria="blogMediaFilter"
                        :disabled="isInherited"
                        @update:entity-collection="onProductsChange"
                    >
                        <template #selection-label-property="{ item }">
                            <sw-blog-variant-info :variations="item.variation">
                                {{ item.translated.name || item.name }}
                            </sw-blog-variant-info>
                        </template>
                        <template #result-item="{ item, index }">
                            <slot
                                name="result-item"
                                v-bind="{ item, index }"
                            >
                                <sw-select-result v-bind="{ item, index, selected: isSelected(item.id)}">
                                    {% block sw_cms_element_product_slider_config_mt_entity_single_select_base_results_list_result_label %}
                                    <span class="sw-select-result__result-item-text">
                                        <sw-blog-variant-info :variations="item.variation">
                                            {{ item.translated.name || item.name }}
                                        </sw-blog-variant-info>
                                    </span>
                                    {% endblock %}
                                </sw-select-result>
                            </slot>
                        </template>
                    </sw-entity-multi-select>
                </template>
            </sw-cms-inherit-wrapper>

            {% endblock %}
        </sw-container>
        {% endblock %}

        {% block sw_cms_element_product_slider_config_mt_settings %}
        <sw-container
            v-if="activeTab === 'settings'"
            class="sw-cms-el-config-blog-slider__tab-settings"
        >
            <div class="sw-cms-el-config-blog-slider__tab-settings-display">
                {% block sw_cms_element_product_slider_config_mt_settings_display_mode %}
                <sw-cms-inherit-wrapper
                    field="displayMode"
                    :element="element"
                    :label="$t('sw-cms.elements.general.config.label.displayMode')"
                >
                    <template #default="{ isInherited }">
                        <mt-select
                            v-model="element.config.displayMode.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-display-mode"
                            :help-text="$t('sw-cms.elements.blogSlider.config.helpText.displayMode')"
                            :options="displayModeOptions"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}
            </div>

            <div class="sw-cms-el-config-blog-slider__tab-settings-alignment has--two-elements">
                {% block sw_cms_element_product_slider_config_mt_settings_min_width %}
                <sw-cms-inherit-wrapper
                    field="elMinWidth"
                    :element="element"
                    :label="$t('sw-cms.elements.blogSlider.config.label.minWidth')"
                >
                    <template #default="{ isInherited }">
                        <mt-text-field
                            v-model="element.config.elMinWidth.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-alignment-min-width"
                            :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.minWidth')"
                            :help-text="$t('sw-cms.elements.blogSlider.config.helpText.minWidth')"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}

                {% block sw_cms_element_product_slider_config_mt_settings_vertical_align %}
                <sw-cms-inherit-wrapper
                    field="verticalAlign"
                    :element="element"
                    :label="$t('sw-cms.elements.general.config.label.verticalAlign')"
                >
                    <template #default="{ isInherited }">
                        <mt-select
                            v-model="element.config.verticalAlign.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-alignment-vertical"
                            :placeholder="$t('sw-cms.elements.general.config.label.verticalAlign')"
                            :options="alignmentOptions"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}
            </div>

            <div class="sw-cms-el-config-blog-slider__tab-settings-layout has--two-elements">
                {% block sw_cms_element_product_slider_config_mt_settings_box_layout %}
                <sw-cms-inherit-wrapper
                    field="boxLayout"
                    :element="element"
                    :label="$t('sw-cms.elements.blogBox.config.label.layoutType')"
                >
                    <template #default="{ isInherited }">
                        <mt-select
                            v-model="element.config.boxLayout.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-layout-type"
                            :options="boxLayoutOptions"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}

                {% block sw_cms_element_product_slider_config_mt_settings_border %}
                <sw-cms-inherit-wrapper
                    field="border"
                    :element="element"
                >
                    <template #default="{ isInherited }">
                        <mt-switch
                            v-model="element.config.border.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-layout-border"
                            :label="$t('sw-cms.elements.blogSlider.config.label.border')"
                            :disabled="isInherited"
                            bordered
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}
            </div>

            <div class="sw-cms-el-config-blog-slider__tab-settings-navigation">
                {% block sw_cms_element_product_slider_config_mt_settings_navigation_arrows %}
                <sw-cms-inherit-wrapper
                    field="navigationArrows"
                    :element="element"
                >
                    <template #default="{ isInherited }">
                        <mt-select
                            v-model="element.config.navigationArrows.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-navigation-arrows"
                            :label="$t('sw-cms.elements.blogSlider.config.label.navigationArrows')"
                            :options="arrowOptions"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}
            </div>

            <div class="sw-cms-el-config-blog-slider__tab-settings-speed">
                {% block sw_cms_element_product_slider_config_mt_settings_speed %}
                <sw-cms-inherit-wrapper
                    field="speed"
                    :element="element"
                    :label="$t('sw-cms.elements.general.config.label.speed')"
                >
                    <template #default="{ isInherited }">
                        <mt-number-field
                            v-model="element.config.speed.value"
                            class="sw-cms-el-config-blog-slider__tab-settings-speed"
                            number-type="int"
                            :min="0"
                            :max="3600000"
                            :placeholder="$t('sw-cms.elements.general.config.label.speed')"
                            :help-text="$t('sw-cms.elements.general.config.helpText.speed')"
                            :disabled="isInherited"
                        />
                    </template>
                </sw-cms-inherit-wrapper>
                {% endblock %}
            </div>

            <mt-banner
                class="sw-cms-el-config-blog-slider__tab-settings-rotate"
                variant="attention"
                :title="$t('sw-cms.elements.general.config.infoText.autoSlideTitle')"
            >
                <p class="sw-cms-el-config-blog-slider__tab-settings-rotate-attention">
                    {{ $t('sw-cms.elements.general.config.infoText.autoSlide') }}
                </p>

                <div class="sw-cms-el-config-blog-slider__tab-settings-rotate-config has--two-elements">
                    {% block sw_cms_element_product_slider_config_mt_settings_rotate %}
                    <sw-cms-inherit-wrapper
                        field="rotate"
                        :element="element"
                    >
                        <template #default="{ isInherited }">
                            <mt-switch
                                v-model="element.config.rotate.value"
                                class="sw-cms-el-config-blog-slider__tab-settings-rotate-switch"
                                :label="$t('sw-cms.elements.general.config.label.autoSlide')"
                                :disabled="isInherited"
                                bordered
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}

                    {% block sw_cms_element_product_slider_config_mt_settings_autoplay_timeout %}
                    <sw-cms-inherit-wrapper
                        field="autoplayTimeout"
                        :element="element"
                        :label="$t('sw-cms.elements.general.config.label.autoplayTimeout')"
                    >
                        <template #default="{ isInherited }">
                            <mt-number-field
                                v-model="element.config.autoplayTimeout.value"
                                class="sw-cms-el-config-blog-slider__tab-settings-rotate-autoplay"
                                number-type="int"
                                :min="0"
                                :max="3600000"
                                :placeholder="$t('sw-cms.elements.general.config.label.autoplayTimeout')"
                                :help-text="$t('sw-cms.elements.general.config.helpText.autoplayTimeout')"
                                :disabled="isInherited"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                    {% endblock %}
                </div>
            </mt-banner>
        </sw-container>
        {% endblock %}
    </template>

    <template v-else>
        <sw-tabs
            position-identifier="sw-cms-element-config-blog-slider"
            class="sw-cms-el-config-blog-slider__tabs"
            default-item="content"
        >
            <template #default="{ active }">
            {% block sw_cms_element_product_slider_config_tab_content %}
                <sw-tabs-item
                    :title="$t('sw-cms.elements.general.config.tab.content')"
                    name="content"
                    :active-tab="active"
                >
                    {{ $t('sw-cms.elements.general.config.tab.content') }}
                </sw-tabs-item>
            {% endblock %}
            {% block sw_cms_element_product_slider_config_tab_options %}
                <sw-tabs-item
                    :title="$t('sw-cms.elements.general.config.tab.settings')"
                    name="settings"
                    :active-tab="active"
                >
                    {{ $t('sw-cms.elements.general.config.tab.settings') }}
                </sw-tabs-item>
            {% endblock %}
            </template>

            <template #content="{ active }">
            {% block sw_cms_element_product_slider_config_content %}
                <sw-container
                    v-if="active === 'content'"
                    class="sw-cms-el-config-blog-slider__tab-content"
                >
                {% block sw_cms_element_product_slider_config_content_title %}
                    <sw-cms-inherit-wrapper
                        field="title"
                        :element="element"
                        :label="$t('sw-cms.elements.blogSlider.config.label.title')"
                    >
                        <template #default="{ isInherited }">
                            <mt-text-field
                                v-model="element.config.title.value"
                                class="sw-cms-el-config-blog-slider__tab-content-title"
                                :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.title')"
                                :disabled="isInherited"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                {% endblock %}

                {% block sw_cms_element_product_slider_config_content_product_assignment_type %}
                    <sw-cms-inherit-wrapper
                        field="blogs"
                        field-path="source"
                        :element="element"
                        :label="$t('sw-cms.elements.blogSlider.config.label.blogAssignmentType')"
                        @inheritance:restore="onRestoreInheritance"
                    >
                        <template #default="{ isInherited }">
                            <sw-single-select
                                v-model:value="element.config.blogs.source"
                                class="sw-cms-el-config-blog-slider__tab-content-blog-assignment-type-select"
                                :options="blogAssignmentTypes"
                                :disabled="isInherited"
                                show-clearable-button
                                @update:value="onChangeAssignmentType"
                            />
                        </template>
                    </sw-cms-inherit-wrapper>
                {% endblock %}

                    <template v-if="element.config.blogs.source === 'blog_stream'">
                    {% block sw_cms_element_product_slider_config_content_blog_stream_select %}
                        <sw-cms-inherit-wrapper
                            field="blogs"
                            :element="element"
                            :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamChoice')"
                            @inheritance:restore="onRestoreInheritance"
                        >
                            <template #default="{ isInherited }">
                                <sw-entity-single-select
                                    v-model:value="element.config.blogs.value"
                                    entity="blog_stream"
                                    :criteria="blogStreamCriteria"
                                    class="sw-cms-el-config-blog-slider__tab-content-blog-stream-select"
                                    :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.blogStreamChoice')"
                                    :disabled="isInherited"
                                    show-clearable-button
                                    @update:value="onChangeProductStream"
                                />
                            </template>
                        </sw-cms-inherit-wrapper>
                    {% endblock %}

                    {% block sw_cms_element_product_slider_config_content_blog_stream_performance_hint %}
                        <mt-banner
                            class="sw-cms-el-config-blog-slider__tab-content-blog-stream-performance-hint"
                            variant="info"
                        >
                            {{ $t('sw-cms.elements.blogSlider.config.textProductStreamPerformanceHint') }}
                        </mt-banner>
                    {% endblock %}

                        <sw-blog-stream-modal-preview
                            v-if="showProductStreamPreview"
                            :filters="blogStream.apiFilter"
                            :default-limit="element.config.blogStreamLimit.value"
                            :default-sorting="element.config.blogStreamSorting.value"
                            @modal-close="onCloseProductStreamModal"
                        />

                        <sw-container
                            columns="1fr 1fr"
                            gap="30px"
                        >
                        {% block sw_cms_element_product_slider_config_content_blog_stream_sorting %}
                            <sw-cms-inherit-wrapper
                                field="blogStreamSorting"
                                :element="element"
                                :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamSorting')"
                            >
                                <template #default="{ isInherited }">
                                    <sw-single-select
                                        v-model:value="element.config.blogStreamSorting.value"
                                        class="sw-cms-el-config-blog-slider__tab-content-blog-stream-sorting"
                                        :options="blogStreamSortingOptions"
                                        :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.blogStreamSorting')"
                                        :disabled="isInherited || !blogStream"
                                        show-clearable-button
                                    />
                                </template>
                            </sw-cms-inherit-wrapper>
                        {% endblock %}

                        {% block sw_cms_element_product_slider_config_content_blog_stream_limit %}
                            <sw-cms-inherit-wrapper
                                field="blogStreamLimit"
                                :element="element"
                                :label="$t('sw-cms.elements.blogSlider.config.label.blogStreamLimit')"
                            >
                                <template #default="{ isInherited }">
                                    <mt-number-field
                                        v-model="element.config.blogStreamLimit.value"
                                        class="sw-cms-el-config-blog-slider__tab-content-blog-stream-limit"
                                        :disabled="isInherited || !blogStream"
                                        :min="1"
                                    />
                                </template>
                            </sw-cms-inherit-wrapper>
                        {% endblock %}
                        </sw-container>

                    {% block sw_cms_element_product_slider_config_content_blog_stream_preview_link %}
                        <div class="sw-cms-el-config-blog-slider__product-stream-preview-link-container">
                            <a
                                class="sw-cms-el-config-blog-slider__product-stream-preview-link link"
                                :class="{ 'is--disabled': !blogStream }"
                                href="#"
                                @click.prevent="onClickProductStreamPreview"
                            >
                                {{ $t('sw-cms.elements.blogSlider.config.textProductStreamPreviewLink') }}
                                <mt-icon
                                    name="regular-long-arrow-right"
                                    size="16px"
                                />
                            </a>
                        </div>
                    {% endblock %}
                    </template>

                {% block sw_cms_element_product_slider_config_content_products %}
                    <sw-cms-inherit-wrapper
                        v-else
                        field="blogs"
                        :element="element"
                        :label="$t('sw-cms.elements.blogSlider.config.label.selection')"
                        @inheritance:restore="onRestoreInheritance"
                    >
                        <template #default="{ isInherited }">
                            <sw-entity-multi-select
                                v-model:entity-collection="blogCollection"
                                class="sw-cms-el-config-blog-slider__tab-content-blogs"
                                :placeholder="$t('sw-cms.elements.blogSlider.config.placeholder.selection')"
                                :context="blogMultiSelectContext"
                                :criteria="blogMediaFilter"
                                :disabled="isInherited"
                                @update:entity-collection="onProductsChange"
                            >
                                {% block sw_cms_element_product_slider_config_content_products_selection_label %}
                                <template #selection-label-property="{ item }">
                                    <sw-blog-variant-info :variations="item.variation">
                                        {{ item.translated.name || item.name }}
                                    </sw-blog-variant-info>
                                </template>
                                {% endblock %}

                                {% block sw_cms_element_product_slider_config_content_products_select_result_item %}
                                <template #result-item="{ item, index }">
                                    <slot
                                        name="result-item"
                                        v-bind="{ item, index }"
                                    >
                                        <sw-select-result v-bind="{ item, index, selected: isSelected(item.id)}">
                                            {% block sw_cms_element_product_slider_config_content_products_select_result_item_inner %}
                                            {# @deprecated tag:v6.8.0 - Block will be removed. Use `sw_cms_element_product_slider_config_content_products_select_result_item_inner` instead. #}
                                            {% block sw_entity_single_select_base_results_list_result_label %}
                                            <span class="sw-select-result__result-item-text">
                                                <sw-blog-variant-info :variations="item.variation">
                                                    {{ item.translated.name || item.name }}
                                                </sw-blog-variant-info>
                                            </span>
                                            {% endblock %}
                                            {% endblock %}
                                        </sw-select-result>
                                    </slot>
                                </template>
                                {% endblock %}
                            </sw-entity-multi-select>
                        </template>
                    </sw-cms-inherit-wrapper>

                {% endblock %}
                </sw-container>
            {% endblock %}

            {% block sw_cms_element_product_slider_config_settings %}
                <sw-container
                    v-if="active === 'settings'"
                    class="sw-cms-el-config-blog-slider__tab-settings"
                >
                    <div class="sw-cms-el-config-blog-slider__tab-settings-display">
                    {% block sw_cms_element_product_slider_config_settings_display_mode %}
                        <sw-cms-inherit-wrapper
                            field="displayMode"
                            :element="element"
                            :label="$t('sw-cms.elements.general.config.label.displayMode')"
                        >
                            <template #default="{ isInherited }">
                                <mt-select
                                    v-model="element.config.displayMode.value"
                                    class="sw-cms-el-config-blog-slider__tab-settings-display-mode"
                                    :help-text="$t('sw-cms.elements.blogSlider.config.helpText.displayMode')"
                                    :options="displayModeOptions"
                                    :disabled="isInherited"
                                />
                            </template>
