{% block sw_cms_element_product_slider %}
<div
    class="sw-cms-el-blog-slider"
    :class="classes"
    :style="verticalAlignStyle"
>
    {% block sw_cms_element_product_slider_title %}
    <div
        v-if="element.config.title.value"
        class="sw-cms-el-blog-slider__title"
    >
        {{ element.config.title.value }}
    </div>
    {% endblock %}

    {% block sw_cms_element_product_slider_content %}
    <div class="sw-cms-el-blog-slider__content">
        {% block sw_cms_element_product_slider_arrow_left %}
        <div
            v-if="hasNavigationArrows"
            class="sw-cms-el-blog-slider__navigation is--left-arrow"
        >
            <mt-icon
                class="sw-cms-el-blog-slider__navigation-button"
                name="regular-chevron-left"
                size="24"
            />
        </div>
        {% endblock %}

        {% block sw_cms_element_product_slider_product_holder %}
        <div
            ref="blogHolder"
            class="sw-cms-el-blog-slider__product-holder"
            :style="sliderBoxMinWidth"
        >
            <template v-if="!element.data || !element.data.blogs">
                {% block sw_cms_element_product_slider_demo_data %}
                <sw-cms-el-blog-box
                    v-for="index in sliderBoxLimit"
                    :key="index"
                    :element="demoProductElement"
                />
                {% endblock %}
            </template>

            <template v-else>
                {% block sw_cms_element_product_slider_products %}
                <template
                    v-for="(blog, index) in element.data.blogs"
                    :key="index"
                >
                    <sw-cms-el-blog-box
                        v-if="index < sliderBoxLimit"
                        :element="getProductEl(blog)"
                    />
                </template>
                {% endblock %}
            </template>
        </div>
        {% endblock %}

        {% block sw_cms_element_product_slider_arrow_right %}
        <div
            v-if="hasNavigationArrows"
            class="sw-cms-el-blog-slider__navigation is--right-arrow"
        >
            <mt-icon
                class="sw-cms-el-blog-slider__navigation-button"
                name="regular-chevron-right"
                size="24"
            />
        </div>
        {% endblock %}
    </div>
    {% endblock %}
</div>
{% endblock %}
