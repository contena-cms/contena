{% block sw_cms_element_product_description_reviews %}
<div
    class="sw-cms-el-blog-description-comments"
    :style="alignStyle"
>
    {% block sw_cms_element_product_description_reviews_tabs %}
    <div class="sw-cms-el-blog-description-comments__tabs">
        <h2 class="sw-cms-el-blog-description-comments__description-tab">
            {{ $t('sw-cms.elements.blogDescriptionComments.preview.label.description') }}
        </h2>
        <h2 class="sw-cms-el-blog-description-comments__reviews-tab">
            {{ $t('sw-cms.elements.blogDescriptionComments.preview.label.reviews') }}
        </h2>
    </div>
    {% endblock %}

    {% block sw_cms_element_product_description_reviews_placeholder %}
    {% block sw_cms_element_product_description_reviews_placeholder_header %}
    <div
        v-if="isProductPageType && !currentDemoEntity"
        class="sw-cms-el-blog-description-comments__placeholder"
    >
        <div class="sw-cms-el-blog-description-comments__placeholder-title"></div>
        <div class="sw-cms-el-blog-description-comments__placeholder-description"></div>
        <div class="sw-cms-el-blog-description-comments__placeholder-description"></div>
        <div class="sw-cms-el-blog-description-comments__placeholder-description"></div>
    </div>
    {% endblock %}

    {% block sw_cms_element_product_description_reviews_placeholder_listing %}
    <ul
        v-if="isProductPageType && !currentDemoEntity"
        class="sw-cms-el-blog-description-comments__placeholder-listing"
    >
        <li class="sw-cms-el-blog-description-comments__placeholder-item">
            <div class="sw-cms-el-blog-description-comments__placeholder-left"></div>
            <div class="sw-cms-el-blog-description-comments__placeholder-right"></div>
        </li>
        <li class="sw-cms-el-blog-description-comments__placeholder-item">
            <div class="sw-cms-el-blog-description-comments__placeholder-left"></div>
            <div class="sw-cms-el-blog-description-comments__placeholder-right"></div>
        </li>
        <li class="sw-cms-el-blog-description-comments__placeholder-item">
            <div class="sw-cms-el-blog-description-comments__placeholder-left"></div>
            <div class="sw-cms-el-blog-description-comments__placeholder-right"></div>
        </li>
        <li class="sw-cms-el-blog-description-comments__placeholder-item">
            <div class="sw-cms-el-blog-description-comments__placeholder-left"></div>
            <div class="sw-cms-el-blog-description-comments__placeholder-right"></div>
        </li>
        <li class="sw-cms-el-blog-description-comments__placeholder-item">
            <div class="sw-cms-el-blog-description-comments__placeholder-left"></div>
            <div class="sw-cms-el-blog-description-comments__placeholder-right"></div>
        </li>
    </ul>
    {% endblock %}

    {% endblock %}

    {% block sw_cms_element_product_description_reviews_detail %}
    {% block sw_cms_element_product_description_reviews_detail_header %}
    <div
        v-if="!isProductPageType || currentDemoEntity"
        class="sw-cms-el-blog-description-comments__detail"
    >
        <h3 class="sw-cms-el-blog-description-comments__detail-title">
            {{ placeholder(blog, 'name', blog.name) }}
        </h3>
        <div class="sw-cms-el-blog-description-comments__detail-description">
            {{ placeholder(blog, 'description', blog.description) }}
        </div>
    </div>
    {% endblock %}

    {% block sw_cms_element_product_description_reviews_detail_listing %}
    <ul
        v-if="!isProductPageType || currentDemoEntity"
        class="sw-cms-el-blog-description-comments__detail-listing"
    >
        <li class="sw-cms-el-blog-description-comments__detail-item">
            <div class="sw-cms-el-blog-description-comments__detail-item-label">
                property
            </div>
            <div class="sw-cms-el-blog-description-comments__detail-item-value">
                property value
            </div>
        </li>
        <li class="sw-cms-el-blog-description-comments__detail-item">
            <div class="sw-cms-el-blog-description-comments__detail-item-label">
                property
            </div>
            <div class="sw-cms-el-blog-description-comments__detail-item-value">
                property value
            </div>
        </li>
        <li class="sw-cms-el-blog-description-comments__detail-item">
