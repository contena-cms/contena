{% block sw_first_run_wizard_contena_account %}
<div class="sw-first-run-wizard-contena-account">
    <sw-container columns="1fr 1fr">
        <img
            class="sw-first-run-wizard-contena-account__illustration"
            :src="assetFilter('/administration/administration/static/img/first-run-wizard/contena-account.svg')"
            alt=""
        >

        <div>
            <div
                v-if="accountError"
                class="sw-first-run-wizard-contena-account__error"
            >
                <mt-banner
                    :title="$t('global.default.error')"
                    variant="critical"
                >
                    {{ $t('sw-first-run-wizard.error.messageLoginDataInvalid') }}
                </mt-banner>
            </div>

            <h5 class="headline">
                {{ $t('sw-first-run-wizard.contenaAccount.headline') }}
            </h5>

            <p
                class="message"
                v-html="$t('sw-first-run-wizard.contenaAccount.message')"
            ></p>

            <p class="create-account">
                <span>{{ $t('sw-first-run-wizard.contenaAccount.registerAccountText') }}</span>

                <mt-link
                    class="external-link"
                    :to="$t('sw-first-run-wizard.contenaAccount.registerAccountUrl')"
                    variant="primary"
                    type="external"
                    target="_blank"
                >
                    {{ $t('sw-first-run-wizard.contenaAccount.registerAccountHere') }}
                </mt-link>
            </p>

            <div class="input-field-mail">
                <mt-text-field
                    v-model="contenaId"
                    name="contenaId"
                    validation="required"
                    :label="$t('sw-first-run-wizard.contenaAccount.emailAddressLabel')"
                    :placeholder="$t('sw-first-run-wizard.contenaAccount.emailAddressPlaceholder')"
                />
            </div>

            <div class="input-field-password">
                <mt-password-field
                    v-model="password"
                    :label="$t('sw-first-run-wizard.contenaAccount.passwordLabel')"
                    :placeholder="$t('sw-first-run-wizard.contenaAccount.passwordPlaceholder')"
                />
            </div>

            <p class="forgot-password">
                <mt-link
                    class="external-link"
                    :to="$t('sw-first-run-wizard.contenaAccount.forgotPasswordUrl')"
                    variant="primary"
                    type="external"
                    target="_blank"
                >
                    {{ $t('sw-first-run-wizard.contenaAccount.forgotPasswordText') }}
                </mt-link>
            </p>
        </div>
    </sw-container>
</div>
{% endblock %}
