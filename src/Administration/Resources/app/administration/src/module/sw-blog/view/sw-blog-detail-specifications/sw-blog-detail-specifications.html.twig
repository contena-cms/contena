{% block sw_product_detail_specifications %}
<div v-if="isLoading">
    <sw-skeleton />
    <sw-skeleton />
</div>

<div v-else>
    {% block sw_product_detail_specifications_measurement %}
    <mt-card
        v-if="showProductCard('measurement') && !isDigitalProduct"
        class="sw-blog-detail-specification__measurement"
        position-identifier="sw-blog-detail-specifications-measurement"
        :title="$t('sw-blog.specifications.cardTitleMeasurement')"
    >
        {% block sw_product_detail_specifications_measurement_content %}
        <sw-blog-measurement-form
            :allow-edit="acl.can('blog.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_measures_packaging %}
    <mt-card
        v-if="showProductCard('selling_packaging') && !isDigitalProduct"
        class="sw-blog-detail-specification__selling-packaging"
        position-identifier="sw-blog-detail-specifications-measures-packaging"
        :title="$t('sw-blog.specifications.cardTitleSellingPackaging')"
    >
        {% block sw_product_detail_specifications_measures_packaging_content %}
        <sw-blog-packaging-form
            :show-setting-packaging="showModeSetting"
            :allow-edit="acl.can('blog.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_property %}
    <sw-blog-properties
        v-show="showProductCard('properties')"
    />
    {% endblock %}

    {% block sw_product_detail_specifications_essential_characteristics %}
    <mt-card
        v-show="showProductCard('essential_characteristics')"
        class="sw-blog-detail-specification__essential-characteristics"
        position-identifier="sw-blog-detail-specifications-essential-characteristics"
        :title="$t('sw-blog.specifications.cardTitleEssentialCharacteristics')"
    >
        {% block sw_product_detail_specifications_essential_characteristics_content %}
        <sw-blog-feature-set-form :allow-edit="acl.can('blog.editor')" />
        {% endblock %}
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_specifications_custom_products %}
    {% endblock %}

    {% block sw_product_detail_specifications_custom_fields %}
    <mt-card
        v-show="showCustomFieldsCard"
        class="sw-blog-detail-specification__custom-fields"
        position-identifier="sw-blog-detail-specifications-custom-fields"
        :title="$t('sw-blog.specifications.cardTitleCustomFields')"
    >
        {% block sw_product_detail_specifications_custom_fields_content %}
        <sw-custom-field-set-renderer
            show-custom-field-set-selection
            :entity="blog"
            :parent-entity="parentProduct"
            :sets="customFieldSets"
            :disabled="!acl.can('blog.editor')"
        />
        {% endblock %}
    </mt-card>
    {% endblock %}
</div>
{% endblock %}
