{% block sw_product_guarantee_form %}
<div class="sw-blog-guarantee-form">
    {% block sw_product_guarantee_form_description %}
    <p>{{ $t('sw-blog.settingsForm.labelGuaranteeDescription') }}</p>
    {% endblock %}

    {% block sw_product_guarantee_form_content %}
    <sw-container
        columns="1fr 2fr"
        gap="0 var(--scale-size-30)"
    >
        {% block sw_product_guarantee_form_guarantee_months_field %}
        <sw-inherit-wrapper
            v-model:value="blog.guaranteeMonths"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.guaranteeMonths"
        >
            <template #content="props">
                <mt-number-field
                    :is-inheritance-field="props.isInheritField"
                    :is-inherited="props.isInherited"
                    number-type="int"
                    :min="guaranteeMonthsMinimum"
                    :max="guaranteeMonthsMaximum"
                    :step="guaranteeMonthsStep"
                    :allow-empty="true"
                    :error="guaranteeMonthsError"
                    :label="$t('sw-blog.settingsForm.labelGuaranteeMonths')"
                    :help-text="$t('sw-blog.settingsForm.helpTextGuaranteeMonths')"
                    :placeholder="$t('sw-blog.settingsForm.placeholderGuaranteeMonths')"
                    :disabled="props.isInherited || !allowEdit"
                    :model-value="props.currentValue"
                    @change="onGuaranteeMonthsTyped"
                    @update:model-value="value => props.updateCurrentValue(commitGuaranteeMonths(value, props.currentValue))"
                    @inheritance-restore="props.restoreInheritance"
                    @inheritance-remove="props.removeInheritance"
                />

            </template>
        </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_guarantee_form_guarantee_confirmed_field %}
        <div class="sw-blog-guarantee-form__switches">
            <sw-inherit-wrapper
                v-model:value="blog.guaranteeConfirmed"
                :has-parent="!!parentProduct.id"
                :inherited-value="parentProduct.guaranteeConfirmed"
            >
                <template #content="props">
                    <mt-switch
                        :is-inheritance-field="props.isInheritField"
                        :is-inherited="props.isInherited"
                        :inherited-value="parentProduct.guaranteeConfirmed"
                        :error="blogGuaranteeConfirmedError"
                        :label="$t('sw-blog.settingsForm.labelGuaranteeConfirmed')"
                        :help-text="$t('sw-blog.settingsForm.helpTextGuaranteeConfirmed')"
                        :disabled="!allowEdit"
                        :model-value="props.currentValue"
                        @update:model-value="props.updateCurrentValue"
                        @inheritance-restore="props.restoreInheritance"
                        @inheritance-remove="props.removeInheritance"
                    />

                </template>
            </sw-inherit-wrapper>
        </div>
        {% endblock %}
    </sw-container>
    {% endblock %}

    {% block sw_product_guarantee_form_terms %}
    <sw-container
        columns="1fr 1fr"
        gap="0 var(--scale-size-30)"
    >
        {% block sw_product_guarantee_form_guarantee_terms_media_field %}
        <sw-inherit-wrapper
            v-model:value="blog.guaranteeTermsMediaId"
            class="sw-blog-guarantee-form__terms-media"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.guaranteeTermsMediaId"
            :label="$t('sw-blog.settingsForm.labelGuaranteeTermsMedia')"
            :help-text="$t('sw-blog.settingsForm.helpTextGuaranteeTermsMedia')"
        >
            <template #content="props">
                <sw-media-field
                    file-accept="application/pdf"
                    default-folder="blog"
                    :disabled="props.isInherited || !allowEdit"
                    :value="props.currentValue"
                    @update:value="props.updateCurrentValue"
                />
            </template>
        </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_guarantee_form_guarantee_terms_url_field %}
        <sw-inherit-wrapper
            v-model:value="blog.guaranteeTermsUrl"
            class="sw-blog-guarantee-form__terms-url"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.guaranteeTermsUrl"
            :label="$t('sw-blog.settingsForm.labelGuaranteeTermsUrl')"
            :help-text="$t('sw-blog.settingsForm.helpTextGuaranteeTermsUrl')"
        >
            <template #content="props">
                <mt-url-field
                    :error="blogGuaranteeTermsUrlError"
                    :disabled="props.isInherited || !allowEdit"
                    :model-value="props.currentValue"
                    @update:model-value="value => props.updateCurrentValue(value || null)"
                />
            </template>
        </sw-inherit-wrapper>
        {% endblock %}
    </sw-container>
    {% endblock %}

    {% block sw_product_guarantee_form_requirements_notice %}
    <mt-banner
        v-if="unmetGuaranteeLabelRequirements.length > 0"
        ref="requirementsNotice"
        class="sw-blog-guarantee-form__requirements-notice"
        variant="attention"
    >
        {{ $t('sw-blog.settingsForm.noticeGuaranteeRequirements') }}

        <ul>
            <li
                v-for="requirement in unmetGuaranteeLabelRequirements"
                :key="requirement"
            >
                {{ requirement }}
            </li>
        </ul>
    </mt-banner>
    {% endblock %}
</div>
{% endblock %}
