{% block sw_product_deliverability_downloadable_form %}
<sw-container class="blog-deliverability-downloadable-form">

    {% block sw_product_deliverability_downloadable_form_delivery_time_field %}
    <sw-inherit-wrapper
        v-if="showModeSetting"
        v-model:value="blog.deliveryTimeId"
        :inherited-value="parentProduct.deliveryTimeId"
        :has-parent="!!parentProduct.id"
        :label="$t('sw-blog.settingsForm.labelDeliveryTime')"
    >
        <template #content="{ currentValue, updateCurrentValue, isInherited }">

            <sw-entity-single-select
                id="deliveryTimeId"
                :key="isInherited"
                :value="currentValue"
                entity="delivery_time"
                :disabled="isInherited || disabled"
                class="blog-deliverability-downloadable-form__delivery-time"
                :error="blogDeliveryTimeIdError"
                :placeholder="$t('sw-blog.settingsForm.placeholderDeliveryTime')"
                show-clearable-button
                @update:value="updateCurrentValue"
            />
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {% block sw_product_deliverability_downloadable_form_is_closeout_field %}
    <sw-inherit-wrapper
        v-model:value="blog.isCloseout"
        :has-parent="!!parentProduct.id"
        :inherited-value="parentProduct.isCloseout"
        @update:value="onSwitchInput"
    >
        <template #content="props">

            <mt-switch
                class="blog-deliverability-downloadable-form__manage-stock-switch"
                name="sw-field--blog-is-closeout"
                :error="blogIsCloseoutError"
                :is-inheritance-field="props.isInheritField"
                :is-inherited="props.isInherited"
                :inherited-value="parentProduct.isCloseout"
                :label="$t('sw-blog.detailBase.manageStockLabel')"
                :help-text="$t('sw-blog.detailBase.manageStockTooltip')"
                :disabled="props.isInherited || disabled"
                :model-value="props.currentValue"
                @update:model-value="props.updateCurrentValue"
                @inheritance-restore="props.restoreInheritance"
                @inheritance-remove="props.removeInheritance"
            />

        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    <sw-container
        v-show="showStockSetting"
        columns="1fr 1fr"
        gap="0 var(--scale-size-30)"
    >
        {% block sw_product_deliverability_downloadable_form_stock_field %}
        <mt-number-field
            v-model="blog.stock"
            name="sw-field--blog-stock"
            number-type="int"
            :disabled="disabled"
            :label="$t('sw-blog.settingsForm.labelStock')"
            :placeholder="$t('sw-blog.settingsForm.placeholderStock')"
            :error="blogStockError"
        />
        {% endblock %}

        {% block sw_product_deliverability_downloadable_form_available_stock_field %}
        <mt-number-field
            v-model="blog.availableStock"
            name="sw-field--blog-available-stock"
            number-type="int"
            :disabled="true"
            :label="$t('sw-blog.settingsForm.labelAvailableStock')"
        />
        {% endblock %}
    </sw-container>

    {% block sw_product_deliverability_downloadable_form_order_quantity_switch %}
    <mt-switch
        v-if="showModeSetting"
        class="blog-deliverability-downloadable-form__order-quantity-switch"
        name="sw-field--blog-allow-multiple-units"
        :label="$t('sw-blog.settingsForm.labelAllowMultipleUnits')"
        :help-text="$t('sw-blog.settingsForm.helpTextAllowMultipleUnits')"
        :disabled="disabled"
        :model-value="showOrderQuantitySetting"
        @update:model-value="onOrderQuantitySwitchInput"
    />
    {% endblock %}

    <sw-container
        v-if="showModeSetting && showOrderQuantitySetting"
        columns="1fr 1fr 1fr"
        gap="0 var(--scale-size-30)"
    >
        {% block sw_product_deliverability_downloadable_form_min_purchase_field %}
        <sw-inherit-wrapper
            v-model:value="blog.minPurchase"
            class="blog-deliverability-downloadable-form__min-purchase"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.minPurchase"
        >
            <template #content="props">

                <mt-number-field
                    :is-inheritance-field="props.isInheritField"
                    :is-inherited="props.isInherited"
                    number-type="int"
                    :min="1"
                    :error="blogMinPurchaseError"
                    :label="$t('sw-blog.settingsForm.labelMinPurchase')"
                    :placeholder="$t('sw-blog.settingsForm.placeholderMinPurchase')"
                    :disabled="props.isInherited || disabled"
                    :model-value="props.currentValue"
                    @update:model-value="props.updateCurrentValue"
                    @inheritance-restore="props.restoreInheritance"
                    @inheritance-remove="props.removeInheritance"
                />

            </template>
        </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_deliverability_downloadable_form_purchase_steps_field %}
        <sw-inherit-wrapper
            v-model:value="blog.purchaseSteps"
            class="blog-deliverability-downloadable-form__purchase-steps"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.purchaseSteps"
        >
            <template #content="props">

                <mt-number-field
                    :is-inheritance-field="props.isInheritField"
                    :is-inherited="props.isInherited"
                    number-type="int"
                    :min="1"
                    :error="blogPurchaseStepsError"
                    :label="$t('sw-blog.settingsForm.labelPurchaseSteps')"
                    :placeholder="$t('sw-blog.settingsForm.placeholderPurchaseSteps')"
                    :disabled="props.isInherited || disabled"
                    :model-value="props.currentValue"
                    @update:model-value="props.updateCurrentValue"
                    @inheritance-restore="props.restoreInheritance"
                    @inheritance-remove="props.removeInheritance"
                />

            </template>
        </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_deliverability_downloadable_form_max_purchase_field %}
        <sw-inherit-wrapper
            v-model:value="blog.maxPurchase"
            class="blog-deliverability-downloadable-form__max-purchase"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.maxPurchase"
        >
            <template #content="props">

                <mt-number-field
                    :is-inheritance-field="props.isInheritField"
                    :is-inherited="props.isInherited"
                    number-type="int"
                    :allow-empty="true"
                    :min="1"
                    :error="blogMaxPurchaseError"
                    :label="$t('sw-blog.settingsForm.labelMaxPurchase')"
                    :placeholder="$t('sw-blog.settingsForm.placeholderMaxPurchase')"
                    :help-text="$t('sw-blog.settingsForm.helpTextMaxPurchaseDigital')"
                    :disabled="props.isInherited || disabled"
                    :model-value="props.currentValue"
                    @update:model-value="props.updateCurrentValue"
                    @inheritance-restore="props.restoreInheritance"
                    @inheritance-remove="props.removeInheritance"
                />

            </template>
        </sw-inherit-wrapper>
        {% endblock %}
    </sw-container>
</sw-container>
{% endblock %}
