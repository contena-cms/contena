{% block sw_product_detail_base_feature_set_form %}
<div class="sw-blog-feature-set-form__container">
    {% block sw_product_feature_set_form_container %}

    {% block sw_product_feature_set_form_description %}
    <sw-container
        rows="auto auto"
        class="sw-blog-feature-set-form__description"
    >

        {% block sw_product_feature_set_form_description_title %}
        {% endblock %}

        {% block sw_product_feature_set_form_description_body %}
        <p class="sw-blog-feature-set-form__description-body">
            {{ $t('sw-blog.featureSets.descriptionBody') }}
        </p>
        {% endblock %}

        {% block sw_product_feature_set_form_config_information %}
        <i18n-t
            tag="p"
            keypath="sw-blog.featureSets.configInformation"
            scope="local"
            class="sw-blog-feature-set-form__description-config-info"
        >
            <span class="sw-blog-feature-set-form__description-link">
                <router-link
                    :to="{ name: 'sw.settings.blog.feature.sets.index' }"
                >
                    {{ $t('sw-blog.featureSets.linkFeatureSetsConfig') }}
                </router-link>
            </span>
        </i18n-t>
        {% endblock %}

    </sw-container>
    {% endblock %}

    {% block sw_product_feature_set_form_form %}
    <sw-container class="sw-blog-feature-set-form__form">

        {% block sw_product_feature_set_form_wrapper_input %}
        <sw-inherit-wrapper
            v-model:value="blog.featureSetId"
            :has-parent="!!parentProduct.id"
            :inherited-value="parentProduct.featureSetId"
            :label="$t('sw-blog.featureSets.templateSelectFieldLabel')"
        >
            <template #content="{ currentValue, isInherited, updateCurrentValue }">

                {% block sw_product_feature_set_form_input %}
                <sw-entity-single-select
                    :key="isInherited"
                    entity="blog_feature_set"
                    :value="currentValue"
                    :placeholder="$t('sw-blog.featureSets.templateSelectFieldPlaceholder')"
                    :disabled="isInherited || !allowEdit"
                    show-clearable-button
                    @update:value="updateCurrentValue"
                />
                {% endblock %}

            </template>
        </sw-inherit-wrapper>
        {% endblock %}

    </sw-container>
    {% endblock %}

    {% endblock %}
</div>
{% endblock %}
