{% block sw_product_detail_base %}
<div class="sw-blog-detail-base">
    <template v-if="isLoading">
        <sw-skeleton variant="detail-bold" />
        <sw-skeleton />
    </template>

    <template v-else>
        {% block sw_product_detail_base_basic_info_card %}
        <mt-card
            v-show="showProductCard('general_information')"
            class="sw-blog-detail-base__info"
            position-identifier="sw-blog-detail-base-info"
            :title="$t('sw-blog.detailBase.cardTitleProductInfo')"
        >

            {% block sw_product_detail_base_basic_info_form %}
            <sw-blog-basic-form
                :show-settings-information="showModeSetting"
                :allow-edit="acl.can('blog.editor')"
            />
            {% endblock %}

        </mt-card>
        {% endblock %}

        <mt-card
            v-if="isDownloadCardVisible"
            class="sw-blog-detail-base__downloads"
            :title="$t('sw-blog.detailBase.cardTitleDownloads')"
            :subtitle="$t('sw-blog.detailBase.cardSubtitleDownloads')"
            :is-loading="loading.blog || loading.customFieldSets || loading.downloads"
            position-identifier="sw-blog-detail-base-downloads"
        >
            <sw-blog-download-form
                v-if="mediaFormVisible"
                :blog-id="blog.id"
                :label="$t('sw-blog.detailBase.downloadsLabel')"
                :disabled="!acl.can('blog.editor')"
                :required="!isDownloadExternallyManaged"
                @media-open="onOpenDownloadMediaModal"
            />

            {% block sw_product_detail_base_download_external_management %}
            <mt-switch
                :model-value="isDownloadExternallyManaged"
                :label="$t('sw-blog.detailBase.downloadExternalManagementLabel')"
                :help-text="$t('sw-blog.detailBase.downloadExternalManagementTooltip')"
                :disabled="!acl.can('blog.editor')"
                @update:model-value="onDownloadExternalManagementChange"
            />
            {% endblock %}
        </mt-card>

        {% block sw_product_detail_base_price_card %}
        <mt-card
            v-show="showProductCard('prices')"
            class="sw-blog-detail-base__prices"
            position-identifier="sw-blog-detail-base-prices"
            :title="$t('sw-blog.detailBase.cardTitlePrices')"
            :is-loading="loading.blog"
        >

            {% block sw_product_detail_base_price_form %}
            <sw-blog-price-form :allow-edit="acl.can('blog.editor')" />
            {% endblock %}

            {% block sw_product_detail_base_advanced_prices_link %}
            <sw-container
                v-if="blogId"
                columns="1fr"
                justify="end"
            >

                <router-link
                    :to="{ name: 'sw.blog.detail.prices', params: { id: $route.params.id } }"
                    class="sw-card__quick-link"
                >
                    {{ $t('sw-blog.detailBase.linkAdvancedPrices') }}
                    <mt-icon
                        name="regular-long-arrow-right"
                        size="var(--scale-size-16)"
                    />
                </router-link>
            </sw-container>
            {% endblock %}

        </mt-card>
        {% endblock %}

        <template v-if="isDownloadCardVisible">
            {% block sw_product_detail_deliverability_downloadable_info_card %}
            <mt-card
                v-show="showProductCard('deliverability')"
                class="sw-blog-detail-base__deliverability-downloadable"
                position-identifier="sw-blog-detail-base-deliverability-downloadable"
                :title="$t('sw-blog.detailBase.cardTitleDeliverabilityInfo')"
            >
                {% block sw_product_detail_deliverability_downloadable_info_form %}
                <sw-blog-deliverability-downloadable-form :disabled="!acl.can('blog.editor')" />
                {% endblock %}
            </mt-card>
            {% endblock %}
        </template>

        <template v-else>
            {% block sw_product_detail_deliverability_info_card %}
            <mt-card
                v-show="showProductCard('deliverability')"
                class="sw-blog-detail-base__deliverability"
                position-identifier="sw-blog-detail-base-deliverability"
                :title="$t('sw-blog.detailBase.cardTitleDeliverabilityInfo')"
            >
                {% block sw_product_detail_deliverability_info_form %}
                <sw-blog-deliverability-form :allow-edit="acl.can('blog.editor')" />
                {% endblock %}
            </mt-card>
            {% endblock %}
        </template>

        {% block sw_product_detail_base_category_card %}
        <mt-card
            v-show="showProductCard('visibility_structure')"
            class="sw-blog-detail-base__visibility-structure"
            position-identifier="sw-blog-detail-base-visibility-structure"
            :title="$t('sw-blog.detailBase.cardTitleAssignment')"
            :is-loading="loading.blog"
        >

            {% block sw_product_detail_base_category_form %}
            <sw-blog-category-form :allow-edit="acl.can('blog.editor')" />
            {% endblock %}

        </mt-card>
        {% endblock %}

        {% block sw_product_detail_base_media %}
        <sw-inherit-wrapper
            v-show="showProductCard('media')"
            ref="blogMediaInheritance"
            v-model:value="blog.media"
            class="sw-blog-detail-base__media"
            :inherited-value="parentProduct.media"
            :custom-restore-inheritance-function="mediaRestoreInheritanceFunction"
            :custom-remove-inheritance-function="mediaRemoveInheritanceFunction"
            is-association
        >
            <template #content="{ isInherited, isInheritField, restoreInheritance, removeInheritance }">

                {% block sw_product_detail_base_media_card %}
                <mt-card
                    :title="$t('sw-blog.detailBase.cardTitleMedia')"
                    :subtitle="$t('sw-blog.detailBase.cardSubtitleMedia')"
                    :is-loading="loading.blog || loading.customFieldSets || loading.media"
                    :class="{ 'sw-card__inherited': isInherited }"
                    position-identifier="sw-blog-detail-base-media"
                >
                    <template #title>

                        {% block sw_product_detail_base_media_card_title %}
                        <div
                            class="sw-inherit-wrapper__card-title"
                            :class="{ 'sw-inherit-wrapper__card-title--inherited': isInherited }"
                        >
                            <sw-inheritance-switch
                                v-if="isInheritField"
                                class="sw-inherit-wrapper__inheritance-icon"
                                :is-inherited="isInherited"
                                @inheritance-restore="restoreInheritance"
                                @inheritance-remove="removeInheritance"
                            />
                            {# TODO: headline is not clickable yet #}
                            <h3 class="mt-card__title">
                                {{ $t('sw-blog.detailBase.cardTitleMedia') }}
                            </h3>
                        </div>
                        {% endblock %}

                    </template>

                    {% block sw_product_detail_base_media_card_form %}
                    <sw-blog-media-form
                        v-if="mediaFormVisible"
                        :key="isInherited"
                        :blog-id="isInherited ? parentProduct.id : blog.id"
                        :is-inherited="isInherited"
                        :disabled="isInherited || !acl.can('blog.editor')"
                        @media-open="onOpenMediaModal"
                    />
                    {% endblock %}

                </mt-card>
                {% endblock %}

            </template>
        </sw-inherit-wrapper>
        {% endblock %}

        {% block sw_product_detail_base_media_modal %}
        <sw-media-modal-v2
            v-if="showMediaModal"
            :initial-folder-id="mediaDefaultFolderId"
            :entity-context="blog.getEntityName()"
            file-accept="image/*,video/*,model/gltf-binary"
            @media-modal-selection-change="onAddMedia"
            @modal-close="onCloseMediaModal"
        />
        {% endblock %}

        {% block sw_product_detail_base_settings_card %}
        <mt-card
            v-show="showProductCard('labelling')"
            class="sw-blog-detail-base__labelling-card"
            position-identifier="sw-blog-detail-base-labelling"
            :title="$t('sw-blog.detailBase.cardTitleSettings')"
            :is-loading="loading.blog"
        >

            {% block sw_product_detail_base_settings_form %}
            <sw-blog-settings-form :allow-edit="acl.can('blog.editor')" />
            {% endblock %}

        </mt-card>
        {% endblock %}

        {% block sw_product_detail_base_guarantee_card %}
        <mt-card
            v-show="showProductCard('labelling')"
            class="sw-blog-detail-base__guarantee-card"
            position-identifier="sw-blog-detail-base-guarantee"
            :title="$t('sw-blog.detailBase.cardTitleGuarantee')"
            :is-loading="loading.blog"
        >

            {% block sw_product_detail_base_guarantee_form %}
            <sw-blog-guarantee-form :allow-edit="acl.can('blog.editor')" />
            {% endblock %}

        </mt-card>
        {% endblock %}

    </template>
</div>
{% endblock %}
