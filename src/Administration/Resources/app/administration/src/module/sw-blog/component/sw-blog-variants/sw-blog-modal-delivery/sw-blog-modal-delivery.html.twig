{% block sw_product_modal_delivery %}
<sw-modal
    :title="$t('sw-blog.variations.deliveryModal.modalHeadline')"
    class="sw-blog-modal-delivery"
    :is-loading="isLoading"
    @modal-close="$emit('modal-close')"
>

    {% block sw_product_modal_delivery_sidebar %}
    <div class="sw-blog-modal-delivery__sidebar">
        {% block sw_product_modal_delivery_sidebar_tabs %}
        <template v-if="feature.isActive('v6.8.0.0')">
            {% block sw_product_modal_delivery_sidebar_mt_tabs %}
            <mt-tabs
                vertical
                position-identifier="sw-blog-modal-delivery"
                :default-item="activeTab"
                :items="deliveryTabs"
                :small="true"
                @new-item-active="activeTab = $event"
            />
            {% endblock %}
        </template>

        <template v-else>
            <sw-tabs
                is-vertical
                position-identifier="sw-blog-modal-delivery"
            >
                {% block sw_product_modal_delivery_sidebar_tabs_items %}
                <sw-tabs-item
                    :active="activeTab == 'order'"
                    @click="activeTab = 'order'"
                >
                    {{ $t('sw-blog.variations.deliveryModal.order') }}
                </sw-tabs-item>
                <sw-tabs-item
                    :active="activeTab == 'media'"
                    @click="activeTab = 'media'"
                >
                    {{ $t('sw-blog.variations.deliveryModal.media') }}
                </sw-tabs-item>
                <sw-tabs-item
                    :active="activeTab == 'listing'"
                    @click="activeTab = 'listing'"
                >
                    {{ $t('sw-blog.variations.deliveryModal.listing') }}
                </sw-tabs-item>
                {% endblock %}
            </sw-tabs>
        </template>
        {% endblock %}

        {% block sw_product_modal_delivery_sidebar_descriptions %}
        <p v-if="activeTab == 'order'">
            {{ $t('sw-blog.variations.deliveryModal.orderExplanation') }}
        </p>
        <p v-if="activeTab == 'media'">
            {{ $t('sw-blog.variations.deliveryModal.mediaExplanation') }}
        </p>
        <p v-if="activeTab == 'listing'">
            {{ $t('sw-blog.variations.deliveryModal.listingExplanation') }}
        </p>
        {% endblock %}
    </div>
    {% endblock %}

    {% block sw_product_modal_delivery_main %}
    <div class="sw-blog-modal-delivery__main">
        {% block sw_product_modal_delivery_main_order %}
        <sw-blog-variants-delivery-order
            v-if="activeTab == 'order'"
            :blog="blog"
            :selected-groups="selectedGroups"
        />
        {% endblock %}

        {% block sw_product_modal_delivery_media %}
        <sw-blog-variants-delivery-media
            v-if="activeTab == 'media'"
            :blog="blog"
            :selected-groups="selectedGroups"
        />
        {% endblock %}

        {% block sw_product_modal_delivery_listing %}
        <sw-blog-variants-delivery-listing
            v-if="activeTab == 'listing'"
            :blog="blog"
            :selected-groups="selectedGroups"
        />
        {% endblock %}
    </div>
    {% endblock %}

    {% block sw_product_modal_delivery_footer %}
    <template #modal-footer>
        {% block sw_product_modal_delivery_footer_button_cancel %}
        <mt-button
            size="small"
            variant="secondary"
            @click="cancelDeliveryConfiguration"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_product_modal_delivery_footer_button_save %}
        <mt-button
            v-tooltip="{
                message: $t('sw-privileges.tooltip.warning'),
                disabled: acl.can('blog.editor'),
                showOnDisabledElements: true
            }"
            class="sw-blog-modal-delivery__save-button"
            :disabled="!acl.can('blog.editor')"
            variant="primary"
            size="small"
            @click="saveDeliveryConfiguration"
        >
            {{ $t('global.default.save') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

</sw-modal>
{% endblock %}
