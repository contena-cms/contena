{% block sw_product_detail %}
<sw-page class="sw-blog-detail">

    {% block sw_product_detail_header %}
    <template #smart-bar-header>
        <h2>
            <sw-blog-variant-info
                :variations="blog.variation"
                :title-term="blogTitle"
            >
                {{ blogTitle }}
            </sw-blog-variant-info>
        </h2>
    </template>
    {% endblock %}

    {% block sw_product_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_product_detail_actions_abort %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            :disabled="isLoading"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        <sw-button-group
            v-tooltip.bottom="{
                message: $t('sw-privileges.tooltip.warning'),
                disabled: acl.can('blog.editor'),
                showOnDisabledElements: true
            }"
            class="sw-blog-detail__save-button-group"
            :split-button="true"
        >
            {% block sw_product_detail_actions_save %}
            <sw-button-process
                v-tooltip.bottom="tooltipSave"
                class="sw-blog-detail__save-action"
                :is-loading="isLoading"
                :process-success="isSaveSuccessful"
                variant="primary"
                :disabled="isLoading || !acl.can('blog.editor')"
                size="default"
                @update:process-success="saveFinish"
                @click.prevent="onSave"
            >
                {{ $t('global.default.save') }}
            </sw-button-process>
            {% endblock %}

            {% block sw_product_detail_actions_save_context_menu %}
            <sw-context-button>
                <template #button>
                    <mt-button
                        class="sw-blog-detail__button-context-menu"
                        square
                        variant="primary"
                        :disabled="isLoading || !acl.can('blog.editor')"
                        size="default"
                    >
                        <mt-icon
                            name="regular-chevron-down-xs"
                            size="16"
                        />
                    </mt-button>
                </template>

                {% block sw_product_detail_actions_save_context_menu_actions %}
                {% block sw_product_detail_actions_duplicate %}
                <sw-context-menu-item
                    class="sw-blog-detail__save-duplicate-action"
                    :disabled="!acl.can('blog.creator') || !acl.can('blog.editor') || blog.parentId != null"
                    @click="onDuplicate"
                >
                    {{ $t('sw-blog.detail.buttonSaveDuplicate') }}
                </sw-context-menu-item>
                {% endblock %}
                {% endblock %}
            </sw-context-button>
            {% endblock %}
        </sw-button-group>
    </template>
    {% endblock %}

    {% block sw_product_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            :disabled="!blogId"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_product_detail_content %}
    <template #content>
        <sw-card-view v-if="!isProductNotFound">

            {% block sw_product_detail_content_top %}
            <template v-if="!isLoading && isChild">
                <router-link
                    v-if="advanceModeEnabled"
                    class="sw-card__back-link"
                    :to="{ name: 'sw.blog.detail.variants', params: { id: blog.parentId } }"
                >
                    <mt-icon
                        name="regular-long-arrow-left"
                        size="var(--scale-size-16)"
                    />
                    {{ $t('sw-blog.general.backToParent') }}
                </router-link>

                <router-link
                    v-else
                    class="sw-card__back-link"
                    :to="{ name: 'sw.blog.detail.base', params: { id: blog.parentId } }"
                >
                    <mt-icon
                        name="regular-long-arrow-left"
                        size="var(--scale-size-16)"
                    />
                    {{ $t('sw-blog.general.backToGeneralOverview') }}
                </router-link>
            </template>
            {% endblock %}

            {% block sw_product_detail_content_language_info %}
            <sw-language-info
                :entity-description="placeholder(blog, 'name', $t('sw-blog.detail.textHeadline'))"
                :is-new-entity="!blogId"
            />
            {% endblock %}

            {% block sw_product_detail_inheritance_warning %}
            <sw-inheritance-warning
                v-if="isChild"
                :name="$t('sw-blog.general.inheritanceModuleName')"
            />
            {% endblock %}

            {% block sw_product_detail_content_tabs %}
            <template v-if="feature.isActive('v6.8.0.0')">
                {% block sw_product_detail_content_mt_tabs %}
                <mt-tabs
                    v-if="blogId"
                    class="sw-blog-detail-page__tabs"
                    position-identifier="sw-blog-detail"
                    :default-item="$route.name"
                    :items="blogDetailTabs"
                    :small="true"
                />
                {% endblock %}
            </template>

            <template v-else>
                <sw-tabs
                    v-if="blogId"
                    class="sw-blog-detail-page__tabs"
                    position-identifier="sw-blog-detail"
                >
                {% block sw_product_detail_content_tabs_general %}
                    <sw-tabs-item
                        class="sw-blog-detail__tab-general"
                        :route="{ name: 'sw.blog.detail.base', params: { id: $route.params.id } }"
                        :has-error="swProductDetailBaseError"
                        :title="$t('sw-blog.detail.tabGeneral')"
                    >
                        {{ $t('sw-blog.detail.tabGeneral') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_specifications %}
                    <sw-tabs-item
                        class="sw-blog-detail__tab-specifications"
                        :route="{ name: 'sw.blog.detail.specifications', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabSpecifications')"
                    >
                        {{ $t('sw-blog.detail.tabSpecifications') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_advanced_prices %}
                    <sw-tabs-item
                        v-show="showModeSetting"
                        class="sw-blog-detail__tab-advanced-prices"
                        :route="{ name: 'sw.blog.detail.prices', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabAdvancedPrices')"
                    >
                        {{ $t('sw-blog.detail.tabAdvancedPrices') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_advanced_variants %}
                    <sw-tabs-item
                        v-show="!isChild && showModeSetting"
                        class="sw-blog-detail__tab-variants"
                        :route="{ name: 'sw.blog.detail.variants', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabVariation')"
                    >
                        {{ $t('sw-blog.detail.tabVariation') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_layout %}
                    <sw-tabs-item
                        v-show="showModeSetting"
                        class="sw-blog-detail__tab-layout"
                        :route="{ name: 'sw.blog.detail.layout', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabLayout')"
                    >
                        {{ $t('sw-blog.detail.tabLayout') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_seo %}
                    <sw-tabs-item
                        v-show="showModeSetting"
                        class="sw-blog-detail__tab-seo"
                        :route="{ name: 'sw.blog.detail.seo', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabSeo')"
                    >
                        {{ $t('sw-blog.detail.tabSeo') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_cross_selling %}
                    <sw-tabs-item
                        v-show="showModeSetting"
                        class="sw-blog-detail__tab-cross-selling"
                        :route="{ name: 'sw.blog.detail.crossSelling', params: { id: $route.params.id } }"
                        :has-error="swProductDetailCrossSellingError"
                        :title="$t('sw-blog.detail.tabCrossSelling')"
                    >
                        {{ $t('sw-blog.detail.tabCrossSelling') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_reviews %}
                    <sw-tabs-item
                        v-show="showModeSetting"
                        class="sw-blog-detail__tab-reviews"
                        :route="{ name: 'sw.blog.detail.reviews', params: { id: $route.params.id } }"
                        :title="$t('sw-blog.detail.tabReviews')"
                    >
                        {{ $t('sw-blog.detail.tabReviews') }}
                    </sw-tabs-item>
                {% endblock %}

                {% block sw_product_detail_content_tabs_additional %}
                {% endblock %}

                </sw-tabs>
            </template>
            {% endblock %}

            <sw-extension-component-section
                position-identifier="sw-blog-detail__before-content"
            />

            {% block sw_product_detail_content_view %}
            <router-view
                v-slot="{ Component }"
            >
                <component
                    :is="Component"
                    @cover-change="onCoverChange"
                />
            </router-view>
            {% endblock %}

            {% block sw_product_detail_content_clone_modal %}
            <sw-blog-clone-modal
                v-if="cloning"
                :blog="blog"
                :blog-number-preview="blogNumberPreview"
                @clone-finish="onDuplicateFinish"
            />
            {% endblock %}

            {# @deprecated tag:v6.8.0 - Will be removed without replacement #}
            {% block sw_product_settings_mode %}
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}

    <template #sidebar>
        {% block sw_product_detail_sidebar %}
        {% endblock %}
    </template>
</sw-page>
{% endblock %}
