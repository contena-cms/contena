{% block sw_product_cross_selling_form %}
<div class="blog-detail-cross-selling-form">
    {% block sw_prduct_cross_selling_form_card %}
    <mt-card
        :title="crossSellingTitle"
        position-identifier="sw-blog-cross-selling-form"
    >
        <template #headerRight>
            {% block sw_prduct_cross_selling_form_context_menu %}
            <div class="sw-blog-detail-cross-selling__context-button">
                <sw-context-button>
                    {% block sw_product_cross_selling_form_context_button_delete %}
                    <sw-context-menu-item
                        variant="danger"
                        class="sw-blog-cross_selling-context-item__delete-action"
                        :disabled="!allowEdit"
                        @click="onShowDeleteModal"
                    >
                        {{ $t('global.default.delete') }}
                    </sw-context-menu-item>
                    {% endblock %}
                </sw-context-button>
            </div>
            {% endblock %}
        </template>

        <div
            v-if="!isLoading && crossSelling"
            class="blog-detail-cross-selling-form__card-container"
        >
            <sw-container
                columns="2fr 1fr"
                gap="0 var(--scale-size-30)"
                align="start"
            >
                {% block sw_prduct_cross_selling_form_title_field %}

                <mt-text-field
                    v-model="crossSelling.name"
                    name="sw-field--crossSelling-name"
                    :label="$t('sw-blog.crossselling.inputCrossSellingTitle')"
                    required
                    :placeholder="placeholder(crossSelling, 'name', $t('sw-blog.crossselling.inputCrossSellingTitlePlaceholder'))"
                    :error="crossSellingNameError"
                    :disabled="!allowEdit"
                />
                {% endblock %}
                {% block sw_prduct_cross_selling_form_active_field %}

                <mt-switch
                    v-model="crossSelling.active"
                    class="sw-blog-detail-cross-selling__active-switch"
                    :label="$t('sw-blog.crossselling.inputCrossSellingActive')"
                    :disabled="!allowEdit"
                    name="sw-field--crossSelling-active"
                    bordered
                />
                {% endblock %}
            </sw-container>

            <sw-container
                columns="2fr 1fr"
                gap="0 var(--scale-size-30)"
            >
                {% block sw_prduct_cross_selling_form_type %}
                <mt-select
                    v-model="crossSelling.type"
                    :label="$t('sw-blog.crossselling.inputCrossSellingType')"
                    :error="crossSellingTypeError"
                    :disabled="!allowEdit"
                    :options="crossSellingTypeOptions"
                    @update:model-value="onTypeChanged"
                />
                {% endblock %}
                {% block sw_prduct_cross_selling_form_position_field %}
                <mt-number-field
                    v-model="crossSelling.position"
                    number-type="int"
                    :min="1"
                    :label="$t('sw-blog.crossselling.inputCrossSellingPosition')"
                    :error="crossSellingPositionError"
                    :placeholder="$t('sw-blog.crossselling.inputCrossSellingPositionPlaceholder')"
                    :disabled="!allowEdit"
                />
                {% endblock %}
            </sw-container>

            <div v-if="!useManualAssignment">
                {% block sw_prduct_cross_selling_form_blog_stream_field %}
                <sw-entity-single-select
                    id="sw-field--crossSelling-blog-group"
                    v-model:value="crossSelling.blogStreamId"
                    entity="blog_stream"
                    :criteria="blogStreamCriteria"
                    class="sw-select-cross-selling__select-blog-stream"
                    :label="$t('sw-blog.crossselling.inputCrossSellingProductStream')"
                    :placeholder="$t('sw-blog.crossselling.inputCrossSellingProductStreamPlaceholder')"
                    :disabled="!allowEdit"
                    show-clearable-button
                />
                {% endblock %}

                <sw-container
                    columns="1fr 1fr"
                    gap="0 var(--scale-size-30)"
                >
                    {% block sw_prduct_cross_selling_form_sort_field %}
                    <mt-select
                        :label="$t('sw-blog.crossselling.inputCrossSellingSorting')"
                        :model-value="sortingConCat"
                        :disabled="!allowEdit"
                        :options="sortingTypeOptions"
                        @update:model-value="onSortingChanged"
                    />
                    {% endblock %}

                    {% block sw_prduct_cross_selling_form_limit_field %}
                    <mt-number-field
                        v-model="crossSelling.limit"
                        number-type="int"
                        :label="$t('sw-blog.crossselling.inputCrossSellingLimit')"
                        :disabled="!allowEdit"
                    />
                    {% endblock %}
                </sw-container>

                {% block sw_prduct_cross_selling_form_preview_link %}
                <sw-container
                    columns="1fr"
                    justify="end"
                    class="sw-blog-cross-selling-form__links"
                >
                    <a
                        class="sw-card__quick-link"
                        :class="{ 'is--disabled': previewDisabled }"
                        role="button"
                        tabindex="0"
                        @click="openModalPreview"
                        @keydown.enter="openModalPreview"
                    >
                        {{ $t('sw-blog.crossselling.linkOpenStreamPreview') }}
                        <mt-icon
                            name="regular-long-arrow-right"
                            size="var(--scale-size-16)"
                        />
                    </a>
                </sw-container>
                {% endblock %}
            </div>

            {% block sw_product_detail_cross_selling_assignment %}
            <sw-blog-cross-selling-assignment
                v-else
                :assigned-blogs="crossSelling.assignedProducts"
                :cross-selling-id="crossSelling.id"
                :searchable-fields="['name', 'blogNumber']"
                :allow-edit="allowEdit"
            />
            {% endblock %}

            {% block sw_product_detail_cross_selling_modal_preview_modal %}
            <sw-blog-stream-modal-preview
                v-if="showModalPreview"
                ref="modalPreview"
                :filters="blogStreamFilterTree"
                @modal-close="closeModalPreview"
            />
            {% endblock %}
        </div>
    </mt-card>
    {% endblock %}

    {% block sw_product_detail_cross_selling_form_modal_delete %}
    <sw-modal
        v-if="showDeleteModal"
        variant="small"
        :title="$t('sw-blog.crossselling.deleteConfirmTitle')"
        class="sw-blog-detail-cross-selling__delete-modal"
        @modal-close="onCloseDeleteModal"
    >
        {% block sw_product_detail_cross_selling_form_delete_text %}
        <p>
            {{ $t('sw-blog.crossselling.deleteConfirmText') }}
        </p>
        {% endblock %}

        {% block sw_product_detail_cross_selling_form_modal_delete_footer %}
        <template #modal-footer>
            {% block sw_product_detail_cross_selling_modal_delete_action_cancel %}
            <mt-button
                size="small"
                variant="secondary"
                @click="onCloseDeleteModal"
            >
                {{ $t('global.default.cancel') }}
            </mt-button>
            {% endblock %}

            {% block sw_product_detail_cross_selling_form_modal_delete_action_delete %}
            <mt-button
                class="sw-blog-detail-cross-selling__delete-button"
                size="small"
                variant="critical"
                @click="onConfirmDelete"
            >
                {{ $t('global.default.delete') }}
            </mt-button>
            {% endblock %}
        </template>
        {% endblock %}
    </sw-modal>
    {% endblock %}

    {% block sw_product_cross_selling_form_condition_tree_invisibly %}
    <sw-condition-tree
        v-if="blogStreamFilterRepository"
        v-show="false"
        association-field="blogStreamId"
        child-association-field="queries"
        :initial-conditions="blogStreamFilter"
        :condition-repository="blogStreamFilterRepository"
        :condition-data-provider-service="blogStreamConditionService"
        :association-value="associationValue"
        :root-condition="null"
        @conditions-changed="updateProductStreamFilterTree"
    />
    {% endblock %}
</div>
{% endblock %}
