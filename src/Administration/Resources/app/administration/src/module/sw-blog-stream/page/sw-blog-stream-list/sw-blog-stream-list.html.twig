{% block sw_content_stream_list %}
<sw-page class="sw-blog-stream-list">
    {% block sw_content_stream_list_search_bar %}
    <template #search-bar>
        <sw-search-bar
            initial-search-type="content_stream"
            :placeholder="$t('sw-blog-stream.general.placeholderSearchBar')"
            :initial-search="term"
            @search="onSearch"
        />
    </template>
    {% endblock %}

    {% block sw_content_stream_list_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_content_stream_list_smart_bar_header_title %}
        <h2>
            {% block sw_content_stream_list_smart_bar_header_title_text %}
            <span>{{ $t('sw-blog-stream.list.textProductStreamOverview') }}</span>
            {% endblock %}

            {% block sw_content_stream_list_smart_bar_header_amount %}
            <span
                v-if="!isLoading"
                class="sw-page__smart-bar-amount"
            >
                ({{ total }})
            </span>
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_content_stream_list_smart_bar_actions %}
    <template #smart-bar-actions>
        {% block sw_content_stream_list_smart_bar_actions_add %}
        <mt-button
            v-tooltip.bottom="getNoPermissionsTooltip('content_stream.creator')"
            class="sw-blog-stream-list__create-action"
            :disabled="!acl.can('content_stream.creator')"
            variant="primary"
            size="default"
            @click="$router.push({ name: 'sw.blog.stream.create' })"
        >
            {{ $t('sw-blog-stream.list.buttonAddProductStream') }}
        </mt-button>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_manufacturer_list_language_switch %}
    <template #language-switch>
        <sw-language-switch @on-change="onChangeLanguage" />
    </template>
    {% endblock %}

    <template #content>
        {% block sw_content_stream_list_content %}
        <div class="sw-blog-stream-list__content">
            {% block sw_content_stream_list_empty_state %}
            <mt-empty-state
                v-if="!isLoading && !total"
                centered
                :icon="$route.meta.$module.icon"
                :headline="isValidTerm(term) ? $t('sw-empty-state.messageNoResultTitle') : $t('sw-blog-stream.list.messageEmpty')"
                :description="isValidTerm(term) ? $t('sw-empty-state.messageNoResultSubline') : $t($route.meta.$module.description)"
                :link-text="isValidTerm(term) ? $t('sw-empty-state.messageNoResultLink') : ''"
                :link-href="isValidTerm(term) ? $router.resolve({ name: 'sw.profile.index.searchPreferences' }).href : ''"
            >
                <template
                    v-if="!isValidTerm(term)"
                    #button
                >
                    <mt-button
                        v-tooltip="{
                            message: $t('sw-privileges.tooltip.warning'),
                            disabled: acl.can('content_stream.creator'),
                            showOnDisabledElements: true
                        }"
                        variant="primary"
                        :disabled="!acl.can('content_stream.creator')"
                        @click="$router.push({ name: 'sw.blog.stream.create' })"
                    >
                        {{ $t('sw-blog-stream.list.buttonAddProductStream') }}
                    </mt-button>
                </template>
            </mt-empty-state>
            {% endblock %}

            {% block sw_content_stream_list_grid %}
            <sw-entity-listing
                v-else-if="isLoading || (contentStreams && entitySearchable)"
                ref="swProductStreamGrid"
                class="sw-blog-stream-list-grid"
                :data-source="contentStreams"
                :columns="getProductStreamColumns()"
                :repository="contentStreamRepository"
                detail-route="sw.blog.stream.detail"
                :show-selection="acl.can('content_stream.deleter')"
                :is-loading="isLoading"
                :disable-data-fetching="true"
                :sort-by="currentSortBy"
                :sort-direction="sortDirection"
                :criteria-limit="limit"
                :allow-inline-edit="acl.can('content_stream.editor')"
                identifier="sw-blog-stream-list"
                @page-change="onPageChange"
                @column-sort="onSortColumn"
                @inline-edit-save="onInlineEditSave"
                @items-delete-finish="getList"
                @delete-item-failed="onDeleteItemFailed"
                @delete-items-failed="onDeleteItemsFailed"
            >

                {% block sw_content_stream_list_grid_bulk %}
                <template #bulk>
                    <span v-if="!acl.can('content_stream.deleter')"></span>
                </template>
                {% endblock %}

                {% block sw_content_stream_list_grid_column_invalid %}
                <template #column-invalid="{item}">
                    <template v-if="item.invalid">
                        {{ $t('sw-blog-stream.list.status.invalid') }}
                    </template>

                    <template v-else>
                        {{ $t('sw-blog-stream.list.status.valid') }}
                    </template>
                </template>
                {% endblock %}

                {% block sw_content_stream_list_grid_colum_updated_at %}
                <template #column-updatedAt="{item}">
                    <template v-if="item.updatedAt">
                        <sw-time-ago :date="item.updatedAt" />
                    </template>

                    <template v-else>
                        <sw-time-ago :date="item.createdAt" />
                    </template>
                </template>
                {% endblock %}

                {% block sw_content_stream_list_grid_more_actions %}
                <template #more-actions="{item}">
                    {% block sw_content_stream_list_grid_duplicate_action %}
                    <sw-context-menu-item
                        :disabled="!acl.can('content_stream.creator')"
                        class="sw-entity-listing__context-menu-edit-duplicate"
                        @click="onDuplicate(item)"
                    >
                        {{ $t('global.default.duplicate') }}
                    </sw-context-menu-item>
                    {% endblock %}
                </template>
                {% endblock %}

                {% block sw_content_stream_list_grid_delete_action %}
                <template #delete-action="{item, showDelete, allowDelete}">
                    <sw-context-menu-item
                        :disabled="!acl.can('content_stream.deleter') || !allowDelete"
                        class="sw-entity-listing__context-menu-edit-delete"
                        variant="danger"
                        @click="showDelete(item.id)"
                    >
                        {{ $t('global.default.delete') }}
                    </sw-context-menu-item>
                </template>
                {% endblock %}
            </sw-entity-listing>
            {% endblock %}
        </div>
        {% endblock %}
    </template>

    {% block sw_content_stream_list_sidebar %}
    <template #sidebar>
        <sw-sidebar>
            {% block sw_content_stream_list_sidebar_refresh %}
            <sw-sidebar-item
                icon="regular-undo"
                :title="$t('sw-blog-stream.list.titleSidebarItemRefresh')"
                @click="onRefresh"
            />
            {% endblock %}
        </sw-sidebar>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
