{% block sw_content_stream_detail %}
<sw-page class="sw-blog-stream-detail">
    {% block sw_content_stream_detail_header %}
    <template #smart-bar-header>
        <h2 v-if="contentStream.name">
            {{ contentStream.name }}
        </h2>

        <h2
            v-else
            class="sw-blog-stream-detail__empty-title"
        >
            {{ placeholder(contentStream, 'name', $t('sw-blog-stream.detail.textHeadline')) }}
        </h2>
    </template>
    {% endblock %}

    {% block sw_content_stream_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_content_stream_detail_actions_abort %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            :disabled="isLoading"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        <sw-button-group
            v-tooltip.bottom="{
                message: $t('sw-privileges.tooltip.warning'),
                disabled: acl.can('content_stream.editor'),
                showOnDisabledElements: true
            }"
            class="sw-blog-stream-detail__save-button-group"
            :split-button="true"
        >
            {% block sw_content_stream_detail_actions_save %}
            <sw-button-process
                v-model:process-success="isSaveSuccessful"
                v-tooltip.bottom="tooltipSave"
                class="sw-blog-stream-detail__save-action"
                :is-loading="isSaving"
                :disabled="!acl.can('content_stream.editor')"
                variant="primary"
                @click.prevent="onSave"
            >
                {{ $t('global.default.save') }}
            </sw-button-process>
            {% endblock %}

            {% block sw_content_stream_detail_actions_save_context_menu %}
            <sw-context-button>
                <template #button>
                    <mt-button
                        class="sw-blog-stream-detail__button-context-menu"
                        square
                        variant="primary"
                        :disabled="isLoading || !acl.can('content_stream.editor')"
                        size="default"
                    >
                        <mt-icon name="regular-chevron-down-xs" />
                    </mt-button>
                </template>

                {% block sw_content_stream_detail_actions_save_context_menu_actions %}
                {% block sw_content_stream_detail_actions_duplicate %}
                <sw-context-menu-item
                    class="sw-blog-stream-detail__save-duplicate-action"
                    :disabled="!acl.can('content_stream.creator') || !acl.can('content_stream.editor')"
                    @click="onDuplicate"
                >
                    {{ $t('sw-blog.detail.buttonSaveDuplicate') }}
                </sw-context-menu-item>
                {% endblock %}
                {% endblock %}
            </sw-context-button>
            {% endblock %}
        </sw-button-group>
    </template>
    {% endblock %}

    {% block sw_content_stream_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            :disabled="!contentStreamId"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_content_stream_detail_content %}
    <template #content>
        <sw-card-view>
            {% block sw_content_stream_detail_content_language_info %}
            <sw-language-info
                :entity-description="placeholder(contentStream, 'name', $t('sw-blog-stream.detail.textHeadline'))"
            />
            {% endblock %}

            {% block sw_content_stream_detail_basic_info %}
            <mt-card
                position-identifier="sw-blog-stream-detail-basic-info"
                :large="true"
                :is-loading="isLoading"
                :title="$t('sw-blog-stream.detail.titleCard')"
            >
                {% block sw_product_basic_form_name_field %}
                <mt-text-field
                    v-model="contentStream.name"
                    v-tooltip.bottom="getNoPermissionsTooltip('content_stream.editor')"
                    name="sw-field--contentStream-name"
                    :label="$t('sw-blog-stream.detail.labelName')"
                    :validation="nameRequired"
                    :required="isSystemLanguage"
                    :placeholder="placeholder(contentStream, 'name', $t('sw-blog-stream.detail.placeholderName'))"
                    :error="contentStreamNameError"
                    :disabled="!acl.can('content_stream.editor')"
                />
                {% endblock %}

                {% block sw_product_basic_form_description_field %}
                <mt-textarea
                    v-model="contentStream.description"
                    v-tooltip.bottom="getNoPermissionsTooltip('content_stream.editor')"
                    name="sw-field--contentStream-description"
                    :label="$t('sw-blog-stream.detail.labelDescription')"
                    :placeholder="placeholder(contentStream, 'description', $t('sw-blog-stream.detail.placeholderDescription'))"
                    :disabled="!acl.can('content_stream.editor')"
                />
                {% endblock %}

                {% block sw_product_basic_form_display_as_group_field %}
                <mt-switch
                    v-if="contentStream"
                    v-model="contentStream.displayAsGroup"
                    v-tooltip.bottom="getNoPermissionsTooltip('content_stream.editor')"
                    class="sw-blog-stream-detail__display-as-group"
                    :label="$t('sw-blog-stream.detail.labelDisplayAsGroup')"
                    :help-text="$t('sw-blog-stream.detail.helpTextDisplayAsGroup')"
                    :disabled="!acl.can('content_stream.editor')"
                    bordered
                />
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block sw_content_stream_detail_filter %}
            <mt-card
                :large="true"
                position-identifier="sw-blog-stream-detail-filter"
                class="sw-blog-stream-detail__condition_container"
                :class="{ 'is--disabled': !acl.can('content_stream.editor') }"
                :title="$t('sw-blog-stream.detail.titleFilter')"
                :is-loading="isLoading"
            >
                <div
                    v-if="!contentStreamIndexingEnabled"
                    class="sw-blog-stream-detail__product-stream-warning"
                >
                    <mt-banner
                        variant="attention"
                        :title="$t('sw-blog-stream.detail.contentStreamIndexingWarning.title')"
                    >
                        <p v-html="$t('sw-blog-stream.detail.contentStreamIndexingWarning.message')">
                        </p>

                        <mt-link
                            type="external"
                            as="a"
                            href="https://developer.contena.cn/docs/guides/hosting/performance/performance-tweaks.html#disable-blog-stream-indexer"
                            target="_blank"
                        >
                            {{ $t('sw-blog-stream.detail.contentStreamIndexingWarning.action') }}
                        </mt-link>
                    </mt-banner>
                </div>

                <div
                    v-if="deprecatedFiltersInUse.length > 0"
                    class="sw-blog-stream-detail__product-type-warning"
                >
                    <mt-banner variant="attention">
                        <span
                            v-for="deprecation in deprecatedFiltersInUse"
                            :key="deprecation.field"
                        >
                            <template v-if="deprecation.replacement">
                                {{ $t('sw-blog-stream.detail.deprecatedFilterWarning', {
                                label: $t(deprecation.label),
                                version: deprecation.version,
                                replacement: $t(deprecation.replacement.label),
                                }) }}
                            </template>

                            <template v-else>
                                {{ $t('sw-blog-stream.detail.deprecatedFilterWarningNoReplacement', {
                                label: $t(deprecation.label),
                                version: deprecation.version,
                                }) }}
                            </template>
                        </span>
                    </mt-banner>
                </div>

                {% block sw_content_stream_detail_filter_preview_button %}
                <mt-button
                    v-if="!isLoading"
                    class="sw-blog-stream-detail__open_modal_preview"
                    variant="secondary"
                    @click.prevent="openModalPreview"
                >
                    {{ $t('sw-blog-stream.detail.buttonOpenPreview') }}
                </mt-button>
                {% endblock %}

                {% block sw_content_stream_detail_filter_tree %}
                <sw-condition-tree
                    :initial-conditions="contentStreamFilters"
                    :condition-repository="contentStreamFiltersRepository"
                    :condition-data-provider-service="contentStreamConditionService"
                    child-association-field="queries"
                    association-field="contentStreamId"
                    :association-value="contentStream.id"
                    :root-condition="null"
                    :disabled="!acl.can('content_stream.editor')"
                    @conditions-changed="updateFilterTree"
                />
                {% endblock %}
            </mt-card>
            {% endblock %}

            {% block sw_prouct_stream_detail_preview_modal %}
            <sw-blog-stream-modal-preview
                v-if="showModalPreview"
                ref="modalPreview"
                :filters="contentStreamFiltersTree"
                :display-as-group="contentStream.displayAsGroup"
                @modal-close="closeModalPreview"
            />
            {% endblock %}

            {% block sw_prouct_stream_detail_custom_field_sets %}
            <mt-card
                v-if="showCustomFields"
                position-identifier="sw-blog-stream-detail-custom-field-sets"
                :large="true"
                :is-loading="customFieldsLoading"
                :title="$t('sw-settings-custom-field.general.mainMenuItemGeneral')"
            >
                <sw-custom-field-set-renderer
                    :entity="contentStream"
                    :disabled="!acl.can('content_stream.editor')"
                    :sets="customFieldSets"
                />
            </mt-card>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}
</sw-page>
{% endblock %}
