{% block sw_channel_detail %}
<sw-page class="sw-sales-channel-detail">
    {% block sw_channel_detail_header %}
    <template #smart-bar-header>
        {% block sw_channel_detail_header_headline %}
        <h2>{{ placeholder(channel, 'name', $t('sw-sales-channel.detail.textHeadline')) }}</h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_channel_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_channel_detail_actions_save %}
        <sw-button-process
            v-tooltip.bottom="tooltipSave"
            class="sw-sales-channel-detail__save-action"
            :is-loading="isLoading"
            :process-success="isSaveSuccessful"
            :disabled="!allowSaving || isLoading || blogComparison.invalidFileName"
            variant="primary"
            data-analytics-id="sw_channel.detail.channel_save"
            :data-analytics-sales-channel-type-id="channel?.typeId ?? ''"
            :data-analytics-sales-channel-is-new="channel?.isNew?.() ?? false"
            @update:process-success="saveFinish"
            @click.prevent="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_channel_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :save-changes-function="saveOnLanguageChange"
            :abort-change-function="abortOnLanguageChange"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_channel_detail_content %}
    <template #content>
        <sw-card-view>

            {% block sw_channel_detail_content_language_info %}
            <sw-language-info
                :entity-description="placeholder(channel, 'name', $t('sw-sales-channel.detail.textHeadline'))"
            />
            {% endblock %}

            {% block sw_channel_detail_agentic_commerce_deprecation_banner %}
            {# @deprecated tag:v6.8.0 - Will be removed #}
            <mt-banner
                v-if="showAgenticCommerceDeprecationBanner"
                class="sw-sales-channel-detail__agentic-commerce-deprecation-banner"
                variant="attention"
                :title="$t('sw-sales-channel.detail.agenticCommerce.deprecationBanner.title')"
            >
                <div>{{ $t('sw-sales-channel.detail.agenticCommerce.deprecationBanner.message') }}</div>

                <mt-button
                    variant="secondary"
                    size="small"
                    @click="onClickInstallAgenticCommercePlugin"
                >
                    {{ $t('sw-sales-channel.detail.agenticCommerce.deprecationBanner.installPlugin') }}
                </mt-button>
            </mt-banner>
            {% endblock %}

            {% block sw_channel_detail_content_tabs %}
            <template v-if="feature.isActive('v6.8.0.0')">
                {% block sw_channel_detail_content_mt_tabs %}
                <mt-tabs
                    class="sw-sales-channel-detail-__tabs"
                    position-identifier="sw-sales-channel-detail"
                    :default-item="$route.name"
                    :items="channelDetailTabs"
                    :small="true"
                />
                {% endblock %}
            </template>

            <template v-else>
                <sw-tabs
                    class="sw-sales-channel-detail-__tabs"
                    position-identifier="sw-sales-channel-detail"
                >
                    {%  block sw_channel_detail_content_tab_general %}
                    <sw-tabs-item
                        :route="{ name: 'sw.sales.channel.detail.base', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.tabBase')"
                    >
                        {{ $t('sw-sales-channel.detail.tabBase') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_detail_content_tab_product_export_insights %}
                    <sw-tabs-item
                        v-if="isAgenticCommerce && !isLoading"
                        :route="{ name: 'sw.sales.channel.detail.blogExportInsights', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.blogExport.tabInsights')"
                    >
                        {{ $t('sw-sales-channel.detail.blogExport.tabInsights') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_detail_content_tab_products %}
                    <sw-tabs-item
                        v-if="isHeadless || isFrontend"
                        :route="{ name: 'sw.sales.channel.detail.blogs', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.tabProducts')"
                    >
                        {{ $t('sw-sales-channel.detail.tabProducts') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_detail_content_tab_theme %}{% endblock %}

                    {% block sw_channel_detail_content_tab_agentic_commerce_integration %}
                    <sw-tabs-item
                        v-if="isAgenticCommerce && !isLoading"
                        :route="{ name: 'sw.sales.channel.detail.agenticCommerceIntegration', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.agenticCommerce.tabIntegration')"
                    >
                        {{ $t('sw-sales-channel.detail.agenticCommerce.tabIntegration') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_detail_content_tab_export_template %}
                    {# @deprecated tag:v6.8.0 - Block will be removed. Use `sw_channel_detail_content_tab_export_template` instead. #}
                    {%  block sw_channel_detail_content_tab_product_comparison %}
                    <sw-tabs-item
                        v-if="isProductExportChannel && !isLoading"
                        :route="{ name: 'sw.sales.channel.detail.blogComparison', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.tabProductComparison')"
                    >
                        {{ $t('sw-sales-channel.detail.tabProductComparison') }}
                    </sw-tabs-item>
                    {% endblock %}
                    {% endblock %}

                    {%  block sw_channel_detail_content_tab_analytics %}
                    <sw-tabs-item
                        v-if="isFrontend"
                        :route="{ name: 'sw.sales.channel.detail.analytics', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.tabAnalytics')"
                    >
                        {{ $t('sw-sales-channel.detail.tabAnalytics') }}
                    </sw-tabs-item>
                    {% endblock %}

                    <sw-tabs-item
                        v-if="isHeadless || isFrontend"
                        :route="{ name: 'sw.sales.channel.detail.agenticFiles', params: { id: $route.params.id } }"
                        :title="$t('sw-sales-channel.detail.tabAgenticFiles')"
                    >
                        {{ $t('sw-sales-channel.detail.tabAgenticFiles') }}
                    </sw-tabs-item>
                </sw-tabs>
            </template>
            {% endblock %}

            {% block sw_channel_detail_content_view %}
            <template v-if="isLoading">
                <sw-skeleton />
                <sw-skeleton />
            </template>

            <template v-else>
                <router-view
                    :key="$route.params.id"
                    v-slot="{ Component }"
                >
                    <component
                        :is="Component"
                        :sales-channel="channel"
                        :blog-export="blogExport"
                        :agentic-commerce-export-config="agenticCommerceExportConfig"
                        :frontend-sales-channel-criteria="frontendSalesChannelCriteria"
                        :custom-field-sets="customFieldSets"
                        :is-loading="isLoading"
                        :blog-comparison-access-url="blogComparison.blogComparisonAccessUrl"
                        :template-options="blogComparison.templateOptions"
                        :show-template-modal="blogComparison.showTemplateModal"
                        :template-name="blogComparison.templateName"
                        @template-selected="onTemplateSelected"
                        @access-key-changed="generateAccessUrl"
                        @domain-changed="generateAccessUrl"
                        @invalid-file-name="setInvalidFileName(true)"
                        @valid-file-name="setInvalidFileName(false)"
                        @template-modal-close="onTemplateModalClose"
                        @template-modal-confirm="onTemplateModalConfirm"
                    />
                </router-view>
            </template>
            {% endblock %}
        </sw-card-view>
    </template>
    {% endblock %}

    <template #sidebar>
        {% block sw_channel_detail_sidebar %}
        {% endblock %}
    </template>
</sw-page>
{% endblock %}
