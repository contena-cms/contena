{% block sw_channel_products_assignment_modal %}
<sw-modal
    class="sw-sales-channel-blogs-assignment-modal"
    variant="large"
    :title="$t('sw-sales-channel.detail.blogAssignmentModal.title')"
    @modal-close="onCloseModal"
>
    <template #default>
        {% block sw_channel_products_assignment_modal_tabs %}
        <template v-if="feature.isActive('v6.8.0.0')">
            {% block sw_channel_products_assignment_modal_mt_tabs %}
            <mt-tabs
                class="sw-sales-channel-blogs-assignment-modal__tabs"
                position-identifier="sw-sales-channel-blogs-assignment-modal"
                :default-item="activeTab"
                :items="blogAssignmentTabs"
                :small="true"
                @new-item-active="activeTab = $event"
            />
            {% endblock %}

            {% block sw_channel_products_assignment_modal_mt_tab_content %}
            <div
                class="sw-sales-channel-blogs-assignment-modal__content sw-sales-channel-blogs-assignment-modal__content--mt-tabs"
                :height="tabContentHeight"
            >
                {% block sw_channel_products_assignment_modal_mt_tab_content_single_products %}
                <sw-sales-channel-blogs-assignment-single-blogs
                    ref="blog"
                    v-hide="activeTab === 'singleProducts'"
                    :sales-channel="channel"
                    :container-style="blogContainerStyle"
                    @selection-change="onChangeSelection"
                />
                {% endblock %}

                {% block sw_channel_products_assignment_modal_mt_tab_content_categories %}
                <sw-sales-channel-blog-assignment-categories
                    ref="category"
                    v-hide="activeTab === 'categories'"
                    :sales-channel="channel"
                    :container-style="categoryContainerStyle"
                    @selection-change="onChangeSelection"
                    @blog-loading="setProductLoading"
                />
                {% endblock %}

                {% block sw_channel_products_assignment_modal_mt_tab_content_dynamic_product_groups %}
                <sw-sales-channel-blogs-assignment-dynamic-blog-groups
                    ref="blogGroup"
                    v-hide="activeTab === 'dynamicProductGroups'"
                    :sales-channel="channel"
                    :container-style="blogGroupContainerStyle"
                    @selection-change="onChangeSelection"
                    @blog-loading="setProductLoading"
                />
                {% endblock %}
            </div>
            {% endblock %}
        </template>

        <template v-else>
            <sw-tabs
                class="sw-sales-channel-blogs-assignment-modal__tabs"
                position-identifier="sw-sales-channel-blogs-assignment-modal"
                default-item="singleProducts"
            >
                <template #default="{ active }">
                    {% block sw_channel_products_assignment_modal_tabs_single_products %}
                    <sw-tabs-item
                        name="singleProducts"
                        :title="$t('sw-sales-channel.detail.blogAssignmentModal.singleProducts')"
                        :active-tab="active"
                    >
                        {{ $t('sw-sales-channel.detail.blogAssignmentModal.singleProducts') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_products_assignment_modal_tabs_categories %}
                    <sw-tabs-item
                        name="categories"
                        :title="$t('sw-sales-channel.detail.blogAssignmentModal.categories.title')"
                        :active-tab="active"
                    >
                        {{ $t('sw-sales-channel.detail.blogAssignmentModal.categories.title') }}
                    </sw-tabs-item>
                    {% endblock %}

                    {% block sw_channel_products_assignment_modal_tab_dynamic_product_groups %}
                    <sw-tabs-item
                        name="dynamicProductGroups"
                        :title="$t('sw-sales-channel.detail.blogAssignmentModal.dynamicProductGroups.title')"
                        :active-tab="active"
                    >
                        {{ $t('sw-sales-channel.detail.blogAssignmentModal.dynamicProductGroups.title') }}
                    </sw-tabs-item>
                    {% endblock %}
                </template>

                <template #content="{ active }">
                    <div
                        class="sw-sales-channel-blogs-assignment-modal__content"
                        :height="tabContentHeight"
                    >
                        {% block sw_channel_products_assignment_modal_tab_content_single_products %}
                        <sw-sales-channel-blogs-assignment-single-blogs
                            ref="blog"
                            v-hide="active === 'singleProducts'"
                            :sales-channel="channel"
                            :container-style="blogContainerStyle"
                            @selection-change="onChangeSelection"
                        />
                        {% endblock %}

                        {% block sw_channel_products_assignment_modal_tab_content_categories %}
                        <sw-sales-channel-blog-assignment-categories
                            ref="category"
                            v-hide="active === 'categories'"
                            :sales-channel="channel"
                            :container-style="categoryContainerStyle"
                            @selection-change="onChangeSelection"
                            @blog-loading="setProductLoading"
                        />
                        {% endblock %}

                        {% block sw_channel_products_assignment_modal_tab_content_dynamic_product_groups %}
                        <sw-sales-channel-blogs-assignment-dynamic-blog-groups
                            ref="blogGroup"
                            v-hide="active === 'dynamicProductGroups'"
                            :sales-channel="channel"
                            :container-style="blogGroupContainerStyle"
                            @selection-change="onChangeSelection"
                            @blog-loading="setProductLoading"
                        />
                        {% endblock %}
                    </div>
                </template>
            </sw-tabs>
        </template>
        {% endblock %}
    </template>

    <template #modal-footer>
        {% block sw_channel_products_assignment_modal_footer_cancel %}
        <mt-button
            class="sw-sales-channel-blogs-assignment-modal__close-button"
            size="small"
            variant="secondary"
            @click="onCloseModal"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_channel_products_assignment_modal_footer_submit %}
        <mt-button
            size="small"
            variant="primary"
            :is-loading="isAssignProductLoading || isProductLoading"
            @click="onAddProducts"
        >
            {{ $t('sw-sales-channel.detail.blogs.buttonAddProducts', { blogCount: blogCount }, blogCount) }}
        </mt-button>
        {% endblock %}
    </template>
</sw-modal>
{% endblock %}
