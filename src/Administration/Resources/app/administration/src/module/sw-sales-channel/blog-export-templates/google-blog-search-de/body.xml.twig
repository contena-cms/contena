<item>
    <g:id>{{ blog.blogNumber }}</g:id>
    <title>{{ blog.translated.name|escape }}</title>
    <description>{{ blog.translated.description|escape }}</description>
    <g:google_product_category>950{# change your Google Shopping category #}</g:google_product_category>
    {%- if blogExport.feedLabel is defined and blogExport.feedLabel is not empty -%}
        <g:feed_label>{{ blogExport.feedLabel|escape }}</g:feed_label>
    {%- endif -%}
    {%- set blogTypeCategory = blog.seoCategory ?? blog.categories.first -%}
    {%- if blogTypeCategory -%}
        <g:blog_type>{{ blogTypeCategory.breadCrumb|slice(1)|join(' > ')|raw|escape }}</g:blog_type>
    {%- endif -%}
    <link>{{ entitySeoUrl('blog', blog.id) }}</link>
    {% if blog.cover.media is defined %}<g:image_link>{{ blog.cover.media.url }}</g:image_link>{% endif %}
    <g:condition>new</g:condition>
    <g:availability>
        {%- if blog.availableStock >= blog.minPurchase and blog.deliveryTime -%}
            in_stock
        {%- elseif blog.availableStock < blog.minPurchase and blog.deliveryTime and blog.restockTime -%}
            preorder
        {%- else -%}
            out_of_stock
        {%- endif -%}
    </g:availability>
    {% set price = blog.calculatedPrice %}
    {%- if blog.calculatedPrices.count > 0 -%}
        {% set price = blog.calculatedPrices.last %}
    {%- endif -%}

    <g:price>{{ price.unitPrice|number_format(context.currency.itemRounding.decimals, '.', '') }} {{ context.currency.isoCode }}</g:price>
    {% if blog.manufacturer is defined %}<g:brand>{{ blog.manufacturer.translated.name|escape }}</g:brand>{% endif %}
    <g:gtin>{{ blog.ean }}</g:gtin>
    <g:mpn>{{ blog.manufacturerNumber }}</g:mpn>
    <g:shipping>
        <g:country>DE</g:country>
        <g:service>Standard</g:service>
        {% if blog.shippingFree  %}
            <g:price>0.00 {{ context.currency.isoCode }}</g:price>
        {% else %}
            <g:price>4.95 {{ context.currency.isoCode }}{# change your default delivery costs #}</g:price>
        {% endif %}
    </g:shipping>
</item>
