{% block sw_bulk_edit_product_visibility %}
<div class="sw-bulk-edit-blog-visibility">
    {% block sw_bulk_edit_product_visibility_select %}
    <sw-inherit-wrapper
        ref="blogVisibilitiesInheritance"
        v-model:value="blog.visibilities"
        :inherited-value="blog.visibilities"
        class="sw-blog-category-form__visibility_field"
        :custom-remove-inheritance-function="visibilitiesRemoveInheritanceFunction"
        is-association
    >
        <template #content="{ currentValue, isInherited, updateCurrentValue }">
            <sw-blog-visibility-select
                ref="blogVisibility"
                :key="isInherited"
                class="sw-blog-detail__select-visibility"
                :entity-collection="currentValue"
                :placeholder="$t('sw-blog.visibility.placeholderVisibility')"
                :disabled="disabled || undefined"
                @update:entity-collection="updateCurrentValue"
            />
        </template>
    </sw-inherit-wrapper>
    {% endblock %}

    {% block sw_bulk_edit_product_visibility_advanced %}
    <sw-container
        v-if="blog.visibilities.length > 0"
        columns="1fr"
        justify="end"
    >
        <a
            class="sw-card__quick-link advanced-visibility"
            :class="{ 'is--disabled': disabled }"
            role="button"
            tabindex="0"
            @click="openModal"
            @keydown.enter="openModal"
        >
            {{ $t('sw-blog.visibility.linkAdvancedVisibility') }}
            <mt-icon
                name="regular-long-arrow-right"
                size="var(--scale-size-16)"
            />
        </a>
    </sw-container>
    {% endblock %}

    {% block sw_bulk_edit_product_visibility_advanced_modal %}
    <sw-modal
        v-if="displayVisibilityDetail"
        :title="$t('sw-blog.visibility.textHeadline')"
        class="sw-blog-category-form__visibility_modal"
        variant="large"
        @modal-close="closeModal"
    >
        <p>{{ $t('sw-blog.visibility.visibilityModalDescription') }}</p>

        <sw-blog-visibility-detail />

        <template #modal-footer>
            <mt-button
                variant="primary"
                size="small"
                @click="closeModal"
            >
                {{ $t('global.default.apply') }}
            </mt-button>
        </template>
    </sw-modal>
    {% endblock %}
</div>
{% endblock %}
