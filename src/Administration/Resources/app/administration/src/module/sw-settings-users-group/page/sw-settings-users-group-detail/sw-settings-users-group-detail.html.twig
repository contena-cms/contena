{% block sw_settings_customer_group_detail %}
<sw-page class="sw-settings-user-group-detail">

    {% block sw_settings_customer_group_detail_search_bar %}
    <template #search-bar></template>
    {% endblock %}

    {% block sw_settings_customer_group_detail_smart_bar_header %}
    <template #smart-bar-header>
        {% block sw_settings_customer_group_detail_smart_bar_header_title %}
        <h2>
            {% block sw_settings_customer_group_detail_smart_bar_header_title_text %}
            {{ placeholder(userGroup, 'name', $t('sw-settings-user-group.detail.placeholderNewCustomerGroup')) }}
            {% endblock %}
        </h2>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_customer_group_detail_language_switch %}
    <template #language-switch>
        <sw-language-switch
            :disabled="userGroupId == null"
            @on-change="onChangeLanguage"
        />
    </template>
    {% endblock %}

    {% block sw_settings_customer_group_detail_actions %}
    <template #smart-bar-actions>
        {% block sw_settings_customer_group_detail_actions_cancel %}
        <mt-button
            v-tooltip.bottom="tooltipCancel"
            class="sw-settings-user-group-detail__cancel"
            variant="secondary"
            size="default"
            @click="onCancel"
        >
            {{ $t('global.default.cancel') }}
        </mt-button>
        {% endblock %}

        {% block sw_settings_customer_group_detail_actions_save %}
        <sw-button-process
            v-model:process-success="isSaveSuccessful"
            v-tooltip.bottom="tooltipSave"
            class="sw-settings-user-group-detail__save"
            variant="primary"
            :is-loading="isLoading"
            :disabled="!allowSave || undefined"
            @click="onSave"
        >
            {{ $t('global.default.save') }}
        </sw-button-process>
        {% endblock %}
    </template>
    {% endblock %}

    {% block sw_settings_customer_group_detail_cardview %}
    <template #content>
        <sw-card-view>
            <sw-skeleton v-if="isLoading" />

            <template v-else>
                {% block sw_settings_customer_group_detail_content_language_info %}
                <sw-language-info :entity-description="entityDescription" />
                {% endblock %}

                {% block sw_settings_customer_group_detail_content_card %}
                <mt-card
                    :is-loading="isLoading"
                    :title="$t('sw-settings-user-group.detail.cardTitle')"
                    position-identifier="sw-settings-user-group-detail-content"
                >
                    <template v-if="!isLoading">
                        <sw-container
                            columns="repeat(2, minmax(250px, 1fr))"
                            gap="0px 30px"
                        >
                            <!-- eslint-disable sw-deprecation-rules/no-twigjs-blocks,vue/attributes-order -->
                            {% block sw_settings_customer_group_detail_content_card_name %}

                            <mt-text-field
                                v-model="userGroup.name"
                                name="sw-field--userGroup-name"
                                class="sw-settings-user-group-detail__name"
                                required
                                validation="required"
                                :label="$t('sw-settings-user-group.detail.fieldNameLabel')"
                                :error="userGroupNameError"
                                :placeholder="placeholder(userGroup, 'name', $t('sw-settings-user-group.detail.placeholderName'))"
                                :disabled="!acl.can('user_groups.editor') || undefined"
                            />
                            {% endblock %}

                            {% block sw_settings_customer_group_detail_content_card_display_gross %}
                            <sw-boolean-radio-group
                                v-model:value="userGroup.displayGross"
                                bordered
                                :label="$t('sw-settings-user-group.detail.fieldDisplayGrossLabel')"
                                :label-option-true="$t('sw-settings-user-group.detail.fieldDisplayGrossValues', {}, 1)"
                                :label-option-false="$t('sw-settings-user-group.detail.fieldDisplayGrossValues', {}, 0)"
                                :disabled="!acl.can('user_groups.editor') || undefined"
                            />
                            {% endblock %}

                            <!-- eslint-disable sw-deprecation-rules/no-twigjs-blocks,vue/attributes-order -->
                            {% block sw_settings_customer_group_detail_content_card_registration_form %}

                            <mt-switch
                                v-model="userGroup.registrationActive"
                                name="sw-field--userGroup-registrationActive"
                                class="sw-settings-user-group-detail__registration-form-switch"
                                :label="$t('sw-settings-user-group.detail.registrationForm')"
                                :disabled="!acl.can('user_groups.editor') || undefined"
                            />
                            {% endblock %}
                        </sw-container>
                    </template>
                </mt-card>
                {% endblock %}

                {% block sw_settings_customer_group_detail_content_registration_card %}
                <mt-card
                    v-if="userGroup && userGroup.registrationActive"
                    position-identifier="sw-settings-user-group-detail-content-registration-card"
                    :is-loading="isLoading"
                    :title="$t('sw-settings-user-group.registration.formTitle')"
                >
                    <div class="sw-settings-user-group-detail-content-registration-card__info-text">
                        {{ $t('sw-settings-user-group.registration.infoText') }}
                    </div>

                    {% block sw_settings_customer_group_detail_content_registration_card_title %}

                    <mt-text-field
                        v-model="userGroup.registrationTitle"
                        name="sw-field--userGroup-registrationTitle"
                        required
                        validation="required"
                        :label="$t('sw-settings-user-group.registration.title')"
                        :placeholder="placeholder(userGroup, 'registrationTitle', $t('sw-settings-user-group.registration.placeholderTitle'))"
                        :error="registrationTitleError"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                    />
                    {% endblock %}

                    {% block sw_settings_customer_group_detail_content_registration_card_introduction %}
                    <sw-text-editor
                        v-if="!feature.isActive('METEOR_TEXT_EDITOR')"
                        v-model:value="userGroup.registrationIntroduction"
                        :label="$t('sw-settings-user-group.registration.introduction')"
                        :placeholder="placeholder(userGroup, 'registrationIntroduction', $t('sw-settings-user-group.registration.placeholderIntroduction'))"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                        sanitize-input
                        sanitize-field-name="user_group_translation.registrationIntroduction"
                    />
                    <mt-text-editor
                        v-else
                        v-model="userGroup.registrationIntroduction"
                        :label="$t('sw-settings-user-group.registration.introduction')"
                        :placeholder="placeholder(userGroup, 'registrationIntroduction', $t('sw-settings-user-group.registration.placeholderIntroduction'))"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                        sanitize-input
                        sanitize-field-name="user_group_translation.registrationIntroduction"
                    />
                    {% endblock %}

                    {% block sw_settings_customer_group_detail_content_registration_card_seo_meta_description %}
                    <mt-textarea
                        v-model="userGroup.registrationSeoMetaDescription"
                        name="sw-field--userGroup-registrationSeoMetaDescription"
                        :label="$t('sw-settings-user-group.registration.seoMetaDescription')"
                        :placeholder="placeholder(userGroup, 'registrationSeoMetaDescription', $t('sw-settings-user-group.registration.placeholderSeoMetaDescription'))"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                    />
                    {% endblock %}

                    {% block sw_settings_customer_group_detail_content_registration_card_only_companies_can_register %}

                    <mt-switch
                        v-model="userGroup.registrationOnlyCompanyRegistration"
                        name="sw-field--userGroup-registrationOnlyCompanyRegistration"
                        class="sw-settings-user-group-detail__registration-only-companies-can-register"
                        :label="$t('sw-settings-user-group.registration.onlyCompaniesCanRegister')"
                        :help-text="$t('sw-settings-user-group.registration.onlyCompaniesCanRegisterHelpText')"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                    />
                    {% endblock %}

                </mt-card>
                {% endblock %}

                {% block sw_settings_customer_group_detail_content_registration_url_card %}
                <mt-card
                    v-if="userGroup && userGroup.registrationActive"
                    position-identifier="sw-settings-user-group-detail-content-registration-url-card"
                    :is-loading="isLoading"
                    :title="$t('sw-settings-user-group.registration.linkUrlsTitle')"
                >

                    {% block sw_settings_customer_group_detail_content_registration_url_card_channel %}
                    <sw-entity-multi-select
                        v-model:entity-collection="userGroup.registrationSalesChannels"
                        name="sw-field--userGroup-registrationSalesChannels"
                        class="sw-settings-user-group-detail__sales-channel"
                        :label="$t('sw-settings-user-group.registration.availabilitySalesChannel')"
                        :disabled="!acl.can('user_groups.editor') || undefined"
                        :criteria="registrationSalesChannelCriteria"
                    />
                    {% endblock %}

                    {% block sw_settings_customer_group_detail_content_registration_technical_urls %}

                    <mt-text-field
                        v-if="userGroupId"
                        v-model="technicalUrl"
                        name="sw-field--technicalUrl"
                        :label="$t('sw-settings-user-group.registration.technicalUrl')"
                        :copyable="true"
                        :disabled="true"
                        :help-text="$t('sw-settings-user-group.registration.technicalUrlHelpText')"
                    />
                    {% endblock %}

                    <mt-banner
                        v-if="userGroup.registrationSalesChannels?.length > 0"
                        variant="info"
                    >
                        {{ $t('sw-settings-user-group.registration.domainBanner') }}
                    </mt-banner>

                    {% block sw_settings_customer_group_detail_content_registration_url_card_seo_url %}
                    <template v-for="channel in userGroup.registrationSalesChannels">
                        <template v-for="domain in channel.domains">
                            <template v-for="seoUrl in channel.seoUrls">
                                <template v-if="domain.languageId === seoUrl.languageId">
                                {% block sw_settings_customer_group_detail_content_registration_url_card_seo_url_inner %}
                                    <mt-text-field
                                        :key="`${seoUrl.id}-${domain.id}`"
                                        :model-value="`${domain.url}/${seoUrl.seoPathInfo}`"
                                        :label="$t('sw-settings-user-group.registration.seoUrlLabel', {
                                            channelName: channel.translated.name,
                                            languageName: seoUrl.language.name
                                        })"
                                        :copyable="true"
                                        :disabled="true"
                                    />
                                {% endblock %}
                                </template>
                            </template>
                        </template>
                    </template>
                    {% endblock %}
                </mt-card>
                {% endblock %}

                {% block sw_settings_customer_group_detail_custom_field_sets %}
                <mt-card
                    v-if="showCustomFields"
                    position-identifier="sw-settings-user-group-detail-custom-field-sets"
                    :title="$t('sw-settings-custom-field.general.mainMenuItemGeneral')"
                    :is-loading="isLoading"
                >
                    <sw-custom-field-set-renderer
                        :entity="userGroup"
                        :disabled="!acl.can('user_groups.editor')"
                        :sets="customFieldSets"
                    />
                </mt-card>
                {% endblock %}
            </template>
        </sw-card-view>
    </template>
    {% endblock %}

</sw-page>
{% endblock %}
