{% block sw_customer_default_addresses %}
<sw-container
    class="sw-user-default-addresses"
    columns="repeat(auto-fit, minmax(250px, 1fr))"
>
    {% block sw_customer_default_addresses_shipping %}
    <sw-card-section
        v-if="user.defaultShippingAddress.id"
        divider="right"
    >
        {% block sw_customer_default_addresses_shipping_postal %}
        <sw-address
            :address="user.defaultShippingAddress"
            :headline="$t('sw-user.detailBase.titleDefaultShippingAddress')"
            :show-edit-button="userEditMode"
            :edit-link="defaultShippingAddressLink"
            :formatting-address="formattingShippingAddress"
        />
        {% endblock %}
    </sw-card-section>
    {% endblock %}

    {% block sw_customer_default_addresses_billing %}
    <sw-card-section v-if="user.defaultBillingAddress.id">
        {% block sw_customer_default_addresses_billing_postal %}
        <sw-address
            :address="user.defaultBillingAddress"
            :headline="$t('sw-user.detailBase.titleDefaultBillingAddress')"
            :show-edit-button="userEditMode"
            :edit-link="defaultBillingAddressLink"
            :formatting-address="formattingBillingAddress"
        />
        {% endblock %}
    </sw-card-section>
    {% endblock %}
</sw-container>
{% endblock %}
