{% block sw_settings_contena_updates_wizard %}
<sw-page class="sw-settings-contena-updates-wizard">
    {% block sw_settings_contena_updates_wizard_smart_bar_header %}
    <template #smart-bar-header>
        <h2>
            {{ $t('sw-settings-contena-updates.general.title') }}
        </h2>
    </template>
    {% endblock %}

    <template #content>
        <div class="sw-settings-contena-updates-wizard__content">
        {% block sw_settings_contena_updates_wizard_content %}
            <sw-card-view>
                {% block sw_settings_contena_updates_wizard_version_card %}
                <mt-card
                    class="sw-settings-contena-updates-wizard__version-card"
                    position-identifier="sw-settings-contena-updates-version"
                    :title="$t('sw-settings-contena-updates.versionCard.title')"
                    :is-loading="isLoading"
                >
                    {% block sw_settings_contena_updates_wizard_license_banner %}
                    <mt-banner
                        v-if="licenseCheckFailed"
                        class="sw-settings-contena-updates-wizard__license-banner"
                        variant="critical"
                        :title="$t('sw-settings-contena-updates.license.bannerTitle')"
                    >
                        <span v-html="$t('sw-settings-contena-updates.license.bannerMessage')"></span>
                    </mt-banner>
                    {% endblock %}

                    <template #headerRight>
                        <mt-badge
                            v-if="!isLoading"
                            class="sw-settings-contena-updates-version__status-badge"
                            :variant="updateStatusBadgeVariant"
                            size="s"
                            status-indicator
                        >
                            {{ updateStatusBadgeLabel }}
                        </mt-badge>
                    </template>

                    {% block sw_settings_contena_updates_wizard_check_failed %}
                    <mt-banner
                        v-if="!isLoading && updateCheckFailed"
                        class="sw-settings-contena-updates-wizard__check-failed"
                        variant="critical"
                        :title="$t('sw-settings-contena-updates.notifications.checkFailed')"
                    >
                        <mt-button
                            class="sw-settings-contena-updates-wizard__retry-check"
                            variant="secondary"
                            size="small"
                            @click="createdComponent"
                        >
                            {{ $t('sw-settings-contena-updates.versionCard.retryCheck') }}
                        </mt-button>
                    </mt-banner>
                    {% endblock %}

                    <div
                        v-if="isUpdateAvailable"
                        class="sw-settings-contena-updates-version"
                    >
                        <div class="sw-settings-contena-updates-version__content">
                            <dl class="sw-settings-contena-updates-version__versions">
                                <mt-text
                                    as="dt"
                                    size="xs"
                                    color="color-text-secondary-default"
                                >
                                    {{ $t('sw-settings-contena-updates.versionCard.currentVersionLabel') }}
                                </mt-text>
                                <mt-text
                                    as="dd"
                                    size="xs"
                                    weight="medium"
                                    class="sw-settings-contena-updates-version__current-version"
                                >
                                    {{ currentVersion }}
                                </mt-text>
                                <mt-text
                                    as="dt"
                                    size="xs"
                                    color="color-text-secondary-default"
                                >
                                    {{ $t('sw-settings-contena-updates.versionCard.newVersionLabel') }}
                                </mt-text>
                                <mt-text
                                    as="dd"
                                    size="xs"
                                    weight="medium"
                                    class="sw-settings-contena-updates-version__new-version"
                                >
                                    {{ updateInfo.version }}
                                </mt-text>
                            </dl>

                            <sw-external-link
                                class="sw-settings-contena-updates-version__changelog-link"
                                :href="changelogUrl"
                            >
                                {{ $t('sw-settings-contena-updates.versionCard.changelogLink') }}
                            </sw-external-link>
                        </div>
                    </div>

                    {% block sw_settings_contena_updates_wizard_up_to_date %}
                    <mt-empty-state
                        v-else-if="!isLoading && !updateCheckFailed"
                        class="sw-settings-contena-updates-up-to-date"
                        :centered="true"
                        icon="regular-check-circle"
                        :headline="$t('sw-settings-contena-updates.versionCard.upToDateTitle')"
                        :description="$t('sw-settings-contena-updates.versionCard.upToDateDescription', { version: currentVersion })"
                    />
                    {% endblock %}

                    {% block sw_settings_contena_updates_wizard_update_methods %}
                    <mt-inset
                        v-if="isUpdateAvailable"
                        class="sw-settings-contena-updates-methods"
                    >
                    {% block sw_settings_contena_updates_wizard_methods_headline %}
                        <mt-text
                            as="span"
                            size="s"
                            weight="semibold"
                            class="sw-settings-contena-updates-methods-headline"
                        >
                            {{ $t('sw-settings-contena-updates.versionCard.methodsHeadline') }}
                        </mt-text>
                    {% endblock %}

                    {% block sw_settings_contena_updates_wizard_cli_method %}
                        <div class="sw-settings-contena-updates-cli-method">
                            <div class="sw-settings-contena-updates-cli-method__header">
                                <mt-text
                                    as="span"
                                    size="xs"
                                    weight="semibold"
                                    class="sw-settings-contena-updates-cli-method__title"
                                >
                                    {{ $t('sw-settings-contena-updates.methodModal.cliTitle') }}
                                </mt-text>

                                <mt-badge
                                    class="sw-settings-contena-updates-cli-method__recommended-badge"
                                    variant="info"
                                    size="s"
                                >
                                    {{ $t('sw-settings-contena-updates.versionCard.cliRecommendedBadge') }}
                                </mt-badge>
                            </div>

                            <mt-text
                                as="span"
                                size="xs"
                                color="color-text-secondary-default"
                                class="sw-settings-contena-updates-cli-method__description"
                            >
                                {{ $t('sw-settings-contena-updates.methodModal.cliDescription') }}
                                {{ $t('sw-settings-contena-updates.methodModal.cliInstallHint') }}
                            </mt-text>

                            <span class="sw-settings-contena-updates-cli-method__command">
                                <code>{{ cliUpgradeCommand }}</code>
                                <mt-tooltip :content="cliCommandCopied ? $t('global.sw-field-copyable.tooltip.wasCopied') : $t('global.sw-field-copyable.tooltip.canCopy')">
                                    <template #default="tooltipProps">
                                        <mt-button
                                            v-bind="tooltipProps"
                                            class="sw-settings-contena-updates-cli-method__copy-button"
                                            size="small"
                                            variant="tertiary"
                                            square
                                            :aria-label="$t('global.default.copy')"
                                            @click="copyCliCommand"
                                        >
                                            <template #iconFront>
                                                <mt-icon
                                                    :name="cliCommandCopied ? 'regular-checkmark' : 'regular-copy'"
                                                    size="16px"
                                                />
                                            </template>
                                        </mt-button>
                                    </template>
                                </mt-tooltip>
                            </span>

                            <sw-external-link
                                class="sw-settings-contena-updates-cli-method__install-link"
                                :href="cliInstallUrl"
                            >
                                {{ $t('sw-settings-contena-updates.methodModal.cliInstallLink') }}
                            </sw-external-link>
                        </div>
                    {% endblock %}

                    {% block sw_settings_contena_updates_wizard_method_divider %}
                        <div
                            class="sw-settings-contena-updates-method-divider"
                            role="separator"
                        >
                            <mt-text
                                as="span"
                                size="xs"
                                color="color-text-secondary-default"
                            >
                                {{ $t('sw-settings-contena-updates.versionCard.methodDivider') }}
                            </mt-text>
                        </div>
                    {% endblock %}

                    {% block sw_settings_contena_updates_wizard_web_installer %}
                        <div class="sw-settings-contena-updates-web-installer">
                            <div class="sw-settings-contena-updates-web-installer__content">
                                <mt-text
                                    as="span"
                                    size="xs"
                                    weight="semibold"
                                    class="sw-settings-contena-updates-web-installer__title"
                                >
                                    {{ $t('sw-settings-contena-updates.versionCard.webInstallerTitle') }}
                                </mt-text>
                                <mt-text
                                    as="span"
                                    size="xs"
                                    color="color-text-secondary-default"
                                    class="sw-settings-contena-updates-web-installer__description"
                                >
                                    {{ $t('sw-settings-contena-updates.versionCard.webInstallerDescription') }}
                                </mt-text>
                            </div>

                            <mt-tooltip
                                v-if="!updatePossible"
                                :content="updateButtonTooltipMessage"
                                placement="bottom"
                            >
                                <template #default="tooltipProps">
                                    <mt-button
                                        v-bind="tooltipProps"
                                        :disabled="true"
                                        variant="primary"
                                        class="sw-settings-contena-updates-wizard__start-update"
                                        size="small"
                                    >
                                        {{ $t('sw-settings-contena-updates.infos.startUpdate') }}
                                    </mt-button>
                                </template>
                            </mt-tooltip>

                            <mt-button
                                v-else
                                :is-loading="updaterIsRunning"
                                variant="primary"
                                class="sw-settings-contena-updates-wizard__start-update"
                                size="small"
                                @click="updateModalShown = true"
                            >
                                {{ $t('sw-settings-contena-updates.infos.startUpdate') }}
                            </mt-button>
                        </div>
                    {% endblock %}
                    </mt-inset>
                    {% endblock %}
                </mt-card>
                {% endblock %}

                <sw-settings-contena-updates-extensions
                    v-if="isUpdateAvailable && !isLoading && !updateCheckFailed"
                    :extensions="extensions"
                    :is-loading="isLoading"
                />
            </sw-card-view>

            <sw-modal
                v-if="updaterIsRunning"
                :title="$t('sw-settings-contena-updates.cards.updating')"
                variant="small"
                class="sw-contena-updates-progressbar"
            >
                <div class="progress-wrapper">
                    <mt-progress-bar
                        :model-value="progressbarValue"
                        :max-value="100"
                    />
                    <span class="progress-title">
                        <p v-if="step === 'download'">{{ $t('sw-settings-contena-updates.infos.progress.download') }}</p>
                        <p v-if="step === 'unpack'">{{ $t('sw-settings-contena-updates.infos.progress.unpack') }}</p>
                        <p v-if="step === 'deactivate'">{{ $t('sw-settings-contena-updates.infos.progress.deactivate') }}</p>
                    </span>
                </div>
            </sw-modal>

            <sw-modal
                v-if="updateModalShown"
                class="sw-settings-contena-updates-check__start-update"
                :title="$t('sw-settings-contena-updates.methodModal.title')"
                :subtitle="$t('sw-settings-contena-updates.methodModal.subtitle')"
                @modal-close="updateModalShown = false"
            >
                {% block sw_settings_contena_updates_wizard_method_warnings %}
                <mt-banner
                    v-if="displayUnknownExtensionsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-contena-updates.updateModal.messageNotInStore') }}
                </mt-banner>

                <mt-banner
                    v-if="displayIncompatibleExtensionsWarning"
                    variant="attention"
                >
                    {{ $t('sw-settings-contena-updates.updateModal.messageIncompatible') }}
                </mt-banner>
                {% endblock %}

                {% block sw_settings_contena_updates_wizard_method_plugin_options %}
                <sw-radio-field
                    v-if="displayIncompatibleExtensionsWarning"
                    v-model:value="chosenExtensionBehaviour"
                    :options="[
                        {'value': 'all', 'name': optionDeactivateAllTranslation },
                        {'value': 'notCompatible', 'name': optionDeactivateIncompatibleTranslation },
                        {'value': '', 'name': $t('sw-settings-contena-updates.extensions.actions.deactivateNone')}]"
                />
                {% endblock %}

                <template #modal-footer>
                    <mt-checkbox
                        v-model:checked="checkedBackupCheckbox"
                        class="sw-settings-contena-updates-check__start-update-backup-checkbox"
                        :label="$t('sw-settings-contena-updates.updateModal.backupLabel')"
                    />

                    <div class="sw-settings-contena-updates-check__start-update-actions">
                        <mt-button
                            size="small"
                            variant="secondary"
                            @click="updateModalShown = false"
                        >
                            {{ $t('global.default.cancel') }}
                        </mt-button>

                        <mt-button
                            :disabled="!checkedBackupCheckbox"
                            variant="primary"
                            size="small"
                            class="sw-settings-contena-updates-check__start-update-button"
                            @click="startUpdateProcess()"
                        >
                            {{ $t('sw-settings-contena-updates.methodModal.actions.continue') }}
                        </mt-button>
                    </div>
                </template>
            </sw-modal>
        {% endblock %}
        </div>
    </template>
</sw-page>
{% endblock %}
