{% block sw_purchase_price_field %}
<sw-price-field
    name="sw-purchase-price-field"
    :value="purchasePrice"
    class="sw-purchase-price-field"
    :tax-rate="taxRate"
    :disabled="disabled"
    :gross-label="$t('sw-blog.priceForm.labelPurchasePriceGross')"
    :net-label="$t('sw-blog.priceForm.labelPurchasePriceNet')"
    :compact="compact"
    :label="label"
    :error="error"
    :currency="currency"
    @change="purchasePriceChanged"
/>
{% endblock %}
