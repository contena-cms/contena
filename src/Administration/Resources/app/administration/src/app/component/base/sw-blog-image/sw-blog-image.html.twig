{% block sw_product_image %}
<div
    class="sw-blog-image"
    :class="blogImageClasses"
>
    <template v-if="!isPlaceholder">
        {% block sw_product_image_preview %}
        <sw-media-preview-v2
            class="sw-blog-image__image"
            :source="mediaId"
            :hide-tooltip="false"
        />

        <sw-label
            v-if="showCoverLabel && isCover"
            class="sw-blog-image__cover-label"
            variant="primary"
            size="medium"
            appearance="pill"
        >
            {{ $t('sw-blog.mediaForm.coverSubline') }}
        </sw-label>

        {# @experimental stableVersion:v6.8.0 feature:SPATIAL_BASES #}
        {% block sw_product_image_preview_spatial_labels %}
        <sw-label
            v-if="isSpatial"
            class="sw-blog-image__spatial-label"
            variant="neutral-reversed"
            size="medium"
            appearance="pill"
        >
            <!-- eslint-disable-next-line vuejs-accessibility/label-has-for -->
            <label
                v-if="isArReady"
                class="sw-label__ar-ready"
            >
                {{ $t('sw-blog.mediaForm.arSubline') }}
            </label>
            <!-- eslint-disable-next-line vuejs-accessibility/label-has-for -->
            <label
                v-else
                class="sw-label__spatial"
            >
                {{ $t('sw-blog.mediaForm.spatialSubline') }}
            </label>
        </sw-label>
        {% endblock %}

        {% endblock %}
        <sw-context-button class="sw-blog-image__context-button">
            {% block sw_product_image_context %}
            {% block sw_product_image_context_cover_action %}
            <sw-context-menu-item
                v-if="showCoverLabel && !isCover"
                class="sw-blog-image__button-cover"
                @click="$emit('sw-blog-image-cover')"
            >
                {{ $t('global.sw-blog-image.context.buttonAsCover') }}
            </sw-context-menu-item>
            {% endblock %}

            {% block sw_product_image_context_delete_action %}
            <sw-context-menu-item
                variant="danger"
                class="sw-blog-image__button-delete"
                @click="$emit('sw-blog-image-delete')"
            >
                {{ $t('global.default.remove') }}
            </sw-context-menu-item>
            {% endblock %}
            {% endblock %}
        </sw-context-button>
    </template>
    <div
        v-else
        class="is--invalid-drag"
    >
        {% block sw_product_image_placeholder %}
        <mt-icon
            class="sw-blog-image__placeholder-icon"
            :name="'regular-image'"
            size="16px"
        />
        {% endblock %}
    </div>
</div>
{% endblock %}
