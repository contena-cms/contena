{
    "$schema": "https://json.schemastore.org/tsconfig",
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2023",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": true,
        "checkJs": false,
        "isolatedModules": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "types": [],
        "paths": {
            "vue": ["../node_modules/vue"],
            "@vue/*": ["../node_modules/@vue/*"],
            "src/*": ["../src/*"],
            "vuex": ["../node_modules/vuex/types/index.d.ts"],
            "@contena-ag/meteor-admin-sdk/es/*": ["../node_modules/@contena-ag/meteor-admin-sdk/es/*"],
            "@contena-ag/meteor-component-library/dist/*": ["../node_modules/@contena-ag/meteor-component-library/dist/*"]
        }
    }
}
