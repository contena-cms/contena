<div style="font-family:arial; font-size:12px;">
    <p>
        Ein Blog-Kommentar wurde soeben {% if commentFormData.id is defined %}bearbeitet{% else %}abgegeben{% endif %}.<br/>
        <br/>
        {% if commentFormData.name is defined %}
            Name: {{ commentFormData.name }}
            <br/>
        {% endif %}
        {% if commentFormData.email is defined %}
            E-Mail-Adresse: {{ commentFormData.email }}<br/>
            <br>
        {% endif %}
        {% if blog.translated.name is defined %}
            Produkt: {{ blog.translated.name }}<br/>
            <br>
        {% endif %}
        <br/>
        Titel: {{ commentFormData.title }}<br/>
        <br/>
        Inhalt:<br/>
        {{ commentFormData.content|nl2br }}<br/>
    </p>
</div>
