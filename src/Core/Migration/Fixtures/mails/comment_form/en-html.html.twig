<div style="font-family:arial; font-size:12px;">
    <p>
        A blog comment has just been {% if commentFormData.id is defined %}edited{% else %}sent{% endif %}.<br/>
        <br/>
        {% if commentFormData.name is defined %}
            Name: {{ commentFormData.name }}
            <br/>
        {% endif %}
        {% if commentFormData.email is defined %}
            Email address: {{ commentFormData.email }}<br/>
            <br>
        {% endif %}
        {% if blog.translated.name is defined %}
            Blog: {{ blog.translated.name }}<br/>
            <br>
        {% endif %}
        <br/>
        Title: {{ commentFormData.title }}<br/>
        <br/>
        Content:<br/>
        {{ commentFormData.content|nl2br }}<br/>
    </p>
</div>
