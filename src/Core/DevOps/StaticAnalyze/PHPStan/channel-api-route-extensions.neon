        - Contena\Core\System\Channel\Channel\StoreApiInfoController::openApiSchema
        - Contena\Core\System\Channel\Channel\StoreApiInfoController::stoplightIoInfoHtml

    # Route methods that keep their abstract route class for backwards compatibility.
    # They publish extension events like every other route. Remove an entry together with its abstract route class.
    contenaStoreApiRouteMethodsWithAbstractContract:
