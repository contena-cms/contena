parameters:
    contenaLegacyStoreApiRouteMethods:
        # Endpoints that publish no extension event on purpose: infrastructure and test routes.
        # New store-api routes must follow the ADR, do not add them here.
        - Contena\Core\Content\BlogExport\Channel\ExportController::index
        - Contena\Core\Content\Test\TestNavigationSeoUrlRoute::route
        - Contena\Core\Content\Test\TestProductSeoUrlRoute::route
        - Contena\Core\Framework\App\Api\AppJWTGenerateRoute::generate
        - Contena\Core\Framework\Mcp\Controller\StoreApiMcpServerController::handle
