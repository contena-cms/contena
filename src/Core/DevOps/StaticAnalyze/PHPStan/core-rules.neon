includes:
    - tagged-service-contracts.php
    - store-api-route-extensions.neon

parameters:
    contenaTaggedServiceContractAdditionalTagContracts: []

parametersSchema:
    contenaLegacyStoreApiRouteMethods: listOf(string())
    contenaStoreApiRouteMethodsWithAbstractContract: listOf(string())
    contenaTaggedServiceContractTagContracts: arrayOf(anyOf(string(), listOf(string())), string())
    contenaTaggedServiceContractAdditionalTagContracts: arrayOf(anyOf(string(), listOf(string())), string())

rules:
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedEntityConstructionRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedServiceDefinitionFeatureTagRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedServiceFeatureTagRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\FeatureFlagVersionRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\FuturePropertyCompatibilityRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\FuturePropertyVisibilityChangeRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\NoBCPlanningDeprecationRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\NoClassAliasExpressionUsageRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\NoClassAliasUsageRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Internal\InternalClassRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Internal\InternalMethodRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Migration\AddColumnRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Migration\NoAfterStatementRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Migration\NoDropStatementInUpdateRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Migration\NonStandardFkGuardRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\AbstractClassUsageRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\DecorationPatternRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\PackageAnnotationRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\ServiceDefinitionRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\DomainExceptionRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\ExtensionRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoNewRequestInFrontendRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\AclValidPermissionsInMethodRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\AclValidPermissionsInRouteAttributesRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\ContenaNamespaceStyleRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\AttributeFinalRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\NameConstantEntityDefinition
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\FrontendRouteUsageRule
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\NoRuntimeExceptionInDomainExceptionsRule
    # core-only until the commercial repositories have swept their own reflection backlogs
    - Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\NoReflectionOnNonPublicMethodsRule

services:
    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedExceptionPattern

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedFrameworkMethodPattern

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedServiceDecoratorPattern

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedMethodsThrowDeprecationRule
        arguments:
            deprecationPatterns:
                - @Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedExceptionPattern
                - @Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedFrameworkMethodPattern
                - @Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\DeprecatedServiceDecoratorPattern
        tags:
            - phpstan.rules.rule

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\StoreApiRouteExtensionRule
        arguments:
            legacyRouteMethods: %contenaLegacyStoreApiRouteMethods%
            abstractContractRouteMethods: %contenaStoreApiRouteMethodsWithAbstractContract%
        tags:
            - phpstan.rules.rule

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\ClassAliasMap

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Deprecation\BCChangeAttributeUsageRule
        arguments:
            containerXmlPath: %symfony.containerXmlPath%
        tags:
            - phpstan.rules.rule

    # gated to the core test namespaces inside the rule; downstream repositories carry their own package taxonomy
    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\TestPackageMatchRule
        arguments:
            projectDir: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule

    # gated to the core unit suite inside the rule; downstream repositories run their own phpunit configurations
    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\Tests\CoversTargetInCoverageSourceRule
        arguments:
            projectDir: %currentWorkingDirectory%
        tags:
            - phpstan.rules.rule

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\TaggedServiceContractRule
        arguments:
            tagContracts: %contenaTaggedServiceContractTagContracts%
            additionalTagContracts: %contenaTaggedServiceContractAdditionalTagContracts%
            containerXmlPath: %symfony.containerXmlPath%
        tags:
            - phpstan.rules.rule

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\ServiceDefinitionCollector
        tags:
            - phpstan.collector

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\MessageHandlerFinalRule
        tags:
            - phpat.test

    -
        class: Contena\Core\DevOps\StaticAnalyze\PHPStan\Rules\RestrictNamespacesRule
        tags:
            - phpat.test
