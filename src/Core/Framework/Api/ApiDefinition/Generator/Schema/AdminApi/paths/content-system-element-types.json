{
    "openapi": "3.1.0",
    "info": {
        "title": "Content System Element Types",
        "version": "1.0.0"
    },
    "paths": {
        "\/_info\/content-system-element-types.json": {
            "get": {
                "tags": [
                    "System Info & Health Check"
                ],
                "summary": "Get content system element types",
                "description": "Get all registered content system element type specifications.",
                "operationId": "content-system-element-types",
                "responses": {
                    "200": {
                        "description": "Returns a list of all registered content system element types.",
                        "content": {
                            "application\/json": {
                                "schema": {
                                    "type": "object",
                                    "required": ["types", "styleOptions"],
                                    "properties": {
                                        "types": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "required": ["name", "label", "description", "source", "icon", "category", "copilot", "properties", "slots", "bindingSpecifications"],
                                                "properties": {
                                                    "name": {
                                                        "type": "string",
                                                        "description": "Unique type name."
                                                    },
                                                    "label": {
                                                        "type": "string",
                                                        "description": "Human-readable label."
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "description": "Human-readable description."
                                                    },
                                                    "source": {
                                                        "type": "string",
                                                        "description": "Source identifier (for example core, bundle:MyBundle, or plugin:MyPlugin)."
                                                    },
                                                    "icon": {
                                                        "type": ["string", "null"],
                                                        "description": "Optional icon identifier."
                                                    },
                                                    "category": {
                                                        "type": ["string", "null"],
                                                        "description": "Optional category for grouping."
                                                    },
                                                    "copilot": {
                                                        "type": "object",
                                                        "required": ["summary", "hints"],
                                                        "properties": {
                                                            "summary": {
                                                                "type": "string"
                                                            },
                                                            "hints": {
                                                                "type": "array",
                                                                "items": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "properties": {
                                                        "type": "object",
                                                        "description": "Map of property name to property specification.",
                                                        "additionalProperties": {
                                                            "type": "object",
                                                            "required": ["type", "translatable", "enum", "default", "properties", "required", "title", "description", "adminUI"],
                                                            "properties": {
                                                                "type": {
                                                                    "type": ["string", "array"],
                                                                    "items": {
                                                                        "type": "string"
                                                                    },
                                                                    "description": "Primitive type name, FQCN, or a list of accepted type names."
                                                                },
                                                                "translatable": {
                                                                    "type": "boolean"
                                                                },
                                                                "enum": {
                                                                    "type": ["array", "null"],
                                                                    "items": {
                                                                        "type": ["string", "integer", "number", "boolean"]
                                                                    }
                                                                },
                                                                "default": {
                                                                    "type": ["string", "integer", "number", "boolean", "null"]
                                                                },
                                                                "properties": {
                                                                    "type": ["object", "null"],
                                                                    "description": "Nested property specifications for object-like values.",
                                                                    "additionalProperties": {
                                                                        "type": "object"
                                                                    }
                                                                },
                                                                "required": {
                                                                    "type": "boolean"
                                                                },
                                                                "title": {
                                                                    "type": "string"
                                                                },
                                                                "description": {
                                                                    "type": "string"
                                                                },
                                                                "adminUI": {
                                                                    "type": ["object", "null"]
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "slots": {
                                                        "type": "array",
                                                        "items": {
                                                            "type": "object",
                                                            "required": ["name", "maxElements", "allowList", "description"],
                                                            "properties": {
                                                                "name": {
                                                                    "type": "string"
                                                                },
                                                                "maxElements": {
                                                                    "type": ["integer", "null"]
                                                                },
                                                                "allowList": {
                                                                    "type": "array",
                                                                    "items": {
                                                                        "type": "string"
                                                                    }
                                                                },
                                                                "description": {
                                                                    "type": "string"
                                                                }
                                                            }
                                                        }
                                                    },
                                                    "bindingSpecifications": {
                                                        "type": "object",
                                                        "description": "Source-qualified binding specifications applicable to this type.",
                                                        "additionalProperties": {
                                                            "type": "object",
                                                            "required": ["id", "type", "label", "default", "resolves", "inputs"],
                                                            "properties": {
                                                                "id": {
                                                                    "type": "string"
                                                                },
                                                                "type": {
                                                                    "type": "string"
                                                                },
                                                                "label": {
                                                                    "type": "string"
                                                                },
                                                                "default": {
                                                                    "type": "boolean"
                                                                },
                                                                "resolves": {
                                                                    "type": "object",
                                                                    "additionalProperties": {
                                                                        "type": "object",
                                                                        "required": ["loader", "config"],
                                                                        "properties": {
                                                                            "loader": {
                                                                                "type": "string"
                                                                            },
                                                                            "config": {
                                                                                "type": "object"
                                                                            }
                                                                        }
                                                                    }
                                                                },
                                                                "inputs": {
                                                                    "type": "object",
                                                                    "additionalProperties": {
                                                                        "type": "object",
                                                                        "required": ["required"],
                                                                        "properties": {
                                                                            "default": {
                                                                                "type": ["string", "integer", "number", "boolean", "array", "object", "null"]
                                                                            },
                                                                            "required": {
                                                                                "type": "boolean"
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "styleOptions": {
                                            "type": "object",
                                            "description": "Universal style options keyed by their wire name.",
                                            "additionalProperties": {
                                                "type": "object",
                                                "required": ["type", "enum", "range", "maxLength", "default", "adminUI", "breakpointAware"],
                                                "properties": {
                                                    "type": {
                                                        "type": "string"
                                                    },
                                                    "enum": {
                                                        "type": ["array", "null"],
                                                        "items": {
                                                            "type": ["string", "integer", "number", "boolean"]
                                                        }
                                                    },
                                                    "range": {
                                                        "type": ["object", "null"],
                                                        "properties": {
                                                            "min": {
                                                                "type": ["integer", "number"]
                                                            },
                                                            "max": {
                                                                "type": ["integer", "number"]
                                                            }
                                                        }
                                                    },
                                                    "maxLength": {
                                                        "type": ["integer", "null"]
                                                    },
                                                    "default": {
                                                        "type": ["string", "integer", "number", "boolean", "null"]
                                                    },
                                                    "adminUI": {
                                                        "type": ["object", "null"]
                                                    },
                                                    "breakpointAware": {
                                                        "type": "boolean"
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
