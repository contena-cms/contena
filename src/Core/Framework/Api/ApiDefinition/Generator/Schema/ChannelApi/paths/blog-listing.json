{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/blog-listing/{categoryId}": {
            "post": {
                "tags": [
                    "Blog"
                ],
                "summary": "Fetch a blog listing by category",
                "description": "Fetches a blog listing for a specific category. It also provides filters, sortings and aggregations, analogous to the /search endpoint.",
                "operationId": "readBlogListing",
                "parameters": [
                    {
                        "name": "categoryId",
                        "in": "path",
                        "description": "Identifier of a category.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "p",
                        "in": "query",
                        "description": "The page number to fetch.",
                        "required": false,
                        "schema": {
                            "type": "integer"
                        }
                    },
                    {
                        "name": "ct-include-seo-urls",
                        "in": "header",
                        "description": "Determines if the response must contain a SeoUrl entity for a blog entity",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "ct-include-search-info",
                        "in": "header",
                        "description": "Controls whether API search information is included in the response. Default is 1 (enabled), will be 0 (disabled) in the next major version.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "0",
                                "1"
                            ],
                            "default": "1"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/swLanguageId"
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    {
                                        "$ref": "#/components/schemas/BlogListingCriteria"
                                    },
                                    {
                                        "$ref": "#/components/schemas/BlogListingFlags"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Returns a blog listing containing matching blogs and the fields required to display the listing.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BlogListingResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    },
                    "404": {
                        "$ref": "#/components/responses/404",
                        "description": "No category exists for the given `categoryId` in this channel."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            },
            "get": {
                "tags": [
                    "Blog"
                ],
                "summary": "Fetch a blog listing by category",
                "description": "Fetches a blog listing for a specific category. It also provides filters, sortings and aggregations, analogous to the /search endpoint.",
                "operationId": "readBlogListingGet",
                "parameters": [
                    {
                        "name": "categoryId",
                        "in": "path",
                        "description": "Identifier of a category.",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "ct-include-seo-urls",
                        "in": "header",
                        "description": "Determines if the response must contain a SeoUrl entity for a blog entity",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "x-parameter-group": "blogListingCriteria"
                    },
                    {
                        "x-parameter-group": "blogListingFlags"
                    },
                    {
                        "$ref": "#/components/parameters/CompressedCriteria"
                    },
                    {
                        "$ref": "#/components/parameters/swLanguageId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns a blog listing containing matching blogs and the fields required to display the listing.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BlogListingResult"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    },
                    "404": {
                        "$ref": "#/components/responses/404",
                        "description": "No category exists for the given `categoryId` in this channel."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        }
    }
}
