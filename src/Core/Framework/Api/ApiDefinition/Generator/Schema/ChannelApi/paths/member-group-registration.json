{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/member-group-registration/config/{memberGroupId}": {
            "get": {
                "tags": [
                    "Login & Registration"
                ],
                "summary": "Fetch registration settings for member group",
                "operationId": "getMemberGroupRegistrationInfo",
                "parameters": [
                    {
                        "name": "memberGroupId",
                        "in": "path",
                        "description": "Member group id",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/swLanguageId"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Returns the member group including registration settings.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MemberGroup"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    },
                    "404": {
                        "$ref": "#/components/responses/404",
                        "description": "No member group with the given id exists, or it has no registration form configured."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        }
    }
}
