              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400",
            "description": "The submitted data failed validation, e.g. a malformed email address or a frontend URL that does not belong to the channel."
          },
          "401": {
            "$ref": "#/components/responses/401",
            "description": "The `ct-access-key` header is missing. The response also uses this status when no member exists for the given email address in this channel."
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/swLanguageId"
          }
        ]
      }
