                                "minimum": 0
                            },
                            "p": {
                                "description": "Search result page",
                                "type": "integer",
                                "default": 1
                            },
                            "reduce-aggregations": {
                                "description": "Applies post-filters to aggregations. This parameter is a flag; its value has no effect.",
                                "oneOf": [
                                    {
                                        "type": "string"
                                    },
                                    {
                                        "type": "null"
                                    }
                                ]
                            }
                        }
                    }
                ]
            }
        }
    }
