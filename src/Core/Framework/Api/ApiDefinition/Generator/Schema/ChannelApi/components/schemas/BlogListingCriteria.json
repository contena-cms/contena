{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "BlogListingCriteria": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Criteria"
                    },
                    {
                        "type": "object",
                        "description": "Additional search parameters for blog listings",
                        "properties": {
                            "order": {
