{
    "openapi": "3.2.0",
    "info": [],
    "paths": {
        "/blog": {
            "post": {
                "tags": [
                    "Blog",
                    "Endpoints supporting Criteria "
                ],
                "summary": "Fetch a list of blogs",
                "description": "List blogs that match the given criteria. For performance reasons a limit should always be set.",
                "operationId": "readBlog",
                "parameters": [
                    {
                        "name": "ct-include-search-info",
                        "in": "header",
                        "description": "Controls whether API search information is included in the response. Default is 1 (enabled), will be 0 (disabled) in the next major version.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "0",
                                "1"
                            ],
                            "default": "1"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/ctLanguageId"
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    {
                                        "$ref": "#/components/schemas/Criteria"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/BlogListResponse"
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            },
            "get": {
                "tags": [
                    "Blog",
                    "Endpoints supporting Criteria "
                ],
                "summary": "Fetch a list of blogs",
                "description": "List blogs that match the given criteria. For performance reasons a limit should always be set.",
                "operationId": "readBlogGet",
                "parameters": [
                    {
                        "x-parameter-group": "criteria"
                    }
                ],
                "responses": {
                    "200": {
                        "$ref": "#/components/responses/BlogListResponse"
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        },
        "/blog/{blogId}": {
            "post": {
                "tags": [
                    "Blog"
                ],
                "summary": "Fetch a single blog",
                "description": "Loads a single blog with the corresponding content details.",
                "operationId": "readBlogDetail",
                "parameters": [
                    {
                        "name": "blogId",
                        "in": "path",
                        "description": "Blog ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "description": "Instructs Contena to try and resolve SEO URLs for the given navigation item",
                        "in": "header",
                        "name": "ct-include-seo-urls",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "name": "ct-include-search-info",
                        "in": "header",
                        "description": "Controls whether API search information is included in the response. Default is 1 (enabled), will be 0 (disabled) in the next major version.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "enum": [
                                "0",
                                "1"
                            ],
                            "default": "1"
                        }
                    },
                    {
                        "description": "Instructs Contena to skip loading the breadcrumb of the SEO category",
                        "in": "query",
                        "name": "skipBreadcrumb",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "description": "Builds the breadcrumb along the given category instead of the SEO category of the blog. Ignored when the category is not part of the blog's category tree or is not reachable in this channel.",
                        "in": "query",
                        "name": "referrerCategoryId",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "$ref": "#/components/parameters/ctLanguageId"
                    }
                ],
                "requestBody": {
                    "required": false,
                    "content": {
                        "application/json": {
                            "schema": {
                                "allOf": [
                                    {
                                        "$ref": "#/components/schemas/NoneFieldsCriteria"
                                    }
                                ]
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Detailed blog information",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BlogDetailResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    },
                    "404": {
                        "$ref": "#/components/responses/404",
                        "description": "No blog exists for the given `blogId` in this channel."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            },
            "get": {
                "tags": [
                    "Blog"
                ],
                "summary": "Fetch a single blog",
                "description": "Loads a single blog with the corresponding content details.",
                "operationId": "readBlogDetailGet",
                "parameters": [
                    {
                        "name": "blogId",
                        "in": "path",
                        "description": "Blog ID",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "description": "Instructs Contena to try and resolve SEO URLs for the given navigation item",
                        "in": "header",
                        "name": "ct-include-seo-urls",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "description": "Instructs Contena to skip loading the breadcrumb of the SEO category",
                        "in": "query",
                        "name": "skipBreadcrumb",
                        "required": false,
                        "schema": {
                            "type": "boolean"
                        }
                    },
                    {
                        "description": "Builds the breadcrumb along the given category instead of the SEO category of the blog. Ignored when the category is not part of the blog's category tree or is not reachable in this channel.",
                        "in": "query",
                        "name": "referrerCategoryId",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{32}$"
                        }
                    },
                    {
                        "x-parameter-group": "noneFieldsCriteria"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Detailed blog information",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BlogDetailResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/400",
                        "description": "The `Criteria` sent with the request is invalid, e.g. an unknown filter field, sorting field or association."
                    },
                    "401": {
                        "$ref": "#/components/responses/401",
                        "description": "The `ct-access-key` header is missing."
                    },
                    "404": {
                        "$ref": "#/components/responses/404",
                        "description": "No blog exists for the given `blogId` in this channel."
                    }
                },
                "security": [
                    {
                        "ApiKey": []
                    }
                ]
            }
        }
    }
}
