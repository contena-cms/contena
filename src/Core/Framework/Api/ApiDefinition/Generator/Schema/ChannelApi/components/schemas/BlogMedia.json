{
    "openapi": "3.2.0",
    "info": [],
    "paths": [],
    "components": {
        "schemas": {
            "BlogMedia": {
                "description": "Added since version: 6.0.0.0",
                "required": [
                    "media",
                    "id",
                    "blogId",
                    "mediaId"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "versionId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "blogId": {
                        "description": "Unique identity of the blog.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "blogVersionId": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "mediaId": {
                        "description": "Unique identity of the media.",
                        "type": "string",
                        "pattern": "^[0-9a-f]{32}$"
                    },
                    "position": {
                        "description": "The order of the images to be displayed for a blog.",
                        "type": "integer",
                        "format": "int64"
                    },
                    "customFields": {
                        "type": "object"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "media": {
                        "$ref": "#/components/schemas/Media"
                    }
                },
                "type": "object"
            }
        }
    }
}
