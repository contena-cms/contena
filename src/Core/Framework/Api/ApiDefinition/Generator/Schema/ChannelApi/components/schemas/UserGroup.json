                    },
                    "customFields": {
                        "type": "object"
                    },
                    "registrationActive": {
                        "description": "To enable the registration of partner user group.",
                        "type": "boolean"
                    },
                    "registrationTitle": {
                        "type": "string"
                    },
                    "registrationIntroduction": {
                        "type": "string"
                    },
