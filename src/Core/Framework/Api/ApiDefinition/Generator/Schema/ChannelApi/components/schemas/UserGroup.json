                    },
                    "registrationSeoMetaDescription": {
                        "type": "string"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time",
                        "readOnly": true
                    },
                    "translated": {
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "registrationIntroduction": {
                                "type": "string"
                            },
                            "registrationSeoMetaDescription": {
                                "type": "string"
                            },
                            "registrationTitle": {
                                "type": "string"
                            }
