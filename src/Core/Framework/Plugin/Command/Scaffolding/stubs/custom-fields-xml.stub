<?xml version="1.0" encoding="utf-8"?>
<custom-fields xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/contena/contena/trunk/src/Core/System/CustomField/Schema/custom-fields-1.0.xsd">
    <custom-field-set>
        <name>ct_example_set</name>
        <label>Example custom field set</label>
        <label lang="zh-CN">自定义字段集示例</label>
        <related-entities>
            <product/>
        </related-entities>
        <fields>
            <int name="ct_example_size">
                <label>Size</label>
                <label lang="zh-CN">尺寸</label>
                <position>1</position>
            </int>
        </fields>
    </custom-field-set>
</custom-fields>
