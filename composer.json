        "eslint:frontend:admin-modules": "Codestyle checks the Frontend's admin-modules JS files",
        "eslint:frontend:admin-modules:fix": "Codestyle checks the Frontend's admin-modules JS files and fixes them if possible",
        "eslint:acceptance": "Codestyle checks the acceptance test suite TS files",
        "eslint:acceptance:fix": "Codestyle checks the acceptance test suite TS files and fixes them if possible",
