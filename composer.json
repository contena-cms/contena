        "init:testdb": "Initializes the test database",
        "lint": "Shorthand for the composer commands 'stylelint', 'eslint', 'cs' and 'translation:lint'",
        "lint:snippets": "Validates Administration translations",
        "make:coverage": "Generate test coverage files for current branch",
        "npm:acceptance": " ",
        "npm:acceptance:bin": " ",
        "npm:admin": " ",
        "npm:admin:bin": " ",
        "npm:admin:check-license": "Check thrid-party dependency licenses for administration",
        "npm:component-library": " ",
        "npm:component-library:bin": " ",
        "npm:frontend": " ",
        "npm:frontend:admin-modules": " ",
        "npm:frontend:admin-modules:bin": " ",
        "npm:frontend:bin": " ",
        "npm:frontend:check-license": "Check third-party dependency licenses for frontend",
        "phpbench": " ",
        "phpstan": "Launches the PHP static analysis tool",
        "phpunit": "Launches the PHP unit test-suite",
        "post-install-cmd": " ",
        "post-update-cmd": " ",
        "rector": " ",
        "reset": "Resets this Contena instance without reinstalling dependencies",
        "setup": "Resets and re-installs this Contena instance",
        "static-analyze": "Launches the PHP Stan static analysis tool",
        "frontend:lint:snippets": "Checks that no frontend snippet duplicates a global.default translation in every locale.",
