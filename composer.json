        "frontend:storybook": "Runs the Storybook development server for the Frontend component library",
        "stylelint": "Codestyle checks all SCSS files of Administration and Frontend",
        "stylelint:admin": "Code Style checks for all Admin SCSS files",
        "stylelint:admin:fix": "Code Style checks for all Admin SCSS files and fixes them if possible",
